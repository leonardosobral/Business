<cfscript>
// Read-only operational diagnosis: no provider calls, queue claims or mutations.
db={datasource="runner_dba",timeout=15};
function rows(required string sql){var out=[];for(var r in queryExecute(sql,[],db))arrayAppend(out,r);return out;}
report={captured=rows("SELECT to_char(clock_timestamp() AT TIME ZONE 'UTC','YYYY-MM-DD HH24:MI:SS') AS utc_now")};
store=new services.geocoding.LocationStore();
report.overview=store.overview();
report.work=rows("SELECT status,COALESCE(source_snapshot->>'version',source_snapshot->>'VERSION','1') AS version,count(*) AS n,count(DISTINCT id_evento) AS events,count(*) FILTER(WHERE next_retry_at>clock_timestamp()) AS waiting,count(*) FILTER(WHERE attempts>=3) AS exhausted FROM public.tb_evento_geocoding GROUP BY status,COALESCE(source_snapshot->>'version',source_snapshot->>'VERSION','1') ORDER BY n DESC");
report.canonical=rows("SELECT count(*) AS total,count(*) FILTER(WHERE btrim(COALESCE(coordenadas,''))<>'') AS coordinates_present,count(*) FILTER(WHERE localizacoes->'evento'->>'precisao'='local_confirmado') AS confirmed_race,count(*) FILTER(WHERE jsonb_typeof(localizacoes->'kit')='array' AND jsonb_array_length(localizacoes->'kit')>0) AS confirmed_kit,count(*) FILTER(WHERE localizacoes->'enriquecimento'->>'version'='1') AS enrichment_checked FROM public.tb_evento_corridas");
report.applied_churn=rows("WITH latest AS(SELECT DISTINCT ON(id_evento) id_evento,id,status FROM public.tb_evento_geocoding ORDER BY id_evento,id DESC),ever_applied AS(SELECT DISTINCT id_evento FROM public.tb_evento_geocoding WHERE status IN('auto_applied','approved') UNION SELECT DISTINCT id_evento FROM public.tb_evento_geocoding_audit WHERE action IN('auto_applied','approved') AND btrim(COALESCE(coordinates_after,''))<>'') SELECT l.status,count(*) AS events,count(*) FILTER(WHERE btrim(COALESCE(e.coordenadas,''))<>'') AS still_has_coordinates FROM ever_applied a JOIN latest l USING(id_evento) JOIN public.tb_evento_corridas e USING(id_evento) GROUP BY l.status ORDER BY events DESC");
report.city_columns=rows("SELECT column_name,data_type FROM information_schema.columns WHERE table_schema='public' AND table_name='tb_cidades' AND (column_name ILIKE '%lat%' OR column_name ILIKE '%lon%' OR column_name ILIKE '%coord%' OR column_name ILIKE '%geom%') ORDER BY ordinal_position");
report.review_fields=rows("WITH latest AS(SELECT DISTINCT ON(id_evento) decision FROM public.tb_evento_geocoding ORDER BY id_evento,id DESC) SELECT f->>'field' AS field,count(*) AS n FROM latest CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(decision->'enrichment'->'fields')='array' THEN decision->'enrichment'->'fields' ELSE '[]'::jsonb END)f WHERE f->>'status'='needs_review' GROUP BY f->>'field' ORDER BY n DESC");
report.overlap=rows("SELECT count(*) AS work_items,count(DISTINCT id_evento) AS distinct_events,count(*) FILTER(WHERE created_at>=clock_timestamp()-interval '24 hours') AS created_24h,count(*) FILTER(WHERE created_at>=clock_timestamp()-interval '6 hours') AS created_6h FROM public.tb_evento_geocoding");
report.transitions=rows("SELECT action,count(*) AS n,count(DISTINCT id_evento) AS events,count(*) FILTER(WHERE created_at>=clock_timestamp()-interval '6 hours') AS last_6h FROM public.tb_evento_geocoding_audit WHERE created_at>=clock_timestamp()-interval '24 hours' GROUP BY action ORDER BY n DESC");
report.errors=rows("SELECT COALESCE(nullif(error_code,''),'none') AS code,status,count(*) AS n FROM public.tb_evento_geocoding WHERE updated_at>=clock_timestamp()-interval '24 hours' GROUP BY COALESCE(nullif(error_code,''),'none'),status ORDER BY n DESC LIMIT 20");
report.target_states=rows("SELECT t->>'role' AS role,t->>'status' AS status,count(*) AS n FROM public.tb_evento_geocoding g CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(g.decision->'targets')='array' THEN g.decision->'targets' ELSE '[]'::jsonb END)t WHERE g.id=(SELECT max(newer.id) FROM public.tb_evento_geocoding newer WHERE newer.id_evento=g.id_evento) GROUP BY t->>'role',t->>'status' ORDER BY n DESC");
report.diagnostics=rows("SELECT d.code,count(*) AS n FROM public.tb_evento_geocoding g CROSS JOIN LATERAL jsonb_array_elements_text(CASE WHEN jsonb_typeof(g.decision->'diagnostics')='array' THEN g.decision->'diagnostics' ELSE '[]'::jsonb END)d(code) WHERE g.updated_at>=clock_timestamp()-interval '24 hours' GROUP BY d.code ORDER BY n DESC LIMIT 15");
report.usage=rows("SELECT usage_date,provider,calls FROM public.tb_geocoding_usage_daily WHERE usage_date>=CURRENT_DATE-7 ORDER BY usage_date DESC,provider");
report.controls=rows("SELECT cache_key,response->>'enabled' AS enabled,response->>'dailyLimit' AS daily_limit,response->>'blockedReason' AS blocked_reason,response->>'code' AS ai_code,greatest(0,ceil(extract(epoch FROM(cooldown_until-clock_timestamp())))) AS cooldown_seconds,COALESCE(provider_lease_until>clock_timestamp(),false) AS in_flight FROM public.tb_geocoding_cache WHERE cache_key IN('__control__','__ai_control__','__worker__')");
report.cache=rows("SELECT CASE WHEN query_text='public-source-evidence' THEN 'source_or_ai' WHEN cache_key LIKE '__%__' THEN 'control' ELSE 'geocoder' END AS kind,count(*) AS n,count(*) FILTER(WHERE expires_at>clock_timestamp()) AS live,count(*) FILTER(WHERE updated_at>=clock_timestamp()-interval '24 hours') AS updated_24h FROM public.tb_geocoding_cache GROUP BY 1");
report.jobs=rows("SELECT id_cron_job,nome,ativo,interval_minutes,last_run_at,next_run_at,last_status,last_http_status,last_duration_ms FROM public.tb_cron_jobs WHERE endpoint_url='https://business.roadrunners.run/api/eventos/geolocalizar.cfm'");
report.cron_totals=rows("SELECT status,http_status,count(*) AS runs,round(avg(duration_ms)) AS mean_ms,percentile_disc(0.95) WITHIN GROUP(ORDER BY duration_ms) AS p95_ms FROM public.tb_cron_job_runs WHERE id_cron_job IN(SELECT id_cron_job FROM public.tb_cron_jobs WHERE endpoint_url='https://business.roadrunners.run/api/eventos/geolocalizar.cfm') AND started_at>=clock_timestamp()-interval '24 hours' GROUP BY status,http_status ORDER BY runs DESC");
recent=rows("SELECT started_at,status,http_status,duration_ms,response_preview FROM public.tb_cron_job_runs WHERE id_cron_job IN(SELECT id_cron_job FROM public.tb_cron_jobs WHERE endpoint_url='https://business.roadrunners.run/api/eventos/geolocalizar.cfm') ORDER BY id_cron_job_run DESC LIMIT 60");
report.recent=[];report.recent_totals={runs=arrayLen(recent),json_runs=0,processed=0,applied=0,review=0,suggestions=0,errors=0,ai_calls=0,ai_cache_hits=0,calls=0,cache_hits=0,source_documents=0,enriched_fields=0,field_reviews=0,statuses={}};
for(r in recent){
    compact={started_at=r.started_at,http_status=r.http_status,duration_ms=r.duration_ms};
    if(isJSON(r.response_preview & "")){
        parsed=deserializeJSON(r.response_preview & "");report.recent_totals.json_runs++;
        compact.pipeline_status=parsed.status ?: "unknown";
        report.recent_totals.statuses[compact.pipeline_status]=(report.recent_totals.statuses[compact.pipeline_status] ?: 0)+1;
        for(k in listToArray("processed,applied,review,suggestions,errors,ai_calls,ai_cache_hits,calls,cache_hits,source_documents,enriched_fields,field_reviews"))if(structKeyExists(parsed,k) AND isNumeric(parsed[k])){report.recent_totals[k]+=parsed[k];if(listFind("processed,ai_calls,calls,cache_hits",k))compact[k]=parsed[k];}
        if(structKeyExists(parsed,"diagnostic"))compact.diagnostic=parsed.diagnostic;
    }
    if(arrayLen(report.recent) LT 8)arrayAppend(report.recent,compact);
}
started=getTickCount();report.next_ids=store.selectEvents(5);report.selection_ms=getTickCount()-started;
writeOutput(serializeJSON(store.lowerKeys(report)) & chr(10) & "GEO_OPTIMIZATION_DIAGNOSTIC_PASSED");
</cfscript>
