<cfscript>
cfsetting(showdebugoutput=false,requesttimeout=180);
root='/var/tmp/runnerhub-awin-feed-validation/fixture';service=new services.ComparadorAwinFeedService().init(root);reader=new publicservices.AwinFeedReader();checks=[];
function check(required boolean condition,required string label){if(!condition)throw(message=label);arrayAppend(checks,label);}
products=[{id=1,name='Corre',version='4',brand='olympikus',brandName='Olympikus',slug='olympikus-corre-4',type='tenis',label='Olympikus Corre 4'},{id=2,name='Corre',version='5',brand='olympikus',brandName='Olympikus',slug='olympikus-corre-5',type='tenis',label='Olympikus Corre 5'}];index=service.indexProducts(products);
row={product_name='Tênis Olympikus Corre 4 40 Branco',brand_name='Olympikus',merchant_id='17698',data_feed_id='51837',currency='BRL',search_price='599.99',base_price='installament months: R$ 599,99',in_stock='1',stock_status='',is_for_sale='1',pre_order='',condition='new',aw_product_id='123',aw_deep_link='https://www.awin1.com/pclick.php?p=123&a=1455398&m=17698'};
feed={merchantId='17698',feedId='51837',shop='Olympikus BR',checkedMs=createObject('java','java.lang.System').currentTimeMillis()};
check(serializeJSON(service.matchProduct(row,index))=='[1]','Modelo e geração exatos com tamanho e cor');
for(title in ['Tênis Olympikus Corre 40','Tênis Olympikus Corre 4 Pro','Tênis Olympikus Corre 4 GTX','Tênis Olympikus Corre 4 Infantil','Camiseta Olympikus Corre 4','Tênis Olympikus Corre 4 SE','Tênis Olympikus Corre 4 Trail']){bad=duplicate(row);bad.product_name=title;check(!arrayLen(service.matchProduct(bad,index)),'Não vincula: ' & title);}
bad=duplicate(row);bad.brand_name='Nike';check(!arrayLen(service.matchProduct(bad,index)),'Marca divergente');
dupes=duplicate(products);dupe=duplicate(products[1]);dupe.id=3;arrayAppend(dupes,dupe);check(!arrayLen(service.matchProduct(row,service.indexProducts(dupes))),'Identidade ambígua');
check(!len(service.invalidRow(row,feed)),'Preço e link de afiliado válidos');
for(value in ['0','-1','NaN','Infinity','1,99','999999999','4e2']){bad=duplicate(row);bad.search_price=value;check(service.invalidRow(bad,feed)=='preco','Rejeita preço: ' & value);}
for(test in [{key='currency',value='USD',reason='preco'},{key='in_stock',value='0',reason='estoque'},{key='stock_status',value='out_of_stock',reason='estoque'},{key='pre_order',value='1',reason='estoque'},{key='condition',value='used',reason='condicao'},{key='valid_to',value='10',reason='validade'},{key='valid_to',value='2020-01-01T00:00:00Z',reason='validade'},{key='merchant_id',value='999',reason='identidade'},{key='aw_deep_link',value='https://www.awin1.com/pclick.php?p=123&a=999&m=17698',reason='link'}]){bad=duplicate(row);bad[test.key]=test.value;check(service.invalidRow(bad,feed)==test.reason,'Rejeita ' & test.key & ': ' & test.value);}
parser=service.csv('name,description' & chr(10) & '"Modelo, azul","Linha 1' & chr(10) & 'Linha ""2"""');record=parser.iterator().next();check(record.get('name')=='Modelo, azul' AND find('Linha "2"',record.get('description')),'CSV com vírgula, aspas e quebra de linha');parser.close();
for(context in [{actorId=1,isAdmin=false,delegated=false,isPost=true,csrfVerified=true},{actorId=1,isAdmin=true,delegated=true,isPost=true,csrfVerified=true},{actorId=1,isAdmin=true,delegated=false,isPost=false,csrfVerified=true},{actorId=1,isAdmin=true,delegated=false,isPost=true,csrfVerified=false}]){caught=false;try{service.saveBlock(context,'17698:1','bloquear','');}catch(Comparador.Forbidden e){caught=true;}check(caught,'Autorização e CSRF obrigatórios');}
now=createObject('java','java.time.Instant').now();offer={key='17698:1',productId=1,productSlug='olympikus-corre-4',productBrand='olympikus',productName='Corre',productVersion='4',merchantId='17698',awinProductId='123',url=row.aw_deep_link,price=599.99,currency='BRL',shop='Olympikus BR',fetchedAt=now.toString(),expiresAt=now.plusSeconds(3600).toString()};
value={schemaVersion=1,publisherId='1455398',updatedAt=now.toString(),offers=[offer],blocked={},history=[],feeds=[]};path=root & '/cache/feed-publication.json';fileWrite(path,serializeJSON(value));
read=reader.read(path);check(structKeyExists(read,'1'),'Leitor aceita preço válido');check(!structCount(reader.read(path,now.plusSeconds(86401).toEpochMilli())),'Leitor retira preço antigo');
product={id_produto=1,tag_produto='olympikus-corre-4',tag_marca='olympikus',nome_produto='Corre',versao='4',wa_prototipo=false,wa_compra_bloqueada=false};check(arrayLen(reader.forProduct(read,product))==1,'Identidade pública atual');product.wa_prototipo=true;check(!arrayLen(reader.forProduct(read,product)),'Protótipo não recebe preço');product.wa_prototipo=false;product.versao='5';check(!arrayLen(reader.forProduct(read,product)),'Geração alterada não recebe preço antigo');
admin={actorId=99,isAdmin=true,delegated=false,isPost=true,csrfVerified=true};current=service.dashboard(admin);service.saveBlock(admin,'17698:1','bloquear',current.token);check(!structCount(reader.read(path)),'Bloqueio retira oferta pública');
caught=false;try{service.saveBlock(admin,'17698:1','restaurar',current.token);}catch(Comparador.Conflict e){caught=true;}check(caught,'Conflito protege regras de outro administrador');
current=service.dashboard(admin);service.saveBlock(admin,'17698:1','restaurar',current.token);check(structCount(reader.read(path))==1,'Restauração repõe preço válido');fileDelete(path);
cfcontent(type='application/json');writeOutput(serializeJSON({passed=arrayLen(checks),checks=checks}));
</cfscript>
