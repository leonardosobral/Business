<cfscript>
checks=0;function check(required boolean ok,required string label){if(!ok)throw(type='Teams.Test',message=label);checks++;}
svc=new services.teams.Service().init('runner_dba','rr_teams_test');
users=queryExecute("SELECT id,email FROM public.tb_usuarios u WHERE NOT coalesce(is_admin,false) AND email IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.tb_usuarios_gestao g WHERE g.id_usuario=u.id AND (NOT coalesce(g.ativo,true) OR coalesce(g.excluido,false))) ORDER BY id LIMIT 3",{},{datasource='runner_dba'});
staff=queryExecute("SELECT id FROM public.tb_usuarios u WHERE is_admin AND NOT EXISTS(SELECT 1 FROM public.tb_usuarios_gestao g WHERE g.id_usuario=u.id AND (NOT coalesce(g.ativo,true) OR coalesce(g.excluido,false))) ORDER BY id LIMIT 1",{},{datasource='runner_dba'});owner=users.id[1];member=users.id[2];other=users.id[3];globalId=staff.id[1];
data={name='Papéis fixture',type='GRUPO',document='52998224725',ownerName='Titular',technicalName='Técnico',cref='123456-G',crefUf='SC',email='fixture@example.org',phone='48999998888',whatsapp='48999998888',city='Florianópolis',uf='SC',attendance='AMBOS',description='',website=''};
function scenario(required string label,required any body,boolean denied=false){var blocked=false;transaction{try{arguments.body();}catch(Teams.Validation e){if(!denied)rethrow;blocked=true;}catch(Teams.Forbidden e){if(!denied)rethrow;blocked=true;}finally{transaction action='rollback';}}check(!denied||blocked,label);check(queryExecute('SELECT count(*) n FROM rr_teams_test.team',{},{datasource='runner_dba'}).n[1]==0,'Rollback '&label);}
scenario('Altera papel mantendo vínculo',function(){var id=svc.register(owner,data);svc.addExistingAdmin(globalId,id,member,'VIEWER');queryExecute("UPDATE rr_teams_test.admin SET accepted_at='2001-01-01' WHERE team_id=:team AND user_id=:user",{team={value=id,cfsqltype='cf_sql_bigint'},user={value=member,cfsqltype='cf_sql_integer'}},{datasource='runner_dba'});svc.changeAdminRole(globalId,id,member,'ADMIN','VIEWER');check(svc.workspace(member,id).role=='ADMIN','Papel alterado');check(queryExecute('SELECT count(*) n FROM rr_teams_test.admin',{},{datasource='runner_dba'}).n[1]==2,'Mesmos vínculos');check(queryExecute('SELECT extract(year FROM accepted_at) n FROM rr_teams_test.admin WHERE user_id=:id',{id={value=member,cfsqltype='cf_sql_integer'}},{datasource='runner_dba'}).n[1]==2001,'Aceite original preservado');check(svc.state(member).teamId==0,'Não filia atleta');check(queryExecute("SELECT count(*) n FROM rr_teams_test.audit WHERE event='ADMIN_ROLE_CHANGE'",{},{datasource='runner_dba'}).n[1]==1,'Auditoria');});
scenario('Último titular preservado',function(){var id=svc.register(owner,data);svc.changeAdminRole(globalId,id,owner,'ADMIN','OWNER');},true);
scenario('Rebaixar titular com outro titular',function(){var id=svc.register(owner,data);svc.addExistingAdmin(globalId,id,member,'OWNER');svc.changeAdminRole(globalId,id,owner,'VIEWER','OWNER');check(svc.workspace(owner,id).role=='VIEWER'&&svc.workspace(member,id).role=='OWNER','Mantém outro titular');});
scenario('Titular comum não altera papéis globalmente',function(){var id=svc.register(owner,data);svc.changeAdminRole(owner,id,owner,'ADMIN','OWNER');},true);
scenario('Papel obsoleto rejeitado',function(){var id=svc.register(owner,data);svc.addExistingAdmin(globalId,id,member,'VIEWER');svc.changeAdminRole(globalId,id,member,'OWNER','ADMIN');},true);
scenario('Membro externo rejeitado',function(){var id=svc.register(owner,data);svc.changeAdminRole(globalId,id,other,'ADMIN','VIEWER');},true);
scenario('Papel inválido rejeitado',function(){var id=svc.register(owner,data);svc.changeAdminRole(globalId,id,owner,'GLOBAL','OWNER');},true);
scenario('Convite pendente revogado na mudança',function(){var id=svc.register(owner,data);svc.addExistingAdmin(globalId,id,member,'VIEWER');queryExecute("INSERT INTO rr_teams_test.admin_invite(team_id,email,role,token_hash,created_by) VALUES(:team,:email,'VIEWER',:hash,:user)",{team={value=id,cfsqltype='cf_sql_bigint'},email=users.email[2],hash=repeatString('a',64),user={value=owner,cfsqltype='cf_sql_integer'}},{datasource='runner_dba'});svc.changeAdminRole(globalId,id,member,'ADMIN','VIEWER');check(queryExecute('SELECT count(*) n FROM rr_teams_test.admin_invite WHERE revoked_at IS NOT NULL',{},{datasource='runner_dba'}).n[1]==1,'Revogou convite antigo');});
scenario('Papel igual não gera alteração',function(){var id=svc.register(owner,data);svc.changeAdminRole(globalId,id,owner,'OWNER','OWNER');check(queryExecute("SELECT count(*) n FROM rr_teams_test.audit WHERE event='ADMIN_ROLE_CHANGE'",{},{datasource='runner_dba'}).n[1]==0,'Sem auditoria falsa');});
check(queryExecute('SELECT count(*) n FROM rr_teams_test.mail_outbox',{},{datasource='runner_dba'}).n[1]==0,'Sem email de teste');
writeOutput('TEAMS_ROLES_PASSED '&checks&'; rollback; no real roles changed');
</cfscript>
