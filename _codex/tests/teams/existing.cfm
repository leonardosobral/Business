<cfscript>
checks=0;function check(required boolean ok,required string label){if(!ok)throw(type='Teams.Test',message=label);checks++;}
svc=new services.teams.Service().init('runner_dba','rr_teams_test');
users=queryExecute("SELECT id,name,email FROM public.tb_usuarios u WHERE NOT coalesce(is_admin,false) AND email IS NOT NULL AND NOT EXISTS(SELECT 1 FROM public.tb_usuarios_gestao g WHERE g.id_usuario=u.id AND (NOT coalesce(g.ativo,true) OR coalesce(g.excluido,false))) ORDER BY id LIMIT 3",{},{datasource='runner_dba'});
staff=queryExecute("SELECT id FROM public.tb_usuarios u WHERE is_admin AND NOT EXISTS(SELECT 1 FROM public.tb_usuarios_gestao g WHERE g.id_usuario=u.id AND (NOT coalesce(g.ativo,true) OR coalesce(g.excluido,false))) ORDER BY id LIMIT 1",{},{datasource='runner_dba'});owner=users.id[1];member=users.id[2];other=users.id[3];globalId=staff.id[1];
data={name='Gestão existente fixture',type='GRUPO',document='52998224725',ownerName='Titular',technicalName='Técnico',cref='123456-G',crefUf='SC',email='fixture@example.org',phone='48999998888',whatsapp='48999998888',city='Florianópolis',uf='SC',attendance='AMBOS',description='',website=''};
function scenario(required string label,required any body,boolean denied=false){var blocked=false;transaction{try{arguments.body();}catch(Teams.Validation e){if(!denied)rethrow;blocked=true;}catch(Teams.Forbidden e){if(!denied)rethrow;blocked=true;}finally{transaction action='rollback';}}check(!denied||blocked,label);check(queryExecute('SELECT count(*) n FROM rr_teams_test.team',{},{datasource='runner_dba'}).n[1]==0,'Rollback '&label);}
check(queryExecute('SELECT count(*) n FROM rr_teams_test.team',{},{datasource='runner_dba'}).n[1]==0,'Fixture vazia');
scenario('Busca global',function(){var id=svc.register(owner,data);var found=svc.adminCandidates(globalId,id,member&'');check(found.recordCount>0&&listFind(valueList(found.id),member),'Busca por ID');found=svc.adminCandidates(globalId,id,users.email[2]);check(found.recordCount>0&&listFind(valueList(found.id),member),'Busca por email');found=svc.adminCandidates(globalId,id,left(users.name[2],30));check(found.recordCount>0&&listFind(valueList(found.id),member),'Busca por nome');check(svc.adminCandidates(globalId,id,owner&'').recordCount<=25,'Busca limitada');found=svc.adminCandidates(globalId,id,users.email[1]);check(!listFind(valueList(found.id),owner),'Já vinculado excluído');check(svc.adminCandidates(globalId,id,'').recordCount==0&&svc.adminCandidates(globalId,id,'x').recordCount==0,'Busca vazia/curta');check(svc.adminCandidates(globalId,id,"' OR 1=1 --").recordCount==0,'SQL parametrizado');});
scenario('Consulta não busca usuários',function(){var id=svc.register(owner,data);svc.addExistingAdmin(globalId,id,member,'VIEWER');svc.adminCandidates(member,id,other&'');},true);
scenario('Titular não atribui titularidade',function(){var id=svc.register(owner,data);svc.addExistingAdmin(owner,id,member,'OWNER');},true);
for(testRole in ['OWNER','ADMIN','VIEWER'])scenario('Inclusão '&testRole,function(){var id=svc.register(owner,data);svc.addExistingAdmin(globalId,id,member,testRole);check(svc.workspace(member,id).role==testRole,'Papel exato');check(svc.state(member).teamId==0,'Não filia atleta');check(queryExecute('SELECT count(*) n FROM rr_teams_test.mail_outbox',{},{datasource='runner_dba'}).n[1]==0,'Sem email automático');check(queryExecute("SELECT count(*) n FROM rr_teams_test.audit WHERE event='ADMIN_ADD'",{},{datasource='runner_dba'}).n[1]==1,'Auditoria');});
scenario('Duplicidade não altera papel',function(){var id=svc.register(owner,data);svc.addExistingAdmin(globalId,id,owner,'VIEWER');},true);
scenario('Papel inválido',function(){var id=svc.register(owner,data);svc.addExistingAdmin(globalId,id,member,'GLOBAL');},true);
scenario('Usuário inexistente',function(){var id=svc.register(owner,data);svc.addExistingAdmin(globalId,id,999999999999999,'ADMIN');},true);
scenario('Convite anterior revogado',function(){var id=svc.register(owner,data);var invite=svc.inviteAdmin(owner,id,users.email[2],'VIEWER');svc.addExistingAdmin(globalId,id,member,'ADMIN');check(queryExecute('SELECT count(*) n FROM rr_teams_test.admin_invite WHERE revoked_at IS NOT NULL',{},{datasource='runner_dba'}).n[1]==1,'Convite pendente revogado');check(svc.workspace(member,id).role=='ADMIN','Papel direto mantido');});
scenario('Convite comum mantém aceite',function(){var id=svc.register(owner,data);var invite=svc.inviteAdmin(owner,id,users.email[2],'VIEWER');svc.acceptAdmin(member,invite.token);check(svc.workspace(member,id).role=='VIEWER','Aceite normal preservado');});
scenario('Convite revogado não substitui papel',function(){var id=svc.register(owner,data);var invite=svc.inviteAdmin(owner,id,users.email[2],'VIEWER');svc.addExistingAdmin(globalId,id,member,'ADMIN');svc.acceptAdmin(member,invite.token);},true);
inactive=queryExecute("SELECT id FROM public.tb_usuarios u WHERE EXISTS(SELECT 1 FROM public.tb_usuarios_gestao g WHERE g.id_usuario=u.id AND (NOT coalesce(g.ativo,true) OR coalesce(g.excluido,false))) ORDER BY id LIMIT 1",{},{datasource='runner_dba'});
if(inactive.recordCount)scenario('Conta inativa não recebe acesso',function(){var id=svc.register(owner,data);var found=svc.adminCandidates(globalId,id,inactive.id[1]&'');check(!listFind(valueList(found.id),inactive.id[1]),'Inativo fora da busca');svc.addExistingAdmin(globalId,id,inactive.id[1],'ADMIN');},true);
check(queryExecute('SELECT count(*) n FROM rr_teams_test.mail_outbox',{},{datasource='runner_dba'}).n[1]==0,'Fixture limpa, nenhum envio');
writeOutput('TEAMS_EXISTING_PASSED '&checks&'; rollback; no real access granted');
</cfscript>
