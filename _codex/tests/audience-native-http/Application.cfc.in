<cfcomponent output="false">
    <!--- Test-only subapplication. The runner renders placeholders into an isolated directory. --->
    <cfset VARIABLES.fixtureDisabledApplication = structKeyExists(URL, "disabled")
        AND isSimpleValue(URL.disabled)
        AND trim(URL.disabled & "") EQ "1"/>
    <cfset VARIABLES.fixtureApplicationStatus = VARIABLES.fixtureDisabledApplication ? "Disabled" : "Enabled"/>
    <cfset VARIABLES.fixtureLimitedApplication = structKeyExists(URL,"limited") AND isSimpleValue(URL.limited) AND URL.limited EQ "1"/>
    <cfif VARIABLES.fixtureLimitedApplication><cfset VARIABLES.fixtureApplicationStatus &= "Limited"/></cfif>
    <cfset THIS.Name = "RRAudHttpRR__RUN_ID__#VARIABLES.fixtureApplicationStatus#"/>
    <cfset THIS.ApplicationTimeout = createTimeSpan(0, 1, 0, 0)/>
    <cfset THIS.SessionManagement = false/>
    <cfset THIS.SetClientCookies = false/>
    <cfset THIS.datasource = "__DATASOURCE_RR__"/>
    <cfset THIS.datasources = {
        "__DATASOURCE_RR__" = {
            "driver" = "other",
            "url" = "jdbc:postgresql://127.0.0.1:__PG_PORT__/rr_audience_http",
            "class" = "org.postgresql.Driver",
            "username" = "runner",
            "password" = "__PG_PASSWORD__"
        }
    }/>
    <cfset THIS.mappings = {
        "/services" = getDirectoryFromPath(getCurrentTemplatePath()) & "services"
    }/>

    <cffunction name="onApplicationStart" access="public" returntype="boolean" output="false">
        <cfset APPLICATION.audienceMeasurement = {"hosts"={"dev.roadrunners.run"={
            "environment"="dev","enabled"=NOT VARIABLES.fixtureDisabledApplication,"secret"="__TEST_TOKEN__",
            "rateLimitRequests"=VARIABLES.fixtureLimitedApplication ? 1 : 60,
            "rateLimitWindowSeconds"=60,"rateLimitMaxKeys"=100
        }}}/>
        <cfset APPLICATION.audienceMeasurementRateLimits = {}/>
        <cfset APPLICATION.audienceNativeHttpRunId = "__RUN_ID__"/>
        <cfreturn true/>
    </cffunction>

    <cffunction name="onRequestStart" access="public" returntype="boolean" output="false">
        <cfargument name="targetPage" type="string" required="true"/>
        <cfset var requestHeaders = getHTTPRequestData(false).headers/>
        <cfset var remoteAddress = structKeyExists(CGI, "REMOTE_ADDR") ? trim(CGI.REMOTE_ADDR & "") : ""/>
        <cfset var suppliedToken = structKeyExists(requestHeaders, "X-RR-Audience-Test")
            ? trim(requestHeaders["X-RR-Audience-Test"] & "") : ""/>
        <cfset var datasourceConfig = {}/>
        <cfset var effectiveSettings = {}/>
        <cfset var effectiveDatasourceConfig = {}/>
        <cfset var expectedUrl = "jdbc:postgresql://127.0.0.1:__PG_PORT__/rr_audience_http"/>
        <cfset var probe = queryNew("")/>

        <cfif NOT listFind("127.0.0.1,::1", remoteAddress)
            OR NOT fixtureTokensMatch(suppliedToken, "__TEST_TOKEN__")>
            <cfset stopFixtureRequest(403, "fixture_guard")/>
        </cfif>

        <cfif THIS.datasource NEQ "__DATASOURCE_RR__"
            OR NOT structKeyExists(THIS.datasources, "__DATASOURCE_RR__")
            OR NOT isStruct(THIS.datasources["__DATASOURCE_RR__"])>
            <cfset stopFixtureRequest(503, "fixture_datasource")/>
        </cfif>

        <cfset datasourceConfig = THIS.datasources["__DATASOURCE_RR__"]/>
        <cfif NOT structKeyExists(datasourceConfig, "driver")
            OR datasourceConfig.driver NEQ "other"
            OR NOT structKeyExists(datasourceConfig, "url")
            OR datasourceConfig.url NEQ expectedUrl
            OR NOT structKeyExists(datasourceConfig, "class")
            OR datasourceConfig.class NEQ "org.postgresql.Driver"
            OR NOT structKeyExists(datasourceConfig, "username")
            OR datasourceConfig.username NEQ "runner">
            <cfset stopFixtureRequest(503, "fixture_datasource")/>
        </cfif>

        <cftry>
            <cfset effectiveSettings = getApplicationMetadata()/>
            <cfif NOT structKeyExists(effectiveSettings, "datasource")
                OR effectiveSettings.datasource NEQ "__DATASOURCE_RR__"
                OR NOT structKeyExists(effectiveSettings, "datasources")
                OR NOT isStruct(effectiveSettings.datasources)
                OR NOT structKeyExists(effectiveSettings.datasources, "__DATASOURCE_RR__")>
                <cfset stopFixtureRequest(503, "fixture_datasource")/>
            </cfif>
            <cfset effectiveDatasourceConfig = effectiveSettings.datasources["__DATASOURCE_RR__"]/>
            <cfcatch type="any">
                <cfset stopFixtureRequest(503, "fixture_datasource")/>
            </cfcatch>
        </cftry>
        <cfif NOT isStruct(effectiveDatasourceConfig)
            OR NOT structKeyExists(effectiveDatasourceConfig, "driver")
            OR effectiveDatasourceConfig.driver NEQ "other"
            OR NOT structKeyExists(effectiveDatasourceConfig, "url")
            OR effectiveDatasourceConfig.url NEQ expectedUrl
            OR NOT structKeyExists(effectiveDatasourceConfig, "class")
            OR effectiveDatasourceConfig.class NEQ "org.postgresql.Driver"
            OR NOT structKeyExists(effectiveDatasourceConfig, "username")
            OR effectiveDatasourceConfig.username NEQ "runner">
            <cfset stopFixtureRequest(503, "fixture_datasource")/>
        </cfif>

        <cftry>
            <cfset probe = queryExecute(
                "SELECT current_database() AS database_name,
                        current_user AS database_user,
                        EXISTS (
                            SELECT 1
                              FROM public.rr_audience_test_marker
                             WHERE run_id = :run_id
                        ) AS marker_matches",
                {
                    "run_id" = {
                        "value" = "__RUN_ID__",
                        "cfsqltype" = "cf_sql_varchar"
                    }
                },
                {
                    "datasource" = "__DATASOURCE_RR__",
                    "timeout" = 3
                }
            )/>
            <cfcatch type="any">
                <cfset stopFixtureRequest(503, "fixture_database")/>
            </cfcatch>
        </cftry>

        <cfif probe.recordCount NEQ 1
            OR probe.database_name[1] NEQ "rr_audience_http"
            OR probe.database_user[1] NEQ "runner"
            OR NOT fixtureTruthy(probe.marker_matches[1])>
            <cfset stopFixtureRequest(503, "fixture_database")/>
        </cfif>

        <cfset REQUEST.audienceNativeHttpFixtureAuthorized = true/>
        <cfset REQUEST.audienceNativeHttpRunId = "__RUN_ID__"/>
        <cfreturn true/>
    </cffunction>

    <cffunction name="fixtureTokensMatch" access="private" returntype="boolean" output="false">
        <cfargument name="leftValue" type="string" required="true"/>
        <cfargument name="rightValue" type="string" required="true"/>
        <cfif len(arguments.leftValue) NEQ len(arguments.rightValue)>
            <cfreturn false/>
        </cfif>
        <cfreturn createObject("java", "java.security.MessageDigest").isEqual(
            charsetDecode(arguments.leftValue, "UTF-8"),
            charsetDecode(arguments.rightValue, "UTF-8")
        )/>
    </cffunction>

    <cffunction name="fixtureTruthy" access="private" returntype="boolean" output="false">
        <cfargument name="value" required="true"/>
        <cfreturn isBoolean(arguments.value)
            ? arguments.value
            : listFindNoCase("true,1,yes", trim(arguments.value & "")) GT 0/>
    </cffunction>

    <cffunction name="stopFixtureRequest" access="private" returntype="void" output="false">
        <cfargument name="statusCode" type="numeric" required="true"/>
        <cfargument name="errorCode" type="string" required="true"/>
        <cfcontent type="application/json; charset=utf-8" reset="true"/>
        <cfheader statuscode="#arguments.statusCode#"/>
        <cfoutput>{"error":"#encodeForJavaScript(arguments.errorCode)#"}</cfoutput>
        <cfabort/>
    </cffunction>
</cfcomponent>
