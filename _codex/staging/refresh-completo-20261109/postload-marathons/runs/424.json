    "truncated": 0,
    "row_count": 76,
    "sql_text": "-- Vertical maratonas: totais autorais; participações, não pessoas únicas.\nWITH base AS MATERIALIZED (\n SELECT e.id_evento,e.tipo_corrida,extract(month FROM e.data_final)::int AS mes,r.percurso,r.sexo\n FROM estudo.vw_resultados_2026 r JOIN public.tb_evento_corridas e USING(id_evento)\n WHERE e.pais='BR' AND e.data_final>=DATE '2026-01-01' AND e.data_final<DATE '2026-10-01'\n AND r.status_final=0 AND r.homologado IS TRUE AND r.concluinte IS TRUE\n), grupos AS (\n SELECT *,CASE WHEN percurso IS NULL OR percurso<=0 THEN 'Sem distância válida'\n WHEN percurso=5 THEN '5 km' WHEN percurso=10 THEN '10 km'\n WHEN percurso BETWEEN 21 AND 21.2 THEN '21–21,2 km'\n WHEN percurso BETWEEN 42 AND 42.2 THEN '42–42,2 km'\n ELSE 'Outras distâncias' END AS faixa FROM base\n)\nSELECT 2026 AS ano,current_timestamp AS coletado_em,mes,tipo_corrida,faixa,count(*) AS participacoes,\n count(DISTINCT id_evento) AS eventos,count(*) FILTER(WHERE sexo='F') AS feminino\nFROM grupos GROUP BY mes,tipo_corrida,faixa ORDER BY mes,tipo_corrida,faixa",
    "status": "ok",
    "note": "Mesma amostra/critério da revisão vigente. Nova fonte BI versionada após carga DataGrip; ainda candidato sem publicação. Floripa oficial210 permanece independente dos perfis BI.",
    "finished_at": "2026-11-09 18:19:50.452672-03",
