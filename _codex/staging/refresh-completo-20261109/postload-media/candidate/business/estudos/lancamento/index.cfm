<p class="step-history" data-step-history><cfif len(launchStep.author)><cfif launchStep.completed>Validado<cfelse>Reaberto</cfif> por #encodeForHTML(launchStep.author)# · #encodeForHTML(launchStep.changed_at)#<cfelse>Aguardando validação.</cfif></p></div><button class="step-toggle" type="button" data-toggle-step aria-expanded="false" aria-controls="painel-#encodeForHTMLAttribute(launchStep.key)#" aria-label="Expandir etapa: #encodeForHTMLAttribute(launchStep.title)#" disabled><span data-toggle-label>Expandir</span><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div>
