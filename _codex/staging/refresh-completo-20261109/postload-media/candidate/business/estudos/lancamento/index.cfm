<div class="launch-checklist launch-list launch-compact"><cfoutput><cfloop array="#launchChecklist.steps#" index="launchStep">
<cfset launchPreview=listFirst(replace(launchStep.notes,chr(13),'','all'),chr(10))/>
<cfif len(launchPreview) GT 260><cfset launchPreview=left(launchPreview,257) & '…'/></cfif>
<cfset launchDateText=trim(launchStep.date)/><cfset launchDatePrefix=''/>
