# Native response: denied requests must not enter a dynamic error handler.
ErrorDocument 403 "Access denied"
ErrorDocument 404 /404/
ErrorDocument 500 /errors/500.html
ErrorDocument 503 /errors/500.html
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
    <Files "manifest.webmanifest">
        Header set Content-Type "application/manifest+json; charset=utf-8"
        Header set Cache-Control "no-cache, must-revalidate"
    </Files>
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine on
    # Reject environment files and common backups, including nested paths, before routing.
    RewriteRule (^|/)\.env([./_~-]|$) - [F,L,NC]
    # Private metadata and known configuration probes; keep public discovery files available.
    RewriteRule (^|/)\.(git|aws|github)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.netrc([./_~-]|$) - [F,L,NC]
    RewriteRule (^|/)(phpinfo\.php|aws-exports\.js|docker-compose\.yml|key\.json|local_settings\.py)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(npmrc|gitlab-ci\.yml)(/|$) - [F,L,NC]
    RewriteRule (^|/)(secrets|credentials|token|keys|serviceAccountKey|service[-_]account|firebase-adminsdk)\.json(/|$) - [F,L,NC]
    # Exact configuration paths observed in scans; do not blanket-block JSON or public API schemas.
    RewriteRule ^(config\.json|env\.(js|json)|vercel\.json|appsettings\.json|firebase\.json|application\.(yml|properties)|web\.config|serverless\.yml|amplifyconfiguration\.json|awsconfiguration\.json|terraform\.(tfvars|tfstate)|ai/config\.json|assets/env\.js|instance/config\.py)(/|$) - [F,L,NC]
    RewriteRule ^(api/(config|env)|debug/vars)(/|$) - [F,L,NC]
    # These endpoints are not used by this ColdFusion portal.
    RewriteRule ^(graphql|actuator)(/|$) - [F,L,NC]
    RewriteRule ^oauth/_helpers\.cfm$ - [F,L,NC]
    RewriteRule ^oauth/authorize/?$ /oauth/authorize/index.cfm [END,NC]
    RewriteRule ^oauth/token/?$ /oauth/token/index.cfm [END,NC]
    RewriteRule ^oauth/revoke/?$ /oauth/revoke/index.cfm [END,NC]
    RewriteRule ^oauth/mobile/callback/?$ /oauth/mobile/callback/index.cfm [END,NC]
    # Dynamic SEO discovery endpoints. Keep these before localized content routes.
    RewriteRule ^sitemap\.xml$ /sitemaps/index.cfm?section=index [END,NC,QSA]
    RewriteRule ^sitemaps/(static|news-recent|videos)\.xml$ /sitemaps/index.cfm?section=$1 [END,NC,QSA]
    RewriteRule ^sitemaps/events-(upcoming|history)-([0-9]+)\.xml$ /sitemaps/index.cfm?section=events-$1&page=$2 [END,NC,QSA]
    # MCP source is deployed to /opt and must never be served by the portal.
    RewriteRule ^mcp(?:/|$) - [F,L,NC]
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
    RewriteRule ^en/?$ /index.cfm?i18n_lang=en&i18n_route=home [NC,L,QSA]
    RewriteRule ^es/?$ /index.cfm?i18n_lang=es&i18n_route=home [NC,L,QSA]
    RewriteRule ^en/activities/?$ /atividades/index.cfm?i18n_lang=en&i18n_route=feed [NC,L,QSA]
    RewriteRule ^es/actividades/?$ /atividades/index.cfm?i18n_lang=es&i18n_route=feed [NC,L,QSA]
    RewriteRule ^vicky/?$ /mensagens/vicky/ [R=302,NC,L]
    RewriteRule ^mensagens/vicky/?$ /mensagens/index.cfm?i18n_route=messages&vicky=1 [NC,L,QSA]
    RewriteRule ^en/messages/with/([^/]+)/?$ /mensagens/index.cfm?i18n_lang=en&i18n_route=messages&chat_slug=$1 [NC,L,QSA]
    RewriteRule ^en/messages/requests/([^/]+)/?$ /mensagens/index.cfm?i18n_lang=en&i18n_route=messages&chat_slug=$1&caixa=requests [NC,L,QSA]
    RewriteRule ^en/messages/requests/?$ /en/messages/ [R=302,NC,L]
    RewriteRule ^en/messages/group/([^/]+)/?$ /mensagens/index.cfm?i18n_lang=en&i18n_route=messages&group_slug=$1&caixa=groups [NC,L,QSA]
    RewriteRule ^en/messages/groups/?$ /mensagens/index.cfm?i18n_lang=en&i18n_route=messages&caixa=groups [NC,L,QSA]
    RewriteRule ^en/messages/channels/?$ /mensagens/index.cfm?i18n_lang=en&i18n_route=messages&caixa=channels [NC,L,QSA]
    RewriteRule ^en/messages/?$ /mensagens/index.cfm?i18n_lang=en&i18n_route=messages [NC,L,QSA]
    RewriteRule ^es/mensajes/con/([^/]+)/?$ /mensagens/index.cfm?i18n_lang=es&i18n_route=messages&chat_slug=$1 [NC,L,QSA]
    RewriteRule ^es/mensajes/solicitudes/([^/]+)/?$ /mensagens/index.cfm?i18n_lang=es&i18n_route=messages&chat_slug=$1&caixa=requests [NC,L,QSA]
    RewriteRule ^es/mensajes/solicitudes/?$ /es/mensajes/ [R=302,NC,L]
    RewriteRule ^es/mensajes/grupo/([^/]+)/?$ /mensagens/index.cfm?i18n_lang=es&i18n_route=messages&group_slug=$1&caixa=groups [NC,L,QSA]
    RewriteRule ^es/mensajes/grupos/?$ /mensagens/index.cfm?i18n_lang=es&i18n_route=messages&caixa=groups [NC,L,QSA]
    RewriteRule ^es/mensajes/canales/?$ /mensagens/index.cfm?i18n_lang=es&i18n_route=messages&caixa=channels [NC,L,QSA]
    RewriteRule ^es/mensajes/?$ /mensagens/index.cfm?i18n_lang=es&i18n_route=messages [NC,L,QSA]
    RewriteRule ^mensagens/com/([^/]+)/?$ /mensagens/conversa/$1/ [R=302,NC,L,NE]
    RewriteRule ^mensagens/conversa/([^/]+)/?$ /mensagens/index.cfm?i18n_route=messages&chat_slug=$1 [NC,L,QSA]
    RewriteRule ^mensagens/pedidos/([^/]+)/?$ /mensagens/index.cfm?i18n_route=messages&chat_slug=$1&caixa=requests [NC,L,QSA]
    RewriteRule ^mensagens/pedidos/?$ /mensagens/ [R=302,NC,L]
    RewriteRule ^mensagens/grupo/([^/]+)/?$ /mensagens/index.cfm?i18n_route=messages&group_slug=$1&caixa=groups [NC,L,QSA]
    RewriteRule ^mensagens/grupos/?$ /mensagens/index.cfm?i18n_route=messages&caixa=groups [NC,L,QSA]
    RewriteRule ^mensagens/canais/?$ /mensagens/index.cfm?i18n_route=messages&caixa=channels [NC,L,QSA]
    RewriteRule ^mensagens/?$ /mensagens/index.cfm?i18n_route=messages [NC,L,QSA]
    RewriteRule ^en/404/?$ /404/index.cfm?i18n_lang=en&i18n_route=notFound [NC,L,QSA]
    RewriteRule ^es/404/?$ /404/index.cfm?i18n_lang=es&i18n_route=notFound [NC,L,QSA]
    RewriteRule ^en/search/?$ /busca/index.cfm?i18n_lang=en&i18n_route=search [NC,L,QSA]
    RewriteRule ^es/busqueda/?$ /busca/index.cfm?i18n_lang=es&i18n_route=search [NC,L,QSA]
    RewriteRule ^en/news/?$ /noticias/index.cfm?i18n_lang=en&i18n_route=news [NC,L,QSA]
    RewriteRule ^en/news/channel/?$ /en/news/ [R=302,L]
    RewriteRule ^en/news/channel/([^/]+)/?$ /noticias/index.cfm?i18n_lang=en&i18n_route=newsChannel&canal=$1 [NC,L,QSA]
    RewriteRule ^en/news/([^/]+)/?$ /noticias/index.cfm?i18n_lang=en&i18n_route=newsDetail&tag=$1 [NC,L,QSA]
    RewriteRule ^en/videos/?$ /videos/index.cfm?i18n_lang=en&i18n_route=videos [NC,L,QSA]
    RewriteRule ^en/videos/channel/?$ /en/videos/ [R=302,L]
    RewriteRule ^en/videos/channel/([^/]+)/?$ /videos/index.cfm?i18n_lang=en&i18n_route=videosChannel&canal=$1 [NC,L,QSA]
    RewriteRule ^en/event/([^/]+)/?$ /evento/index.cfm?i18n_lang=en&i18n_route=event&tag=$1 [NC,L,QSA]
    RewriteRule ^en/calendar/?$ /agenda/index.cfm?i18n_lang=en&i18n_route=agenda [NC,L,QSA]
    RewriteRule ^en/calendar/([^/]+)/?$ /agenda/index.cfm?i18n_lang=en&i18n_route=agenda&tag=$1 [NC,L,QSA]
    RewriteRule ^en/challenges/?$ /desafios/index.cfm?i18n_lang=en&i18n_route=challenges [NC,L,QSA]
    RewriteRule ^en/challenges/([^/]+)/?$ /desafios/index.cfm?i18n_lang=en&i18n_route=challenges&tag=$1 [NC,L,QSA]
    RewriteRule ^en/results/?$ /resultados/index.cfm?i18n_lang=en&i18n_route=results [NC,L,QSA]
    RewriteRule ^en/results/([^/]+)/?$ /resultados/index.cfm?i18n_lang=en&i18n_route=results&tag=$1 [NC,L,QSA]
    RewriteRule ^en/athlete/([^/]+)/health/?$ /atleta/saude/index.cfm?i18n_lang=en&i18n_route=athleteHealth&tag=$1 [NC,L,QSA]
    RewriteRule ^en/athlete/([^/]+)/retrospective/?$ /atleta/retrospectiva/index.cfm?i18n_lang=en&i18n_route=athleteRetrospective&tag=$1 [NC,L,QSA]
    RewriteRule ^en/athlete/([^/]+)/?$ /atleta/index.cfm?i18n_lang=en&i18n_route=athlete&tag=$1 [NC,L,QSA]
    RewriteRule ^en/settings/profile/?$ /configuracoes/perfil/index.cfm?i18n_lang=en&i18n_route=profileSettings [NC,L,QSA]
    RewriteRule ^en/settings/integrations/?$ /configuracoes/perfil/index.cfm?i18n_lang=en&i18n_route=profileSettingsIntegrations&settings_section=integracoes [NC,L,QSA]
    RewriteRule ^en/settings/links/?$ /configuracoes/perfil/index.cfm?i18n_lang=en&i18n_route=profileSettingsLinks&settings_section=links [NC,L,QSA]
    RewriteRule ^en/settings/privacy/?$ /configuracoes/perfil/index.cfm?i18n_lang=en&i18n_route=profileSettingsPrivacy&settings_section=privacidade [NC,L,QSA]
    RewriteRule ^en/settings/perfilrun/?$ /configuracoes/perfil/index.cfm?i18n_lang=en&i18n_route=profileSettingsPerfilRun&settings_section=perfilrun [NC,L,QSA]
    RewriteRule ^en/settings/account-removal/?$ /en/settings/privacy/ [R=302,L]
    RewriteRule ^en/support/?$ /atendimento/index.cfm?i18n_lang=en&i18n_route=support [NC,L,QSA]
    RewriteRule ^es/noticias/?$ /noticias/index.cfm?i18n_lang=es&i18n_route=news [NC,L,QSA]
    RewriteRule ^es/noticias/canal/?$ /es/noticias/ [R=302,L]
    RewriteRule ^es/noticias/canal/([^/]+)/?$ /noticias/index.cfm?i18n_lang=es&i18n_route=newsChannel&canal=$1 [NC,L,QSA]
    RewriteRule ^es/noticias/([^/]+)/?$ /noticias/index.cfm?i18n_lang=es&i18n_route=newsDetail&tag=$1 [NC,L,QSA]
    RewriteRule ^es/videos/?$ /videos/index.cfm?i18n_lang=es&i18n_route=videos [NC,L,QSA]
    RewriteRule ^es/videos/canal/?$ /es/videos/ [R=302,L]
    RewriteRule ^es/videos/canal/([^/]+)/?$ /videos/index.cfm?i18n_lang=es&i18n_route=videosChannel&canal=$1 [NC,L,QSA]
    RewriteRule ^es/evento/([^/]+)/?$ /evento/index.cfm?i18n_lang=es&i18n_route=event&tag=$1 [NC,L,QSA]
    RewriteRule ^es/agenda/?$ /agenda/index.cfm?i18n_lang=es&i18n_route=agenda [NC,L,QSA]
    RewriteRule ^es/agenda/([^/]+)/?$ /agenda/index.cfm?i18n_lang=es&i18n_route=agenda&tag=$1 [NC,L,QSA]
    RewriteRule ^es/desafios/?$ /desafios/index.cfm?i18n_lang=es&i18n_route=challenges [NC,L,QSA]
    RewriteRule ^es/desafios/([^/]+)/?$ /desafios/index.cfm?i18n_lang=es&i18n_route=challenges&tag=$1 [NC,L,QSA]
    RewriteRule ^es/resultados/?$ /resultados/index.cfm?i18n_lang=es&i18n_route=results [NC,L,QSA]
    RewriteRule ^es/resultados/([^/]+)/?$ /resultados/index.cfm?i18n_lang=es&i18n_route=results&tag=$1 [NC,L,QSA]
    RewriteRule ^es/atleta/([^/]+)/salud/?$ /atleta/saude/index.cfm?i18n_lang=es&i18n_route=athleteHealth&tag=$1 [NC,L,QSA]
    RewriteRule ^es/atleta/([^/]+)/retrospectiva/?$ /atleta/retrospectiva/index.cfm?i18n_lang=es&i18n_route=athleteRetrospective&tag=$1 [NC,L,QSA]
    RewriteRule ^es/atleta/([^/]+)/?$ /atleta/index.cfm?i18n_lang=es&i18n_route=athlete&tag=$1 [NC,L,QSA]
    RewriteRule ^es/configuracion/perfil/?$ /configuracoes/perfil/index.cfm?i18n_lang=es&i18n_route=profileSettings [NC,L,QSA]
    RewriteRule ^es/configuracion/integraciones/?$ /configuracoes/perfil/index.cfm?i18n_lang=es&i18n_route=profileSettingsIntegrations&settings_section=integracoes [NC,L,QSA]
    RewriteRule ^es/configuracion/enlaces/?$ /configuracoes/perfil/index.cfm?i18n_lang=es&i18n_route=profileSettingsLinks&settings_section=links [NC,L,QSA]
    RewriteRule ^es/configuracion/privacidad/?$ /configuracoes/perfil/index.cfm?i18n_lang=es&i18n_route=profileSettingsPrivacy&settings_section=privacidade [NC,L,QSA]
    RewriteRule ^es/configuracion/perfilrun/?$ /configuracoes/perfil/index.cfm?i18n_lang=es&i18n_route=profileSettingsPerfilRun&settings_section=perfilrun [NC,L,QSA]
    RewriteRule ^es/configuracion/eliminacion-cuenta/?$ /es/configuracion/privacidad/ [R=302,L]
    RewriteRule ^es/soporte/?$ /atendimento/index.cfm?i18n_lang=es&i18n_route=support [NC,L,QSA]
    RewriteRule ^configuracoes/?$ /configuracoes/perfil/ [R=302,L]
    RewriteRule ^configuracoes/perfil/?$ /configuracoes/perfil/index.cfm?i18n_route=profileSettings [NC,L,QSA]
    RewriteRule ^configuracoes/integracoes/?$ /configuracoes/perfil/index.cfm?i18n_route=profileSettingsIntegrations&settings_section=integracoes [NC,L,QSA]
    RewriteRule ^configuracoes/links/?$ /configuracoes/perfil/index.cfm?i18n_route=profileSettingsLinks&settings_section=links [NC,L,QSA]
    RewriteRule ^configuracoes/privacidade/?$ /configuracoes/perfil/index.cfm?i18n_route=profileSettingsPrivacy&settings_section=privacidade [NC,L,QSA]
    RewriteRule ^configuracoes/perfilrun/?$ /configuracoes/perfil/index.cfm?i18n_route=profileSettingsPerfilRun&settings_section=perfilrun [NC,L,QSA]
    RewriteRule ^cofiguracoes/perfilrun/?$ /configuracoes/perfilrun/ [R=302,L]
    RewriteRule ^configuracoes/remocao/?$ /configuracoes/privacidade/ [R=302,L]
    RewriteRule ^atleta/([^/]+)/saude/?$ /atleta/saude/index.cfm?i18n_route=athleteHealth&tag=$1 [NC,L,QSA]
    RewriteRule ^atleta/([^/]+)/retrospectiva/?$ /atleta/retrospectiva/index.cfm?i18n_route=athleteRetrospective&tag=$1 [NC,L,QSA]
    RewriteRule ^en/about/?$ /sobre/index.cfm?i18n_lang=en&i18n_route=about [NC,L,QSA]
    RewriteRule ^en/creator/?$ /creator/index.cfm?i18n_lang=en&i18n_route=creator [NC,L,QSA]
    RewriteRule ^en/help/?$ /ajuda/index.cfm?i18n_lang=en&i18n_route=help [NC,L,QSA]
    RewriteRule ^en/privacy/?$ /privacidade/index.cfm?i18n_lang=en&i18n_route=privacy [NC,L,QSA]
    RewriteRule ^es/privacidad/?$ /privacidade/index.cfm?i18n_lang=es&i18n_route=privacy [NC,L,QSA]
    RewriteRule ^es/sobre/?$ /sobre/index.cfm?i18n_lang=es&i18n_route=about [NC,L,QSA]
    RewriteRule ^es/creador/?$ /creator/index.cfm?i18n_lang=es&i18n_route=creator [NC,L,QSA]
    RewriteRule ^es/ayuda/?$ /ajuda/index.cfm?i18n_lang=es&i18n_route=help [NC,L,QSA]
</IfModule>
