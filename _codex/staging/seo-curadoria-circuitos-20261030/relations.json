  "localityFn": "CREATE OR REPLACE FUNCTION public.preencher_id_localidade_evento()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n    IF TG_OP = 'UPDATE'\r\n       AND NEW.cidade IS NOT DISTINCT FROM OLD.cidade\r\n       AND NEW.estado IS NOT DISTINCT FROM OLD.estado THEN\r\n        RETURN NEW;\r\n    END IF;\r\n\r\n    -- Limpa um ID anterior caso cidade ou estado tenham sido alterados.\r\n    NEW.id_localidade := NULL;\r\n\r\n    IF nullif(btrim(NEW.cidade), '') IS NULL\r\n       OR nullif(btrim(NEW.estado), '') IS NULL THEN\r\n        RETURN NEW;\r\n    END IF;\r\n\r\n    SELECT CASE\r\n             WHEN count(DISTINCT l.id_localidade) = 1\r\n             THEN min(l.id_localidade)\r\n             ELSE NULL\r\n           END\r\n      INTO NEW.id_localidade\r\n      FROM tbbi_dim_localidade AS l\r\n     WHERE get_tag(l.nome_cidade) = get_tag(NEW.cidade)\r\n       AND upper(btrim(l.estado)) = upper(btrim(NEW.estado));\r\n\r\n    RETURN NEW;\r\nEND;\r\n$function$\n"
