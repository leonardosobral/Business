  "definitions": {
    "get_id_geracao": "CREATE OR REPLACE FUNCTION public.get_id_geracao(p_faixa_idade int4range, p_ano_referencia integer)\n RETURNS integer\n LANGUAGE sql\n IMMUTABLE\nAS $function$\r\nSELECT\r\n    CASE\r\n\r\n        WHEN p_faixa_idade IS NULL OR p_ano_referencia IS NULL THEN 0\r\n        WHEN int4range(\r\n                 p_ano_referencia - upper(p_faixa_idade),\r\n                 p_ano_referencia - lower(p_faixa_idade),\r\n                 '[)'\r\n             ) && int4range(1946, 1965, '[)') THEN 1\r\n        WHEN int4range(\r\n                 p_ano_referencia - upper(p_faixa_idade),\r\n                 p_ano_referencia - lower(p_faixa_idade),\r\n                 '[)'\r\n             ) && int4range(1965, 1981, '[)') THEN 2\r\n        WHEN int4range(\r\n                 p_ano_referencia - upper(p_faixa_idade),\r\n                 p_ano_referencia - lower(p_faixa_idade),\r\n                 '[)'\r\n             ) && int4range(1981, 1996, '[)') THEN 3\r\n        WHEN int4range(\r\n                 p_ano_referencia - upper(p_faixa_idade),\r\n                 p_ano_referencia - lower(p_faixa_idade),\r\n                 '[)'\r\n             ) && int4range(1996, 2011, '[)') THEN 4\r\n        WHEN int4range(\r\n                 p_ano_referencia - upper(p_faixa_idade),\r\n                 p_ano_referencia - lower(p_faixa_idade),\r\n                 '[)'\r\n             ) && int4range(2010, NULL, '[)') THEN 0\r\n        ELSE 0\r\n    END;\r\n$function$\n"
  },
