<div class="modal fade" id="orRoadRunnersModal" tabindex="-1"
     aria-labelledby="orRoadRunnersTitle" aria-describedby="orRoadRunnersDescription" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content or-rr-modal">
            <div class="modal-header">
                <div class="or-rr-brand">
                    <img src="/assets/rr_icon.svg" width="36" height="36" alt=""/>
                    <span>Open Results <i class="fa-solid fa-arrow-right" aria-hidden="true"></i> <strong>Road Runners</strong></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="or-rr-save-symbol" id="orRoadRunnersSaveSymbol" hidden><i class="fa-solid fa-medal" aria-hidden="true"></i></div>
                <h2 class="or-rr-title" id="orRoadRunnersTitle">Continue no Road Runners</h2>
                <p id="orRoadRunnersDescription"></p>
                <div class="or-rr-context mb-3" id="orRoadRunnersContext" hidden>
                    <span class="or-rr-context-label" id="orRoadRunnersContextLabel">Buscar resultados de</span>
                    <strong class="d-block" id="orRoadRunnersName"></strong>
                    <div id="orRoadRunnersEventContext" hidden>
                        <span class="or-rr-event"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> <span id="orRoadRunnersEvent"></span></span>
                    </div>
                </div>
                <ol class="or-rr-steps" id="orRoadRunnersSteps" aria-label="Como salvar no Road Runners" hidden>
                    <li><span class="or-rr-step-number" aria-hidden="true">1</span><div><strong>Entre no Road Runners</strong><p>Use sua conta ou crie uma para continuar.</p></div></li>
                    <li><span class="or-rr-step-number" aria-hidden="true">2</span><div><strong>Confirme e salve</strong><p>Confira quais resultados são seus e adicione ao histórico.</p></div></li>
                </ol>
                <p class="small mb-3" id="orRoadRunnersNext"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn or-rr-continue shadow-0" id="orRoadRunnersContinue">
                    Continuar no Road Runners <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i>
                </button>
                <p class="or-rr-tab-note" id="orRoadRunnersContinueNote">Abre em nova aba. Sua consulta continua aqui.</p>
                <button type="button" class="or-rr-back" data-bs-dismiss="modal">Continuar consultando no Open Results</button>
            </div>
        </div>
    </div>
</div>
