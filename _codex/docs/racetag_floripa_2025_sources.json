  "athlete_result_schema": {
    "n": "bib number",
    "nm": "athlete name",
    "g": "sex code",
    "r": "route id; join event.routes[].i",
    "c": "category id; join event.categories[].i",
    "t": "team id; join event.teams[].i",
    "a": "age",
    "st": "start crossing timestamp",
    "ft": "finish crossing timestamp",
    "tn": "net time HH:MM:SS.mmm",
    "tg": "gross time HH:MM:SS.mmm",
    "s": "status such as DSQ or DNF; absent means eligible",
    "ck": "checkpoint passages [{i,t,r}]",
    "ck.i": "checkpoint id; join event.checkpoints[].i",
    "ck.t": "checkpoint crossing timestamp",
    "ck.r": "stored checkpoint rank; the TV page ignores it and recomputes rank",
    "aw": "award positions keyed by event.awards[].p",
    "ct": "custom fields; may contain registration identifiers",
    "tl": "timing tag identifiers",
    "ty": "undocumented numeric field; not used by the TV ranking"
  },
  "tv_ranking_algorithm": {
    "refresh_interval_ms": 15000,
    "eligible_filter": "exclude every athlete with a truthy s status; then match route id and sex",
    "finish_time": "use positive tn; otherwise positive tg",
    "checkpoint_time": "new Date(checkpoint.t) - new Date(athlete.st)",
    "sort": "ascending elapsed milliseconds",
    "limit_per_sex": 10,
    "boards": "two boards of five",
    "stored_checkpoint_rank_used": false,
    "finish_display": "leader absolute elapsed; subsequent athletes gap to leader",
    "checkpoint_display": "leader elapsed from own start; subsequent athletes gap to leader"
  },
  "integration_notes": [
    "Resolve the slug in events.json, then fetch event.json and results.json.",
    "Join routes, categories, checkpoints and teams by their compact i identifiers.",
    "For historical results prefer HTTP ETag or Last-Modified caching instead of polling every 15 seconds.",
    "The optional change-marker, team-results and theme files return 404 for both archived events and must not be required.",
    "Minimize or omit ct and tl when copying data to another application because they can contain personal or timing identifiers."
  ]
