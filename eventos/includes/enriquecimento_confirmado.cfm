<cfif NOT isDefined("qEvento") OR NOT qEvento.recordCount><cfabort></cfif>
<cfif structKeyExists(VARIABLES,"eventLocations") AND isStruct(VARIABLES.eventLocations) AND structKeyExists(VARIABLES.eventLocations,"enriquecimento") AND structKeyExists(VARIABLES.eventLocations.enriquecimento,"fields") AND NOT structIsEmpty(VARIABLES.eventLocations.enriquecimento.fields)>
<cfset VARIABLES.eventEnrichmentLabels=new services.geocoding.EnrichmentPolicy().definitions()>
<details class="border rounded p-3 mb-3"><summary class="fw-bold">Dados do evento · enriquecimento por IA</summary><p class="small text-body-secondary mt-2">Informações confirmadas nas fontes oficiais desta edição. Confira a vigência de preços e prazos. Alterações manuais no cadastro têm prioridade.</p>
<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Informação</th><th>Valor extraído</th><th>Evidência</th></tr></thead><tbody>
<cfloop collection="#VARIABLES.eventLocations.enriquecimento.fields#" item="VARIABLES.eventEnrichedKey"><cfif structKeyExists(VARIABLES.eventEnrichmentLabels,VARIABLES.eventEnrichedKey)><cfset VARIABLES.eventEnrichedField=VARIABLES.eventLocations.enriquecimento.fields[VARIABLES.eventEnrichedKey]><cfoutput>
<tr><td>#encodeForHTML(VARIABLES.eventEnrichmentLabels[VARIABLES.eventEnrichedKey].label)#</td><td class="geo-value" style="white-space:pre-line;overflow-wrap:anywhere">#encodeForHTML(VARIABLES.eventEnrichedField.value ?: '')#</td><td class="small"><cfif structKeyExists(VARIABLES.eventEnrichedField,'evidence')><details><summary>Conferir fonte</summary><blockquote>#encodeForHTML(VARIABLES.eventEnrichedField.evidence.excerpt ?: '')#</blockquote><cfif reFindNoCase('^https://',VARIABLES.eventEnrichedField.evidence.url ?: '')><a href="#encodeForHTMLAttribute(VARIABLES.eventEnrichedField.evidence.url)#" target="_blank" rel="noopener noreferrer">Abrir documento</a></cfif></details></cfif></td></tr>
</cfoutput></cfif></cfloop></tbody></table></div></details>
</cfif>
