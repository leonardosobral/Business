    var list_eventos = null;
    var limite_registro = 20;
    function nenhumEventoPostado() {
        alert(2)
    }
    function loadingListEvent(pagina) {
        var start_registros = (pagina * limite_registro);
        var conteudo = list_eventos.slice(start_registros,(start_registros +limite_registro));
        var div_cnt = $('#div-principal');
        div_cnt.html('');
        for (var item in conteudo) {
            var link_resultado = '';
            for (var menu in conteudo[item].link) {
                if (conteudo[item].link[menu].url.toString().trim() == '') {
                    link_resultado = link_resultado + '<button class="btn_link_empty"> ' + conteudo[item].link[menu].label.toString().toUpperCase() + '</button>';
                }
                else {
                    link_resultado = link_resultado + ' <a href="' + conteudo[item].link[menu].url + '" target="' + item + '_' + menu + '"><button class="btn_link"><i class="fa fa-arrow-circle-o-down" aria-hidden="true"></i> ' + conteudo[item].link[menu].label.toString().toUpperCase() + '</button></a>';
                }
            }
            var link_regulamento = '';
            if (conteudo[item].regulamento.length >= 1) {
                for (var menu in conteudo[item].regulamento) {
                    if (conteudo[item].regulamento[menu].toString().trim() != '') {
                        link_regulamento = link_regulamento + ' <a href="' + conteudo[item].regulamento[menu].toString().trim() + '" target="' + item + '_' + menu + '"><button class="btn_resultado"><i class="fa fa-file-pdf-o" aria-hidden="true"></i> REGULAMENTO </button></a>';
                    }
                }
            }
            var link_inscricao = '';
            if (conteudo[item].inscritos != '') {
                link_inscricao = ' <a href="' + conteudo[item].inscritos.toString().trim() + '" target="inscritos_' + item + '"><button class="btn_lista_inscritos"><i class="fa fa-list-ol" aria-hidden="true"></i> INSCRITOS </button></a>';
            }

            var div_row = '<div class="row" style="margin-bottom:40px">' +
                '    <div class="col-lg-3 col-md-3"> <img style="border-radius:3px;  width:100%" src="' + conteudo[item].imagem + '"> </div>' +
                '    <div class="col-lg-9 col-md-9" style="background-color:#f5f7f7">' +
                '        <TABLE style="width:100%">' +
                '            <tr>' +
                '                <td class="nome-evento" valign="top" align="left"> ' + conteudo[item].nome + ' </td>' +
                '            </tr>' +
                '            <tr>' +
                '                <td class="nome-cidade"> ' + conteudo[item].cidade + '</td>' +
                '            </tr>' +
                '            <tr>' +
                '                <td class="data-evento">' +
                '                    <i class="fa fa-calendar-o" aria-hidden="true"></i> ' + conteudo[item].data + '</td>' +
                '            </tr>' +
                '            <tr>' +
                '                <td class="estrelas-evento">' +
                '                    <i class="fa fa-star" aria-hidden="true"></i><i class="fa fa-star" aria-hidden="true"></i><i class="fa fa-star" aria-hidden="true"></i><i class="fa fa-star" aria-hidden="true"></i><i class="fa fa-star" aria-hidden="true"></i>' +
                '                </td>' +
                '            </tr>' +
                '            <tr>' +
                '                <td>' +
                '                    <div style="height:5px;width:130px;background-color:var(--color-base-cliente,#2e6da4)"></div><div style="height:1px;background-color:var(--color-base-cliente,#2e6da4)"></div>' +
                '                </td>' +
                '            </tr>' +
                '            <tr>' +
                '                <td class="data-evento"> ' + link_inscricao +' '+ link_regulamento +' '+ link_resultado + ' </td>' +
                '            </tr>' +
                '        </TABLE>' +
                '    </div>' +
                '</div>';
            div_cnt.append(div_row)
        }
        loadingListPaginacao(pagina);
    }
    function loadingListPaginacao(pagina){
        var fator = 0;
        if (list_eventos.length > limite_registro) {
            fator = (list_eventos.length / limite_registro);
            fator = Math.trunc(fator);
            if ((list_eventos.length % limite_registro) > 0) {
                fator++;
            }
        }
        var paginacao = $("#div-paginacao");
        paginacao.html('');
        if (fator > 0) {
            var i = 0;
            while (i < fator) {
                if (i == pagina) {
                    paginacao.append('<div onclick="paginacao_resultado('+i+')" class="paginacao-resultado-setado">'+(i+1)+'</div>');
                }
                else {
                    paginacao.append('<div onclick="paginacao_resultado('+i+')" class="paginacao-resultado">'+(i+1)+'</div>');
                }
                i++;
            }
        }
    }
    function paginacao_resultado(pagina) {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
        loadingListEvent(pagina);
    }
    function pesquisar_evento() {
        list_eventos = new Array();
        var evento = $("#input_pesquisar").val();
        var evento = evento.toString().toUpperCase().trim();
        for (var item in list_temp) {
            item_nome = list_temp[item].nome.toString().toUpperCase().trim();
            item_nome_especial = list_temp[item].nome_especial.toString().toUpperCase().trim();
            item_cidade_especial = list_temp[item].cidade_especial.toString().toUpperCase().trim();
            item_cidade = list_temp[item].cidade.toString().toUpperCase().trim();
            result_evento = item_nome.includes(evento);
            result_cidade = item_cidade.includes(evento);
            result_nome_especial = item_nome_especial.includes(evento);
            result_cidade_especial = item_cidade_especial.includes(evento);
            if (result_evento || result_cidade || result_nome_especial || result_cidade_especial) {
                list_eventos.push(list_temp[item]);
            }
        }
        loadingListEvent(0);
    }
</script>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;1,700&family=Yantramanav:wght@500&display=swap" rel="stylesheet">
<style>
    .nome-evento{
        font-size: 24px;
        font-weight: bold;
        color: #3e4157;

    }
    .nome-cidade{
        font-size: 16px;
        font-weight: bold;
        color: #010417;
        text-align: left;
    }
    .data-evento{
        font-size: 16px;
        font-weight: bold;
        color: #010417;
        text-align: left;
    }
    .estrelas-evento{
        color: orange;
        text-align: left;
    }
    td{
        padding:8px;
        color: #000;
        letter-spacing:0.5px;
        font-family: 'Yantramanav', sans-serif;
    }
    .btn_link:hover{
        background-color: var(--background_button_eventos_hover,#2e6da4);
        cursor: pointer;
    }
    .btn_link_empty,
    .btn_link{
        background-color: var(--color-base-cliente,#2e6da4);
        color: var(--color_menu_link_top,#2e6da4);
        font-weight:lighter;
        padding: 10px;
        border: none;
        border-radius:3px;
        margin-bottom: 5px;
        margin-right: 5px;
    }
    .btn_link_empty{
        background-color: #CCC;
        color: #000;
    }
    .btn_lista_inscritos,
    .btn_link_resultado,
    .btn_resultado{
        background-color: var(--color-base-cliente,#2e6da4);
        color: var(--color_menu_link_top,#2e6da4);
        font-weight:lighter;
        padding: 10px;
        border: none;
        border-radius:3px;
        margin-bottom: 5px;
        margin-right: 5px;
    }
    .btn_lista_inscritos{
        background-color: var(--color-base-cliente,#2e6da4);
    }
    .btn_lista_inscritos:hover{
        background-color: var(--background_button_eventos_hover,#2e6da4);
        color:#FFF;
        cursor:pointer;
    }
    .btn_resultado:hover{
        background-color: var(--background_button_eventos_hover,#2e6da4);
        cursor: pointer;
    }
    .btn-pesquisar{
        height: 52px;
        width:100%;
        padding:10px;
        border: none;
        border-radius: 5px;
        margin-bottom:10px;
    }
    .input-pesquisar{
        height: 52px;
        width:100%;
        padding:10px;
        border-radius: 5px;
        margin-bottom:10px;
