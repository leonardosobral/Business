lder="Insira o nome ou número de peito"/></div><div class="form-group meia-direita"><button class="botaresultadogeral">Buscar Certificado</button></div><div class="form-group inteira txtcenter"><h3>Ranking</h3></div><div class="form-group inteira listrank" style="overflow-x: auto;"></div><div class="form-group inteira txtcenter" style="margin-top:30px;"><a onclick="previewPage()" style="margin-right:15px;">PREV</a><a onclick="initialPage()">-|- INICIO -|-</a><a onclick="nextPage()" style="margin-left:15px;">NEXT</a></div><script>if(!getCookie("pageRanking")){
	initialPage();
}

pageRanking = Number(getCookie("pageRanking"));

function initialPage(){
	pageRanking = 1;
	setCookie(pageRanking);
}

function nextPage(){
	pageRanking += 10;
	setCookie(pageRanking);
}

function previewPage(){
	if(pageRanking > 10)
		pageRanking -= 10;
		setCookie(pageRanking);
}

function setCookie(pageRanking){
	document.cookie = "pageRanking" + "=" + pageRanking + "" + "; path=/";
	location.reload();
	console.log("setting cookie pageRanking - " + pageRanking)
}

function getCookie(name) {
	var cookieArr = document.cookie.split("; ");
	for (var i = 0; i < cookieArr.length; i++) {
		var cookiePair = cookieArr[i].split("=");
		if (cookiePair[0] === name) {
			return decodeURIComponent(cookiePair[1]);
		}
	}
	return null;
	
}</script></div><div id="cadastro-part-2"><div class="form-group inteira txtcenter"><button class="botbusresultado boton">Nova Busca</button></div><div class="form-group inteira txtcenter" style="margin-top: 35px;"><h3>Certificados</h3></div><div class="form-group inteira resultadobuscageral"><table class="display listagem" style="width:100%"><thead><tr><th>Nome do Atleta</th><th>Nº do Peito</th><th>Tempo</th><th>Pace min/Km</th><th>Distância</th><th></th></tr></thead><tbody></tbody></table></div></div><div id="cadastro-part-3"><div class="container single-event single-event-result single-event-athlete" data-script="Singleeventos"><div class="event-content" data-script="eventSidebar"><div class="event-information sticky-desktop" id="geracert"><div class="templategeracertificado"> </div><div class="col geralsingle"><div class="col single-event-header"><div class="kit2 terceiro"><h2>Organizador<i class="icon-angle-down"></i></h2><div class="div"> <hr style="margin:0px;"/></div><div id="container_kit2"><div id="kit2_esq" style="float: left; width: 60px;"></div><img src="https://via.placeholder.com/50x50" alt="Logo Idealizador"/><div id="kit2_dir"><span class="title">CIA DE EVENTOS</span><span class="cpf">CNPJ/CPF: 21.551.821/0001-96</span></div><div id="kit2_falecom_desc"></div><div class="site" id="kit2_falecom"><a target="_blank" href="http://">Site do Organizador</a></div><div class="fale" id="kit2_falecom"><a href="mailto:celio@ciadeeventos.com.br, viviane@ciadeeventos.co">Entre em contato</a></div><div class="div"> </div><p class="infdesc">As informações divulgadas nesta página, são de responsabilidades do organizador.</p></div></div></div><div class="col single-event-header" data-script="singleEventCountdown"><article class="card card-event"><div class="card-info"><a class="card-cover large" href="https://www.ativo.com/calendario/eventos/america-do-sul/br/sp/bertioga/corrida-de-rua/36216/ultramaratona-de-revezamento-bertioga-maresias-1-etapa/" title="Ultramaraton