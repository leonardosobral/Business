.</span><button id="menu-navegacao-ir" type="button" aria-label="Ir para a seção selecionada na navegação rápida">Ir</button><script>(function () {
    var menuNav = document.getElementById('menu-navegacao');
    var menuBtn = document.getElementById('menu-navegacao-ir');

    if (window.location.pathname !== '/') {
        if (menuNav) menuNav.style.display = 'none';
        if (menuBtn) menuBtn.style.display = 'none';
        return;
    }

    function focarAlvo(valor) {
        var alvo = document.querySelector(valor);
        if (alvo) {
            if (!alvo.hasAttribute('tabindex')) alvo.setAttribute('tabindex', '-1');
            try { alvo.focus({ preventScroll: true }); } catch (e) { alvo.focus(); }
            try { alvo.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
            catch (e) { alvo.scrollIntoView(true); }
        }
    }

    function navegar() {
        if (!menuNav) return;
        var valor = menuNav.value;
        if (!valor) return;

        window.location.hash = valor;
        focarAlvo(valor);
    }

    if (menuNav) {
        menuNav.addEventListener('change', function () {
            if (menuNav.value) navegar();
        });
    }

    if (menuBtn) menuBtn.addEventListener('click', navegar);
})();
</script><script>document.addEventListener('DOMContentLoaded', function () {
    var openBtn = document.getElementById('menu_icon');
    var nav = document.getElementById('main_menu');
    var closeBtn = document.getElementById('menu_close');

    if (!openBtn || !nav || !closeBtn) return;

    function getFocusableElements(container) {
        return Array.prototype.slice.call(
            container.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
            )
        ).filter(function (el) {
            return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
        });
    }

    function setMenuState(isOpen) {
        openBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        nav.setAttribute('aria-hidden', isOpen ? 'false' : 'true');

        if (isOpen) {
            nav.classList.add('is-open');
            nav.classList.add('show');
        } else {
            nav.classList.remove('is-open');
            nav.classList.remove('show');
        }
    }

    function openMenu() {
        setMenuState(true);
        closeBtn.focus();
        document.addEventListener('keydown', onKeyDown, true);
    }

    function closeMenu() {
        setMenuState(false);
        openBtn.focus();
        document.removeEventListener('keydown', onKeyDown, true);
    }

    function trapTab(e) {
        if (e.key !== 'Tab') return;

        var focusables = getFocusableElements(nav);
        if (!focusables.length) return;

        var first = focusables[0];
        var last = focusables[focusables.length - 1];

        if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
        }
    }

    function onKeyDown(e) {
        if (e.key === 'Escape') {
            e.preventDefault();
            closeMenu();
            return;
        }
        trapTab(e);
    }

    openBtn.addEventListener('click', function () {
        var isOpen = nav.classList.contains('is-open');
        if (isOpen) closeMenu();
        else openMenu();
    });

    closeBtn.addEventListener('click', closeMenu);

    nav.addEventListener('click', function (e) {
        if (e.target === nav) closeMenu();
    });
});
</script><script>(function () {
    document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('#main_menu a.dropdown-item') : null;
        if (!a) return;

        var href = a.getAttribute('href');
        if (!href || href === '#') return;

        e.preventDefault();
        e.stopImmediatePropagation();
        window.location.href = href;
    }, true);
})();
