		<script>let fl_resultado = document.getElementsByName("fl_resultado")[0].value;
let dt_evento = document.getElementsByName("dt_evento")[0].value;
let fl_multiplasatividades = document.getElementsByName("fl_multiplasatividades")[0].value;
let cadini = document.getElementsByName("cadini")[0].value;
let evento_pos_evento = document.getElementsByName("evento_pos_evento")[0].value;
let data_atual = new Date().toISOString().replace('-', '').split('T')[0].replace('-', '');
let hora_atual =  new Date().toISOString().replace('-', '').split('T')[1].split(':');
data_atual = data_atual + hora_atual[0] - 3 + hora_atual[1];

if (evento_pos_evento == '1' && cadini <= data_atual){
	if ( fl_multiplasatividades == '1') {
		document.getElementById('poseventomultiplasatividades').style.display = 'block';
	} else {
		document.getElementById('posevento_virtual').style.display = 'block';
	}
} else {
	if ((fl_resultado == 1 && dt_evento <= data_atual) || dt_evento <= data_atual) {
		document.getElementById('resultado').style.display = 'block';
	} else {
		document.getElementById('inscricao').style.display = 'block';
	}
}</script></body></html>