        <div class="col-12 order-3 d-md-none mt-4">
                <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-geo-alt-fill"></i> Localização</h5>
            </div>
            <div class="card-body p-0">
                <iframe
                    width="100%"
                    height="300"
                    frameborder="0"
                    scrolling="no"
                    style="border:0; border-radius: 0 0 0.375rem 0.375rem;"
                    src="https://www.openstreetmap.org/export/embed.html?bbox=-43.8967792%2C-19.6303854%2C-43.8867792%2C-19.6243854&layer=mapnik&marker=-19.6273854%2C-43.8917792"
                    allowfullscreen>
                </iframe>
                <div class="p-2 text-center">
                    <a href="https://www.google.com/maps?q=-19.6273854,-43.8917792" target="_blank" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-box-arrow-up-right"></i> Abrir no Google Maps
                    </a>
                </div>
            </div>
        </div>
    </div>
    </div>

<script>
function copiarLinkEvento() {
    var url = "https:\/\/app.poptickets.com.br\/evento\/9";
    if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function() {
            var btn = document.getElementById('btnCopiarLink');
            var original = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check-lg"></i> Copiado!';
            btn.classList.add('btn-success');
            btn.classList.remove('btn-outline-secondary');
            setTimeout(function() {
                btn.innerHTML = original;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
            }, 2000);
        });
    } else {
        var input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        alert('Link copiado!');
    }
}

if (navigator.share) {
    var btnNative = document.getElementById('btnNativeShare');
    btnNative.classList.remove('d-none');
    btnNative.addEventListener('click', function() {
        navigator.share({
            title: "Circuito das Cidades Etapa Lagoa Santa",
            text: "Circuito das Cidades Etapa Lagoa Santa - 09\/08\/2026 07:00 | Pra\u00e7a Dr Lund",
            url: "https:\/\/app.poptickets.com.br\/evento\/9"        });
    });
}

document.addEventListener('DOMContentLoaded', function() {
    var qtyBtns = document.querySelectorAll('.qty-btn');
    var btnAdd = document.getElementById('btnAdicionarCarrinho');

    function updateTotal() {
        var total = 0;
        var labelsAtivos = {};
        document.querySelectorAll('.qty-input').forEach(function(input) {
            var qty = parseInt(input.value) || 0;
            total += qty;
            if (qty > 0) {
                var lbl = (input.dataset.label || '').trim();
                if (lbl) labelsAtivos[lbl] = (labelsAtivos[lbl] || 0) + qty;
            }
        });
        // Quando limite_por_cpf ativo não há qty-input: conta os hidden fixos
        if (total === 0) {
            document.querySelectorAll('input[type="hidden"][name^="lotes["]').forEach(function(h) {
                total += parseInt(h.value) || 0;
            });
        }
        if (btnAdd) {
            btnAdd.disabled = total === 0;
            if (total > 0) {
                var keys = Object.keys(labelsAtivos);
                var labelText;
                if (keys.length === 1) {
                    labelText = total + ' ' + keys[0] + (total > 1 ? 's' : '');
                } else {
                    labelText = total + ' ingresso' + (total > 1 ? 's' : '');
                }
                btnAdd.innerHTML = '<i class="bi bi-cart-plus"></i> Adicionar ' + labelText + ' ao Carrinho';
            } else {
                btnAdd.innerHTML = '<i class="bi bi-cart-plus"></i> Adicionar ao Carrinho';
            }
        }
    }

    qtyBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            var loteId = this.dataset.lote;
            var input = document.querySelector('.qty-input[data-lote="' + loteId + '"]');
            var val = parseInt(input.value) || 0;
            var action = this.dataset.action;

            if (action === 'plus') {
                var max = parseInt(this.dataset.max) || 10;
                if (val < max) input.value = val + 1;
            } else {
                if (val > 0) input.value = val - 1;
            }
            updateTotal();
        });
    });

    // Habilita botão imediatamente se houver hidden com valor fixo (limite_por_cpf)
    updateTotal();

    var form = document.getElementById('formLotes');
    if (form) {
        form.addEventListener('submit', function(e) {
            var total = 0;
            document.querySelectorAll('.qty-input').forEach(function(input) {
                total += parseInt(input.value) || 0;
            });
            document.querySelectorAll('input[type="hidden"][name^="lotes["]').forEach(function(h) {
                total += parseInt(h.value) || 0;
            });
            if (total === 0) {
                e.preventDefault();
                alert('Selecione pelo menos 1 ingresso.');
            }
        });
    }
});

var assentosSelecionados = [];
var mapaSetorAtual = null;
var assentoIcone = 'cadeira';
var assentoLabelMap = {cadeira:'Cadeira', poltrona:'Poltrona', mesa:'Mesa', cama:'Cama', individual:'Ingresso', camarote:'Camarote'};
var assentoLabelSingular = assentoLabelMap[assentoIcone] || 'Assento';
var seatIcons = {
    cadeira: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17 2H7v7H5v2h1v2H5v2h2v5h2v-5h6v5h2v-5h2v-2h-1v-2h1V9h-2V2zm-2 2v5H9V4h6zm-6 7h6v2H9v-2z"/></svg>',
    poltrona: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M5 11V7c0-1.66 1.34-3 3-3h8c1.66 0 3 1.34 3 3v4h1c1.1 0 2 .9 2 2v4h-2v2h-2v-2H6v2H4v-2H2v-4c0-1.1.9-2 2-2h1zm2 0h10V7c0-.55-.45-1-1-1H8c-.55 0-1 .45-1 1v4zm-2 2h14v2H5v-2z"/></svg>',
    mesa: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="8" y="8" width="8" height="8" rx="1"/><rect x="10" y="2" width="4" height="5" rx="1"/><rect x="10" y="17" width="4" height="5" rx="1"/><rect x="2" y="10" width="5" height="4" rx="1"/><rect x="17" y="10" width="5" height="4" rx="1"/></svg>',
    cama: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M2 16v2h20v-2H2zm0-2h20v-4c0-1.1-.9-2-2-2h-7v3H5V8H4c-1.1 0-2 .9-2 2v4zm5-6c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/></svg>',
    individual: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.33 0-10 1.67-10 5v2h20v-2c0-3.33-6.67-5-10-5z"/></svg>',
    camarote: '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>'
};

function carregarMapaAssentos() {
    var selectSetor = document.getElementById('selectSetor');
    var setorId = selectSetor.value;
    var container = document.getElementById('mapaAssentosContainer');
    var mapaDiv = document.getElementById('mapaAssentos');

    if (!setorId) {
        container.style.display = 'none';
        return;
    }

    mapaSetorAtual = {
        id: setorId,
        nome: selectSetor.options[selectSetor.selectedIndex].text.split(' - ')[0],
        preco: parseFloat(selectSetor.options[selectSetor.selectedIndex].dataset.preco) || 0
    };

    mapaDiv.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>';
    container.style.display = '';

    fetch('/api/mapa-assentos/' + setorId)
        .then(function(r) { return r.json(); })
        .then(function(mapa) {
            mapaDiv.innerHTML = '';
            var fileiras = Object.keys(mapa).sort();
            var numeracaoSequencial = fileiras.length === 1 && fileiras[0] === '';
            fileiras.forEach(function(fileira) {
                var row = document.createElement('div');
                row.className = 'seat-row';
                if (!numeracaoSequencial && fileira !== '') {
                    var label = document.createElement('span');
                    label.className = 'seat-row-label';
                    label.textContent = fileira;
                    row.appendChild(label);
                }
                var seats = document.createElement('div');
                seats.className = 'seat-row-seats';
                mapa[fileira].forEach(function(a) {
                    var seatBtn = document.createElement('button');
                    seatBtn.type = 'button';
                    seatBtn.className = 'seat-btn';
                    seatBtn.dataset.id = a.id;
                    seatBtn.dataset.numero = a.numero;
                    seatBtn.dataset.fileira = fileira;
                    seatBtn.title = numeracaoSequencial ? 'Ingresso ' + a.numero : 'Fileira ' + fileira + ' - Assento ' + a.numero;
                    var isSelecionado = assentosSelecionados.some(function(s) { return s.id == a.id; });
                    if (a.status !== 'disponivel' && !isSelecionado) {
                        seatBtn.className += ' seat-vendido';
                        seatBtn.disabled = true;
                        seatBtn.innerHTML = '<i class="bi bi-person-fill"></i>';
                    } else if (isSelecionado) {
                        seatBtn.className += ' seat-selecionado';
                        seatBtn.innerHTML = '<i class="bi bi-check-lg"></i>';
                    } else {
                        seatBtn.className += ' seat-disponivel';
                        seatBtn.innerHTML = seatIcons[assentoIcone] || seatIcons['cadeira'];
                    }
                    var numLabel = document.createElement('span');
                    numLabel.className = 'seat-num';
                    numLabel.textContent = a.numero;
                    seatBtn.appendChild(numLabel);
                    seatBtn.addEventListener('click', function() {
                        toggleAssento(this, a, fileira);
                    });
                    seats.appendChild(seatBtn);
                });
                row.appendChild(seats);
                mapaDiv.appendChild(row);
            });
        });
}

function toggleAssento(btn, assento, fileira) {
    var idx = -1;
    for (var i = 0; i < assentosSelecionados.length; i++) {
        if (assentosSelecionados[i].id == assento.id) { idx = i; break; }
    }

    if (idx >= 0) {
        assentosSelecionados.splice(idx, 1);
        btn.className = 'seat-btn seat-disponivel';
        btn.innerHTML = seatIcons[assentoIcone] || seatIcons['cadeira'];
        var numLabel = document.createElement('span');
        numLabel.className = 'seat-num';
        numLabel.textContent = assento.numero;
        btn.appendChild(numLabel);
    } else {
        if (assentosSelecionados.length >= 10) {
            alert('Máximo de 10 assentos por compra.');
            return;
        }
        assentosSelecionados.push({
            id: assento.id,
            setor_id: mapaSetorAtual.id,
            setor_nome: mapaSetorAtual.nome,
            fileira: fileira,
            numero: 'Assento ' + assento.numero,
            preco: mapaSetorAtual.preco
        });
        btn.className = 'seat-btn seat-selecionado';
        btn.innerHTML = '<i class="bi bi-check-lg"></i>';
        var numLabel = document.createElement('span');
        numLabel.className = 'seat-num';
        numLabel.textContent = assento.numero;
        btn.appendChild(numLabel);
    }
    atualizarListaAssentos();
}

function removerAssento(idx) {
    var removido = assentosSelecionados[idx];
    assentosSelecionados.splice(idx, 1);
    var seatBtn = document.querySelector('.seat-btn[data-id="' + removido.id + '"]');
    if (seatBtn) {
        seatBtn.className = 'seat-btn seat-disponivel';
        seatBtn.innerHTML = seatIcons[assentoIcone] || seatIcons['cadeira'];
        var numLabel = document.createElement('span');
        numLabel.className = 'seat-num';
        numLabel.textContent = removido.numero.replace('Assento ', '');
        seatBtn.appendChild(numLabel);
    }
    atualizarListaAssentos();
}

function atualizarListaAssentos() {
    var lista = document.getElementById('listaAssentosSelecionados');
    var hiddenContainer = document.getElementById('assentos-selecionados');
    var btn = document.getElementById('btnAdicionarCarrinhoAssentos');

    hiddenContainer.innerHTML = '';
    lista.innerHTML = '';

    assentosSelecionados.forEach(function(a, idx) {
        hiddenContainer.innerHTML += '<input type="hidden" name="assento_ids[]" value="' + a.id + '">';
        var localInfo = a.fileira ? 'Fil. ' + a.fileira + ' - ' + a.numero : a.numero;
        lista.innerHTML += '<div class="d-flex justify-content-between align-items-center border-bottom py-2">' +
            '<div><small class="fw-bold">' + a.setor_nome + '</small> - ' + localInfo +
            '<br><small class="text-primary fw-bold">R$ ' + a.preco.toFixed(2).replace('.', ',') + '</small></div>' +
            '<button type="button" class="btn btn-sm btn-outline-danger" onclick="removerAssento(' + idx + ')">' +
            '<i class="bi bi-x"></i></button></div>';
    });

    btn.disabled = assentosSelecionados.length === 0;
    if (assentosSelecionados.length > 0) {
        var total = 0;
        assentosSelecionados.forEach(function(a) { total += a.preco; });
        var lbl = assentoLabelSingular;
        btn.innerHTML = '<i class="bi bi-cart-plus"></i> Adicionar ' + assentosSelecionados.length + ' ' + lbl + (assentosSelecionados.length > 1 ? 's' : '') + ' (R$ ' + total.toFixed(2).replace('.', ',') + ')';
    } else {
        btn.innerHTML = '<i class="bi bi-cart-plus"></i> Adicionar ao Carrinho';
    }
}
</script>
