003cp class=\"MsoBodyText\" align=\"left\" style=\"margin-left: 0cm;\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\"\u003e\u003cb\u003e\u003cu\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDESCRITIVO\r\n\u003cspan style=\"letter-spacing:-.1pt\"\u003eGERAL\u003c/span\u003e\u003c/span\u003e\u003c/u\u003e\u003c/b\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\"\u003e\u003cb style=\"font-family: inherit; font-size: 33px; text-indent: -18pt; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri;letter-spacing:-.1pt\"\u003e1)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb style=\"font-family: inherit; font-size: 33px; text-indent: -18pt; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eSOBRE A \u003cspan style=\"letter-spacing:-.1pt\"\u003eCORRIDA\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\" style=\"margin-left:14.2pt;text-align:justify\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDATA\u003cspan style=\"letter-spacing:-.6pt\"\u003e \u003c/span\u003eDA\u003cspan style=\"letter-spacing:-.6pt\"\u003e \u003c/span\u003eCORRIDA:\u003cspan style=\"letter-spacing:-.6pt\"\u003e\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:\r\n11.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003e31/10/2026\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;letter-spacing:\r\n-.1pt\"\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\" style=\"margin-left:14.2pt;text-align:justify\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eLOCAL DA LARGADA:\u003c/span\u003e\u003c/b\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e ESPAÇO ALTERNATIVO\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\" style=\"margin-left:14.2pt;text-align:justify\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eHORÁRIO\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003ePREVISTO\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eDE\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eLARGADA:\r\n\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:11.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;\r\nmso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003e17h30 concentração e 18h00 largada\u003c/span\u003e\u003c/b\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;letter-spacing:\r\n-.1pt\"\u003e, observando sempre o horário local de Porto Velho - RO.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\" style=\"margin-left:14.2pt;text-align:justify\"\u003e\u003cb style=\"font-family: inherit; letter-spacing: 0px; font-size: 33px; text-indent: -18pt;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri;letter-spacing:-.1pt\"\u003e2)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb style=\"font-family: inherit; letter-spacing: 0px; font-size: 33px; text-indent: -18pt;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eCONDIÇÕES \u003cspan style=\"letter-spacing:-.1pt\"\u003eCLIMÁTICAS\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\nlargada da corrida será realizada no sábado, 31 de outubro de 2026, sob\r\nqualquer condição climática, desde que não coloque em risco a integridade\r\nfísica dos participantes.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u003cbr\u003e\u003c/span\u003e\u003cb style=\"font-family: inherit; font-size: 33px; text-indent: -18pt; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri;letter-spacing:-.1pt\"\u003e3)\u0026nbsp;\u0026nbsp;\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb style=\"font-family: inherit; font-size: 33px; text-indent: -18pt; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;letter-spacing:\r\n-.1pt\"\u003ePERCURSO\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\ncorrida será disputada nas distâncias de 5km (cinco quilômetros) e 10km (dez\r\nquilômetros), terá a duração máxima de 2h (duas horas), com percurso aferido\r\npor medidor credenciado junto à Confederação Brasileira de Atletismo (“CBAT”),\r\nque será amplamente divulgado na página da corrida e nas redes sociais da\r\norganização do evento.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u003cbr\u003e\u003c/span\u003e\u003cb style=\"font-family: inherit; font-size: 33px; text-indent: -18pt; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri;letter-spacing:-.1pt\"\u003e4)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb style=\"font-family: inherit; font-size: 33px; text-indent: -18pt; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eCATEGORIAS\u003cspan style=\"letter-spacing:-.45pt\"\u003e \u003c/span\u003eE\u003cspan style=\"letter-spacing:-.45pt\"\u003e \u003c/span\u003e\u003cspan style=\"letter-spacing:-.1pt\"\u003eDISTÂNCIAS\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA \u003cb\u003e1ª\r\n\u003c/b\u003e\u003c/span\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\r\n\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003eCorrida Aliança pela Vida\u003c/span\u003e\u003c/b\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\r\nserá disputada, exclusivamente, nas categorias:\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:14.2pt;\r\ntab-stops:list 18.0pt left 43.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif;letter-spacing:-.1pt\"\u003e* CAMINHADA e \u0026nbsp;CORRIDINHA KIDS;\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\u003ch1 style=\"margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:14.2pt;\r\ntab-stops:list 18.0pt left 43.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif;letter-spacing:-.1pt\"\u003e* CORRIDA 5 KM e \u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eCORRIDA \u003cspan style=\"letter-spacing:-.1pt\"\u003e10 KM:\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\u003cp class=\"MsoNormal\"\u003e\u003cspan lang=\"PT\"\u003e\u0026nbsp;\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;-\u0026nbsp;\u0026nbsp;\r\nPÚBLICO GERAL e COLABORADOR(05 KM), FEMININO e MASCULINO\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eCategoria\u003cspan style=\"letter-spacing:-.2pt\"\u003e\r\n\u003c/span\u003e\u003cb\u003eCAMINHADA\u003cspan style=\"letter-spacing:\r\n-.2pt\"\u003e \u003c/span\u003e\u003c/b\u003eé\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003edestinada\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eaos\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eatletas\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eque\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ebuscam\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eparticipar do evento de maneira moderada,\r\nmantendo o espírito competitivo. Os participantes poderão escolher livremente o\r\nmomento de seu retorno para a linha de chegada, desde que o percurso se\r\nmantenha dentro do trajeto delimitado para\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003eos\r\n05 km (cinco quilômetros) e respeitando\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003eo\r\ntempo máximo de duração do evento, possibilitando a integração de participantes\r\ncom diferentes níveis de preparo físico.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eCom\r\no objetivo de incentivar a participação das crianças nas práticas esportivas e\r\npromover integração social, a categoria \u003cb\u003eCORRIDINHA\r\nKIDS \u003c/b\u003econsistirá na participação de crianças na faixa etária de até 13 anos.\r\nA corridinha consistirá nas seguintes distâncias:\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-indent:-17.85pt;\r\nmso-list:l1 level1 lfo1;tab-stops:79.05pt\"\u003e\u003cspan lang=\"PT\" style=\"\"\u003e\u0026nbsp;*\u0026nbsp;\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eAté 5 anos: 50 m (cinquenta \u003cspan style=\"letter-spacing:-.1pt\"\u003emetros)\u003c/span\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-indent:-17.85pt;\r\nmso-list:l1 level1 lfo1;tab-stops:79.05pt\"\u003e\u003cspan lang=\"PT\" style=\"\"\u003e*\u0026nbsp;\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDe 06 a 07 anos: 100 m (cem \u003cspan style=\"letter-spacing:-.1pt\"\u003emetros)\u003c/span\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-indent:-17.85pt;\r\nmso-list:l1 level1 lfo1;tab-stops:79.05pt\"\u003e\u003cspan lang=\"PT\" style=\"\"\u003e*\u0026nbsp;\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDe 08 a 09 anos: 150 m (cento e cinquenta \u003cspan style=\"letter-spacing:-.1pt\"\u003emetros)\u003c/span\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-indent:-17.85pt;\r\nmso-list:l1 level1 lfo1;tab-stops:79.05pt\"\u003e\u003cspan lang=\"PT\" style=\"\"\u003e*\u0026nbsp;\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDe\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003e10\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003ea\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003e11\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eanos:\u003cspan style=\"letter-spacing:-.15pt\"\u003e\r\n\u003c/span\u003e200 m (duzentos\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003e\u003cspan style=\"letter-spacing:-.1pt\"\u003emetros)\u003c/span\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-indent:-17.85pt;\r\nmso-list:l1 level1 lfo1;tab-stops:79.05pt\"\u003e\u003cspan lang=\"PT\" style=\"\"\u003e*\u0026nbsp;\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDe 12 a 13 anos: 300 m (trezentos \u003cspan style=\"letter-spacing:-.1pt\"\u003emetros)\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 43.7pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri;letter-spacing:-.1pt\"\u003e5)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eIDADE \u003cspan style=\"letter-spacing:-.1pt\"\u003eMÍNIMA\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 14px; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/h1\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eOs(as)\r\natletas menores de 18\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eanos\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003esó\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003epoderão\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eparticipar\u003cspan style=\"letter-spacing:\r\n-.2pt\"\u003e \u003c/span\u003eda\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ecorrida\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003e\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:\r\n10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;\r\nmso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003ecom autorização por escrito do pai ou \u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eda\r\nmãe ou de responsável legal.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\nautorização deverá ser entregue à Comissão Organizadora no ato da entrega do\r\nkit do atleta, sendo necessária a presença do responsável autorizante e a\r\napresentação do mesmo documento de identificação inserido\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003eno termo que autoriza a participação do\r\nmenor.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\nautorização deverá estar\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eacompanhada\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ede\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ecópia\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ede\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eum\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003edocumento\u003cspan style=\"letter-spacing:-.2pt\"\u003e\r\n\u003c/span\u003e\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt;\r\nline-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003ede\r\nidentidade que será retido pela organização no momento da retirada do kit,\r\nconforme modelo inserido no regulamento, observando ainda o disposto no \u003c/span\u003e\u003ci\u003e\u003cspan lang=\"PT\" style=\"font-size:9.5pt;\r\nmso-bidi-font-size:12.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;\r\nmso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003eArt. 14, § 1º\u003c/span\u003e\u003c/i\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\r\n\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003e, da Lei Geral de\r\nProteção de Dados (Lei N. 13.709/2018)\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\r\n\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003eEm cumprimento às Regras\r\nOficiais da Associação Internacional de Federações de Atletismo (“World\r\nAThletics”), a idade\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:\r\n115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;letter-spacing:-.2pt\"\u003e \u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003emínima\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003epara\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eparticipação\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eem\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ecorridas\r\nde rua é:\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-align:justify;\r\ntext-indent:-17.85pt;line-height:115%;mso-list:l0 level1 lfo2;tab-stops:60.85pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nline-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e* Provas com percurso até 5 km\r\n(cinco quilômetro): 14 (catorze) anos completos até 31 de dezembro do ano da\r\nprova;\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-align:justify;\r\ntext-indent:-17.85pt;line-height:115%;mso-list:l0 level1 lfo2;tab-stops:60.85pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nline-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e* Provas com percurso de 10 km\r\n(dez quilômetros): 16 (dezesseis) anos completos até 31 de dezembro do ano da\r\nprova.\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 56.35pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e6)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eINSCRIÇÃO \u003cspan style=\"letter-spacing:-.1pt\"\u003eINTRANSFERÍVEL\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\ninscrição da \u003c/span\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\r\n\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003e1ª Corrida Aliança pela\r\nVida\u003c/span\u003e\u003c/b\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e é\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eindividual\r\ne intransferível, não podendo qualquer pessoa ser substituída por outra, em\r\nqualquer situação.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eNão\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003eé\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003epermitida\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003ea\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003etroca\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003ede\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003edados\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003eda\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003einscrição.\r\nNão é permitida a troca para outro evento.\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eÉ\r\nterminantemente proibido ceder seu número de peito para outra \u003cspan style=\"letter-spacing:-.1pt\"\u003epessoa.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eO\r\nparticipante que ceder seu número de peito para outra pessoa será responsável\r\npor qualquer acidente ou dano que esta venha a\u003cspan style=\"letter-spacing:-.2pt\"\u003e\r\n\u003c/span\u003esofrer,\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003e\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\r\n\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003eisentando a organização\r\nda corrida, seus patrocinadores, apoiadores e orgãos públicos envolvidos de\r\nqualquer responsabilidade. Esse atleta será desclassificado.\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 56.35pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e7)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp; \u0026nbsp; \u0026nbsp;\u003cspan style=\"font-size: 14px;\"\u003e \u003c/span\u003e\u003c/span\u003e\u003cspan style=\"font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 14px; line-height: normal; font-family: \u0026quot;Times New Roman\u0026quot;;\"\u003eC\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u003cspan style=\"font-size: 14px;\"\u003eANAL DE \u003c/span\u003e\u003cspan style=\"letter-spacing: -0.1pt; font-size: 14px;\"\u003eINSCRIÇÃO\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eAs\r\ninscrições serão realizadas somente via internet através do site \u003c/span\u003e\u003cspan lang=\"PT\"\u003e\u003ca href=\"http://www.sympla.com.br/\" target=\"_blank\"\u003e\u003cspan style=\"font-size:10.0pt;\r\nline-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;color:windowtext\"\u003ewww.sympla.com.br\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e,\r\ncom inscrições abertas a partir das 17h00\u003cspan style=\"background-color: rgb(255, 255, 0);\"\u003e\u003cb\u003e(\u003c/b\u003e\u003c/span\u003ehorário de\r\nRondônia) do dia \u003c/span\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\r\n\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003e05/08/2026\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nline-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e.\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\ndistribuição das vagas poderá sofrer reajustes durante o período em que\r\nestiverem abertas as inscrições,\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003ede\r\nacordo com os critérios definidos\u003cspan style=\"letter-spacing:-.1pt\"\u003e \u003c/span\u003epela\r\n\u003cspan style=\"letter-spacing:-.1pt\"\u003eorganização.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\ncritério da organização\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003edo\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eevento,\u003cspan style=\"letter-spacing:-.2pt\"\u003e\r\n\u003c/span\u003ecaso\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ealguma\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003edeterminada\u003cspan style=\"letter-spacing:\r\n-.2pt\"\u003e \u003c/span\u003ecategoria não preencha o número total de vagas, estas poderão\r\nser remanejadas e alocadas para outras categorias.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eCada\r\natleta poderá se inscrever e participar somente de uma modalidade e sua\r\nrespectiva categoria.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eTodos\r\nos inscritos deverão aceitar os termos do “Termo de Responsabilidade de\r\nParticipação” que estará disponível no ato da inscrição.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eHavendo\r\ninconsistência de informações nos dados, o atleta será desclassificado\r\nautomaticamente.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\" style=\"margin: 0px 0px 0cm; line-height: normal;\"\u003e\u003cspan style=\"letter-spacing: 0px; font-size: 12px;\"\u003e7.1 - Para os percurso de 5k e 10k:\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\" style=\"margin: 0px 0px 0cm; line-height: normal;\"\u003e\u003cspan style=\"font-size: 12px;\"\u003e7.1.1 - O valor de inscrição: • Kit Simples: R$ 10\u003c/span\u003e\u003cspan style=\"font-size: 12px;\"\u003e\u003c/span\u003e\u003cspan style=\"font-size: 12px;\"\u003e0,00 e será disponibilizado em lotes promocionais com descontos regressivos, quanto mais cedo fizer a inscrição maior o desconto.\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 56.35pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e8)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDESISTÊNCIA\u003cspan style=\"letter-spacing:-.15pt\"\u003e\r\n\u003c/span\u003eE\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eREEMBOLSO\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eDO\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eVALOR\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eDA\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003e\u003cspan style=\"letter-spacing:-.1pt\"\u003eINSCRIÇÃO\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eEm\r\nconformidade com o Código de Defesa do Consumidor, o\u003cspan style=\"letter-spacing:\r\n-.2pt\"\u003e \u003c/span\u003eatleta\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003etem o prazo de\r\n7 (sete) dias corridos após a data da compra para solicitar o cancelamento\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ee\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eo\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eestorno\u003cspan style=\"letter-spacing:-.2pt\"\u003e\r\n\u003c/span\u003edo\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003evalor\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eda\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003einscrição.\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eApós\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eesse\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eperíodo,\u003cspan style=\"letter-spacing:-.2pt\"\u003e\r\n\u003c/span\u003enão\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ehaverá devolução do valor\r\npago.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\"\u003e\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\nsolicitação deverá ser feita pelos canais de atendimento da organização\r\n(e-mail, redes sociais ou telefone). As informações de contato serão amplamente\r\ndivulgadas no site oficial do evento: \u003c/span\u003e\u003cspan lang=\"PT\"\u003e\u003ca href=\"http://www.podiumsport.com.br/\" target=\"_blank\"                        rel=\"nofollow noopener noreferrer\"\u003e\u003cspan style=\"font-size: 10pt; line-height: 115%; font-family: Calibri, sans-serif; color: windowtext; letter-spacing: -0.1pt;\"\u003ewww.podiumsport.com.br\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l0 level1 lfo1;tab-stops:list 18.0pt left 56.35pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e9)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u0026nbsp;ENCERRAMENTO DAS INSCRIÇÕES\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\r\n\r\n\u003cp class=\"MsoNormal\" style=\"text-align:justify;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eAs\r\ninscrições \u003cb\u003eserão encerradas no dia 04/10/2026\u003c/b\u003e,\r\npodendo o prazo ser prorrogado devido à disponibilidade de vagas. \u003cb\u003eCaso atingido o limite máximo de inscritos,\r\nas inscrições serão encerradas imediatamente.\u003c/b\u003e\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l0 level1 lfo1;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e10)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eSOBRE\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003eALTERAÇÕES\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eGERAIS\u003cspan style=\"letter-spacing:-.25pt\"\u003e\r\n\u003c/span\u003eEM\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003e\u003cspan style=\"letter-spacing:\r\n-.1pt\"\u003eINSCRIÇÕES\u003c/span\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\norganização poderá, a qualquer momento, suspender ou prorrogar prazos, aumentar\r\nou limitar o número de inscrições, em função de necessidades, disponibilidade\r\ntécnica e/ou questões estruturais e de segurança, sem aviso prévio.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l0 level1 lfo1;tab-stops:list 18.0pt left 62.35pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e11)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eVERACIDADE DAS \u003cspan style=\"letter-spacing:\r\n-.1pt\"\u003eINFORMAÇÕES\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cu style=\"font-family: \u0026quot;Open Sans\u0026quot;, Roboto, \u0026quot;Helvetica Neue\u0026quot;, Helvetica, Arial, sans-serif; font-size: 14px; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/u\u003e\u003c/h1\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cu\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eOs\r\nparticipantes são responsáveis pela veracidade das informações\u003c/span\u003e\u003c/u\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\r\n\u003cu\u003efornecidas na ficha de\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003einscrição.\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eCaso\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ehaja\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003efraude\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ecomprovada,\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eo(a)\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eatleta\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eserá\u003c/u\u003e \u003cu\u003edesclassificado(a) da corrida,\r\nressalvado o direito da organização para\u003c/u\u003e \u003cu\u003eeventuais processos de\r\nresponsabilização.\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u003cu\u003e\u003cbr\u003e\u003c/u\u003e\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoNormal\" style=\"margin-bottom:8.0pt;line-height:115%;mso-pagination:\r\nwidow-orphan;text-autospace:ideograph-numeric ideograph-other\"\u003e\u003cu\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003c/span\u003e\u003c/u\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eSOBRE A\u003cspan style=\"letter-spacing:\r\n3.3pt\"\u003e \u003c/span\u003eENTREGA DE \u003cspan style=\"letter-spacing:-.2pt\"\u003eKITS\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\r\n\r\n\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l0 level1 lfo1;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e12)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eRETIRADA DO KIT ATLETA\u003c/span\u003e\u003c/b\u003e\u003cb style=\"font-family: \u0026quot;Open Sans\u0026quot;, Roboto, \u0026quot;Helvetica Neue\u0026quot;, Helvetica, Arial, sans-serif; font-size: 14px; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\r\n\r\n\u003cp class=\"MsoNormal\" style=\"text-align:justify;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eSerá\r\n\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:11.0pt;\r\nline-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003einformado\r\nposteriormente o dia, local e horario da retirada do kit atleta\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e.\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eO\r\nkit deverá ser retirado pelo(a) atleta inscrito mediante a apresentação de um\r\ndocumento de identificação com foto.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\nretirada de kit por terceiros, excepcionalmente, poderá\u003cspan style=\"letter-spacing:\r\n-.2pt\"\u003e \u003c/span\u003eser\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eautorizada, desde\r\nque este apresente 1 (um) documento oficial com foto do atleta\u003cspan style=\"letter-spacing:-.1pt\"\u003e \u003c/span\u003e\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:\r\n10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;\r\nmso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003ee 1 (um) documento oficial com foto do\r\nretirante.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoNormal\" style=\"text-align:justify;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eO(a)\r\natleta que \u003cb\u003enão \u003c/b\u003eretirar o seu kit na\r\ndata e horário estipulados pela organização \u003cb\u003eficará impedido de participar da corrida e\u003cspan style=\"letter-spacing:\r\n-.15pt\"\u003e \u003c/span\u003eperderá\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eo\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003edireito\u003cspan style=\"letter-spacing:-.15pt\"\u003e\r\n\u003c/span\u003eao kit atleta.\u003c/b\u003e\u003c/span\u003e\u003cb style=\"letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nline-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cb\u003e\u003cspan style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;\r\nbackground:yellow;mso-highlight:yellow;mso-ansi-language:PT-BR\"\u003eRegras e\r\nComprovação para retirada do kit para:\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:36.0pt;line-height:115%\"\u003e\u003cspan style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;\r\nbackground:yellow;mso-highlight:yellow;mso-ansi-language:PT-BR\"\u003e\u003co:p\u003e\u0026nbsp;\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:36.0pt;line-height:115%\"\u003e\u003cb\u003e\u003cspan style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;\r\nbackground:yellow;mso-highlight:yellow;mso-ansi-language:PT-BR\"\u003ePCD:\u003c/span\u003e\u003c/b\u003e\u003cspan style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;\r\nbackground:yellow;mso-highlight:yellow;mso-ansi-language:PT-BR\"\u003e a retirada do\r\nkit do atleta PcD deve ser feita exclusivamente pelo próprio titular, mediante\r\napresentação de documento oficial com foto e comprovação da deficiência (laudo\r\nmédico com CID).\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:36.0pt;line-height:115%\"\u003e\u003cspan style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;\r\nbackground:yellow;mso-highlight:yellow;mso-ansi-language:PT-BR\"\u003e\u003co:p\u003e\u0026nbsp;\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:36.0pt;line-height:115%\"\u003e\u003cb\u003e\u003cspan style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;\r\nbackground:yellow;mso-highlight:yellow;mso-ansi-language:PT-BR\"\u003ePara\r\nEstudantes:\u003c/span\u003e\u003c/b\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Arial\u0026quot;,sans-serif;background:yellow;mso-highlight:yellow\"\u003e a\r\nretirada do kit atleta ESTUDANTE deve ser feita exclusivamente pelo atleta, é\r\nobrigatória a apresentação da Carteira de Identificação Estudantil (CIE) válida\r\nno ato da retirada do kit de corrida.\u003c/span\u003e\u003cb\u003e\u003cspan style=\"font-size:10.0pt;\r\nline-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;background:yellow;mso-highlight:\r\nyellow;mso-ansi-language:PT-BR\"\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:36.0pt;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;\r\nbackground:yellow;mso-highlight:yellow\"\u003e\u003co:p\u003e\u0026nbsp;\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:36.0pt;line-height:115%\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;\r\nbackground:yellow;mso-highlight:yellow\"\u003eIDOSOS: \u003c/span\u003e\u003c/b\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Arial\u0026quot;,sans-serif;\r\nbackground:yellow;mso-highlight:yellow\"\u003ea retirada do kit atleta IDOSO deve ser\r\nfeita exclusivamente pelo atleta, é obrigatória a apresentação de documento com\r\nfoto no ato da retirada do kit de corrida.\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eAs\r\ndatas e horários para retirada serão amplamente divulgados em canais de\r\ncomunicação do evento, especialmente no site oficial \u003c/span\u003e\u003cspan lang=\"PT\"\u003e\u003ca href=\"http://www.sympla.com.br/\" target=\"_blank\"\u003e\u003cspan style=\"font-size:10.0pt;line-height:\r\n115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;color:windowtext\"\u003ewww.sympla.com.br\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e,\u003cspan style=\"letter-spacing:4.0pt\"\u003e \u003c/span\u003e\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:\r\n10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;\r\nmso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003ee nas redes sociais e site da REDE HOSPITALAR\r\nSAMAR.\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l0 level1 lfo1;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e13)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eNÃO RETIRADA DO \u003cspan style=\"letter-spacing:\r\n-.25pt\"\u003eKIT\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cu\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eNão\r\nserão\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eentregues\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ekits\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eapós\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eo\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eperíodo\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eda\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eretirada\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ede\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ekits,\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003edeterminado\u003c/span\u003e\u003c/u\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e \u003cu\u003epreviamente\r\npela organização.\u003c/u\u003e Os kits que não forem retirados não serão enviados aos\r\ncorredores, sob nenhum motivo ou circunstância.\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l0 level1 lfo1;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e14)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eSOBRE O KIT\u003c/span\u003e\u003c/b\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/h1\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eO\r\nkit da \u003cb\u003e1ª \u003c/b\u003e\u003c/span\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;font-family:\r\n\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003eCorrida Aliança pela Vida\u003c/span\u003e\u003c/b\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\r\nserá composto por:\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-top:2.0pt;margin-right:0cm;margin-bottom:\r\n12.0pt;margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nline-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u0026nbsp;-\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003cb\u003eCamiseta\r\nmanga curta, sacochila, número de peito e medalha.\u003c/b\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eO(a)\r\natleta poderá escolher o tamanho da camiseta no momento da inscrição.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eRecomendamos\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003eo\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003euso\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003eda\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003ecamiseta\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003edo\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003eevento\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003epara\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003eos(as)\u003cspan style=\"letter-spacing:2.0pt\"\u003e \u003c/span\u003eatletas\u003cspan style=\"letter-spacing:2.0pt\"\u003e\r\n\u003c/span\u003eno momento da composição do pódio.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\r\n\r\n\u003cp class=\"MsoBodyText\" align=\"left\" style=\"margin-left: 0cm; line-height: 115%;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA medalha\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eserá\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eentregue\u003cspan style=\"letter-spacing:-.2pt\"\u003e\r\n\u003c/span\u003e\u003cb\u003eapenas\u003cspan style=\"letter-spacing:\r\n-.2pt\"\u003e \u003c/span\u003e\u003c/b\u003epara\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eos(as)\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eatletas\u003cspan style=\"letter-spacing:-.2pt\"\u003e\r\n\u003c/span\u003eque\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ecompletarem\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ea prova e que estiverem com o número de\r\npeito e chip do evento.\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e15)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eNÚMERO DE PEITO\u003c/span\u003e\u003c/b\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/h1\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\ncada competidor(a) será fornecido um número de peito com chip,\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eque deve, obrigatoriamente, ser usado\r\nvisivelmente no peito, sem rasuras ou alterações, durante toda a realização da\r\ncorrida, sendo passíveis de desclassificação os(as) participantes que não\r\ncumprirem essa regra.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eAtletas\r\nsem número de peito poderão ser retirados pela organização do evento de espaços\r\nreservados exclusivamente aos corredores.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e16)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eCONFERÊNCIA DO KIT\u003c/span\u003e\u003c/b\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/h1\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eÉ\r\nobrigatória a conferência de todos os itens que compõem o kit no momento da\r\nretirada. Em caso de item faltante, deverá ser informado de imediato ao(a)\r\nfuncionário(a) da organização presente no local da retirada dos kits. O item\r\nfaltante será entregue de imediato, conforme disponibilidade.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eNão\r\nserão aceitas reclamações ou alegações de itens faltantes após o momento da\r\nretirada do kit.\u003c/span\u003e\u003c/p\u003e\u003ch1 align=\"center\" style=\"margin:0cm;text-align:center\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:11.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003ePARTICIPAÇÃO\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e17)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eHORÁRIO\u003c/span\u003e\u003c/b\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; text-align: justify; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/h1\u003e\u003cp class=\"MsoNormal\" style=\"text-align:justify;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eOs(as)\r\natletas deverão \u003cb\u003echegar ao local de\r\nlargada com no mínimo meia hora (17h30) de antecedência do horário oficial\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ede\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003elargada\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003e(18h00)\u003c/b\u003e, momento quando serão dadas as\r\ninstruções finais aos(as) corredores(as).\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e18)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eNÚMERO DE PEITO\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eÉ\r\nobrigatório o uso do número do(a) atleta\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eno\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003epeito,\u003cspan style=\"letter-spacing:-.15pt\"\u003e\r\n\u003c/span\u003esendo\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eque\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003equalquer avaria do número implicará em\r\nsua desclassificação.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eÉ\r\nexpressamente proibida qualquer adulteração, produção de réplica\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eou uso inadequado do número de peito. Caso\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003ehaja\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003efraude\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003ecomprovada,\u003cspan style=\"letter-spacing:\r\n-.15pt\"\u003e \u003c/span\u003eo(a)\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003eatleta será\r\ndesclassificado da corrida e poderá responder por crime de falsidade ideológica\r\ne/ou documental.\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e19)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003ePARTICIPAÇÃO INDIVIDUAL\u003c/span\u003e\u003c/b\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/h1\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\nparticipação do(a) atleta na corrida é estritamente individual sendo proibido o\r\nauxílio de terceiros e equipamentos que ofereçam vantagem competitiva (tais\r\ncomo, bicicletas, patinetes, skates e similares), ressalvado o auxílio de\r\natleta guia para participantes que sejam pessoas com deficiência \u003cspan style=\"letter-spacing:-.1pt\"\u003e(PCD).\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-fareast-font-family:\r\nCalibri\"\u003e20)\u003cspan style=\"font:7.0pt \u0026quot;Times New Roman\u0026quot;\"\u003e\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u0026nbsp;PREMIAÇÃO\u003c/span\u003e\u003c/b\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/h1\u003e\u003cp class=\"MsoBodyText\" style=\"margin-left:0cm;line-height:115%\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eA\r\npremiação da \u003cb\u003e1ª \u003c/b\u003e\u003c/span\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:12.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\u0026quot;Arial MT\u0026quot;\"\u003eCorrida Aliança\r\npela Vida\u003c/span\u003e\u003c/b\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e será distribuída da seguinte forma:\u003c/span\u003e\u003cb style=\"text-align: right; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/b\u003e\u003c/p\u003e\u003ch1 style=\"margin-top:0cm;margin-right:0cm;margin-bottom:0cm;margin-left:14.2pt;\r\ntab-stops:list 18.0pt left 43.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif;letter-spacing:-.1pt\"\u003e\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;\u003cspan style=\"font-size: 18px;\"\u003ePara o percurso de 5\r\nKM e 10 KM:\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb style=\"font-family: \u0026quot;Open Sans\u0026quot;, Roboto, \u0026quot;Helvetica Neue\u0026quot;, Helvetica, Arial, sans-serif; text-align: right; font-size: 14px; letter-spacing: 0px;\"\u003e\u003cspan lang=\"PT\" style=\"font-size: 18px; font-family: Calibri, sans-serif;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;text-align:justify;text-indent:\r\n-17.85pt;line-height:115%;mso-list:l1 level1 lfo1;tab-stops:79.05pt\"\u003e\u0026lt;!\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;*\u0026nbsp;\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nline-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eCategoria \u003cb\u003ePÚBLICO GERAL \u003c/b\u003e- Feminino e Masculino:\r\nTroféus do 1º ao 5° Lugar;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;text-align:justify;line-height:\r\n115%;tab-stops:79.05pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;mso-bidi-font-size:\r\n11.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;mso-bidi-font-family:\r\n\u0026quot;Arial MT\u0026quot;\"\u003e\u0026nbsp; \u0026nbsp; \u0026nbsp; *\u0026nbsp;\u003cb\u003eCATEGORIA IDADE\u003c/b\u003e: troféus para\r\nas seguintes IDADES\u0026nbsp; no \u003cb\u003e05 km e 10 km\u003c/b\u003e Feminino e Masculino\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e,\r\npremiando por ordem de chegada nas seguintes idades:\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-indent:-17.85pt;\r\nmso-list:l0 level1 lfo2;tab-stops:115.05pt\"\u003e\u003cspan lang=\"PT\" style=\"\"\u003e\u0026nbsp;**\u0026nbsp;\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eAté\u003cspan style=\"letter-spacing:-.1pt\"\u003e \u003c/span\u003e35\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eanos:\u003cspan style=\"letter-spacing:-.05pt\"\u003e\r\n\u003c/span\u003eTroféus\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003edo\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e1º\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eao\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e3°\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e\u003cspan style=\"letter-spacing:-.1pt\"\u003eLugar;\u003c/span\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-indent:-17.85pt;\r\nmso-list:l0 level1 lfo2;tab-stops:115.05pt\"\u003e\u003cspan lang=\"PT\" style=\"\"\u003e**\u0026nbsp;\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDe\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e36\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003ea\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e45\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eanos:\u003cspan style=\"letter-spacing:-.05pt\"\u003e\r\n\u003c/span\u003eTroféus\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003edo\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e1º\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eao\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e3° \u003cspan style=\"letter-spacing:-.1pt\"\u003eLugar;\u003c/span\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-indent:-17.85pt;\r\nmso-list:l0 level1 lfo2;tab-stops:115.05pt\"\u003e\u003cspan lang=\"PT\" style=\"\"\u003e**\u0026nbsp;\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDe\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e46\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003ea\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e55\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eanos:\u003cspan style=\"letter-spacing:-.05pt\"\u003e\r\n\u003c/span\u003eTroféus\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003edo\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e1º\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eao\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e3° \u003cspan style=\"letter-spacing:-.1pt\"\u003eLugar;\u003c/span\u003e\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:32.05pt;text-indent:-17.85pt;\r\nmso-list:l0 level1 lfo2;tab-stops:115.05pt\"\u003e\u003cspan lang=\"PT\" style=\"\"\u003e**\u0026nbsp;\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eMaior\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003ede\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e56\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eanos:\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003eTroféus\u003cspan style=\"letter-spacing:-.05pt\"\u003e\r\n\u003c/span\u003edo\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e1º\u003cspan style=\"letter-spacing:\r\n-.05pt\"\u003e \u003c/span\u003eao\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e3°\u003cspan style=\"letter-spacing:-.05pt\"\u003e \u003c/span\u003e\u003cspan style=\"letter-spacing:-.1pt\"\u003eLugar.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoNormal\"\u003e\u003cspan lang=\"PT\" style=\"font-size:\r\n10.0pt;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e*\u0026nbsp;\u0026nbsp;\u003cb\u003e\u003cspan style=\"font-size: 14px;\"\u003eCategoria COLABORADOR\u003c/span\u003e\u003c/b\u003e:\r\nDistância de \u003cb\u003e05 km\u003c/b\u003e Feminino e Masculino: Troféus do 1º ao 5° Lugar.\u003c/span\u003e\u003c/p\u003e\u003ch1 style=\"margin:0cm;text-indent:0cm;mso-list:l2 level1 lfo3;tab-stops:list 18.0pt left 63.05pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"\"\u003e\u003cfont face=\"Calibri, sans-serif\"\u003e\u003cspan style=\"font-size: 10pt;\"\u003e21)\u003c/span\u003e\u003c/font\u003e\u003cspan style=\"font: 7pt \u0026quot;Times New Roman\u0026quot;;\"\u003e\u0026nbsp; \u0026nbsp; \u0026nbsp; \u003c/span\u003e\u003cspan style=\"font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-weight: normal; font-stretch: normal; line-height: normal;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eDIRETRIZES GERAIS\u003c/span\u003e\u003c/b\u003e\u003c/h1\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;tab-stops:55.6pt\"\u003e\u003cb\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eNÃO haverá premiação em \u003cspan style=\"letter-spacing:-.1pt\"\u003edinheiro.\u003c/span\u003e\u003c/span\u003e\u003c/b\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; text-align: justify; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;text-align:justify;line-height:\r\n115%;tab-stops:58.6pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eTodos os participantes da \u003cb\u003eCAMINHADA \u003c/b\u003ee da \u003cb\u003eCORRIDINHA KIDS \u003c/b\u003ereceberão medalhas de participação. Não haverá\r\npremiação de troféus para participantes destas categorias.\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;text-align:justify;line-height:\r\n115%;tab-stops:56.35pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eTodos os(as) atletas que cruzarem a\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003elinha\u003cspan style=\"letter-spacing:-.25pt\"\u003e\r\n\u003c/span\u003ede\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003echegada\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003ede\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003eforma\u003cspan style=\"letter-spacing:-.25pt\"\u003e \u003c/span\u003elegal, regularmente inscritos e sem o\r\ndescumprimento deste regulamento,\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003ereceberão\r\nmedalhas. Não serão entregues medalhas para as pessoas que, mesmo inscritas,\r\nnão participaram da corrida.\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;text-align:justify;line-height:\r\n115%;tab-stops:57.85pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eAs\u003cspan style=\"letter-spacing:-.15pt\"\u003e \u003c/span\u003e5\r\n(cinco) primeiras colocações de categorias GERAL Feminina e Masculina das\r\ndistâncias de 5 km (cinco quilômetros) e 10 km (dez quilômetros) serão\r\ndefinidas por ordem de \u003cspan style=\"letter-spacing:-.1pt\"\u003echegada.\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"font-family: Calibri, sans-serif; font-size: 10pt; letter-spacing: 0px;\"\u003e\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;text-align:justify;line-height:\r\n115%;tab-stops:57.85pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eOs(as) atletas que fizerem jus à premiação\r\ndeverão comparecer ao pódio, assim que a cerimônia de premiação for iniciada e\r\na sua categoria for chamada. O(a) atleta que não comparecer ao pódio durante a\r\ncerimônia de premiação, perderá o direito aos prêmios, conforme determinação da\r\norganização da corrida e serão chamados os próximos pela ordem de \u003cspan style=\"letter-spacing:-.1pt\"\u003eclassificação.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;text-align:justify;line-height:\r\n115%;tab-stops:57.85pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003eOs resultados oficiais da corrida serão\r\ninformados por meio do site oficial do evento \u003c/span\u003e\u003cspan lang=\"PT\"\u003e\u003ca href=\"http://www.podiumsport.com.br/\" target=\"_blank\"                        rel=\"nofollow noopener noreferrer\"\u003e\u003cspan style=\"font-size:10.0pt;line-height:\r\n115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif;color:windowtext\"\u003ewww.podiumsport.com.br\u003c/span\u003e\u003c/a\u003e\u003c/span\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e,\r\nno prazo de 24 horas após o\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003etérmino\u003cspan style=\"letter-spacing:-.2pt\"\u003e \u003c/span\u003eda \u003cspan style=\"letter-spacing:-.1pt\"\u003ecorrida.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;text-align:justify;line-height:\r\n115%;tab-stops:57.85pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u003cspan style=\"letter-spacing:-.1pt\"\u003e\u003co:p\u003e\u003cbr\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoListParagraph\" style=\"margin-left:0cm;text-align:justify;line-height:\r\n115%;tab-stops:57.85pt\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;font-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\u003cspan style=\"letter-spacing:-.1pt\"\u003e\u003co:p\u003e\u003cbr\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\u003cp class=\"MsoBodyText\" align=\"left\" style=\"margin-left: 0cm; line-height: 115%;\"\u003e\u003cspan lang=\"PT\" style=\"font-size:10.0pt;line-height:115%;\r\nfont-family:\u0026quot;Calibri\u0026quot;,sans-serif\"\u003e\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u003c/span\u003e\u003c/p\u003e","lang":"PT"},"en":{"hasInfo":false,"text":null,"lang":"EN"},"es":{"hasInfo":false,"text":null,"lang":"ES"},"default":"PT"},"strippedDetail":"REGULAMENTO CORRIDA SAMAR\u0026nbsp;DESCRITIVO\r\nGERAL1)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; SOBRE A CORRIDADATA DA CORRIDA:\r\n31/10/2026LOCAL DA LARGADA: ESPAÇO ALTERNATIVOHORÁRIO PREVISTO DE LARGADA:\r\n17h30 concentração e 18h00 largada, observando sempre o horário local de Porto Velho - RO.2)\u0026nbsp;CONDIÇÕES CLIMÁTICASA\r\nlargada da corrida será realizada no sábado, 31 de outubro de 2026, sob\r\nqualquer condição climática, desde que não coloque em risco a integridade\r\nfísica dos participantes.3)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;PERCURSOA\r\ncorrida será disputada nas distâncias de 5km (cinco quilômetros) e 10km (dez\r\nquilômetros), terá a duração máxima de 2h (duas horas), com percurso aferido\r\npor medidor credenciado junto à Confederação Brasileira de Atletismo (“CBAT”),\r\nque será amplamente divulgado na página da corrida e nas redes sociais da\r\norganização do evento.4)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; CATEGORIAS E DISTÂNCIASA 1ª\r\nCorrida Aliança pela Vida\r\nserá disputada, exclusivamente, nas categorias:* CAMINHADA e \u0026nbsp;CORRIDINHA KIDS;* CORRIDA 5 KM e CORRIDA 10 KM:\u0026nbsp;\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;-\u0026nbsp;\u0026nbsp;\r\nPÚBLICO GERAL e COLABORADOR(05 KM), FEMININO e MASCULINO\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;A Categoria\r\nCAMINHADA é destinada aos atletas que buscam participar do evento de maneira moderada,\r\nmantendo o espírito competitivo. Os participantes poderão escolher livremente o\r\nmomento de seu retorno para a linha de chegada, desde que o percurso se\r\nmantenha dentro do trajeto delimitado para os\r\n05 km (cinco quilômetros) e respeitando o\r\ntempo máximo de duração do evento, possibilitando a integração de participantes\r\ncom diferentes níveis de preparo físico.Com\r\no objetivo de incentivar a participação das crianças nas práticas esportivas e\r\npromover integração social, a categoria CORRIDINHA\r\nKIDS consistirá na participação de crianças na faixa etária de até 13 anos.\r\nA corridinha consistirá nas seguintes distâncias:\u0026nbsp;*\u0026nbsp;Até 5 anos: 50 m (cinquenta metros)*\u0026nbsp;De 06 a 07 anos: 100 m (cem metros)*\u0026nbsp;De 08 a 09 anos: 150 m (cento e cinquenta metros)*\u0026nbsp;De 10 a 11 anos:\r\n200 m (duzentos metros)*\u0026nbsp;De 12 a 13 anos: 300 m (trezentos metros)5)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; IDADE MÍNIMA\u0026nbsp;Os(as)\r\natletas menores de 18 anos só poderão participar da corrida com autorização por escrito do pai ou da\r\nmãe ou de responsável legal.A\r\nautorização deverá ser entregue à Comissão Organizadora no ato da entrega do\r\nkit do atleta, sendo necessária a presença do responsável autorizante e a\r\napresentação do mesmo documento de identificação inserido no termo que autoriza a participação do\r\nmenor.\u0026nbsp;A\r\nautorização deverá estar acompanhada de cópia de um documento\r\nde\r\nidentidade que será retido pela organização no momento da retirada do kit,\r\nconforme modelo inserido no regulamento, observando ainda o disposto no Art. 14, § 1º, da Lei Geral de\r\nProteção de Dados (Lei N. 13.709/2018)Em cumprimento às Regras\r\nOficiais da Associação Internacional de Federações de Atletismo (“World\r\nAThletics”), a idade mínima para participação em corridas\r\nde rua é:* Provas com percurso até 5 km\r\n(cinco quilômetro): 14 (catorze) anos completos até 31 de dezembro do ano da\r\nprova;* Provas com percurso de 10 km\r\n(dez quilômetros): 16 (dezesseis) anos completos até 31 de dezembro do ano da\r\nprova.6)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nINSCRIÇÃO INTRANSFERÍVELA\r\ninscrição da 1ª Corrida Aliança pela\r\nVida é individual\r\ne intransferível, não podendo qualquer pessoa ser substituída por outra, em\r\nqualquer situação.Não é permitida a troca de dados da inscrição.\r\nNão é permitida a troca para outro evento.É\r\nterminantemente proibido ceder seu número de peito para outra pessoa.O\r\nparticipante que ceder seu número de peito para outra pessoa será responsável\r\npor qualquer acidente ou dano que esta venha a\r\nsofrer, isentando a organização\r\nda corrida, seus patrocinadores, apoiadores e orgãos públicos envolvidos de\r\nqualquer responsabilidade. Esse atleta será desclassificado.7)\u0026nbsp; \u0026nbsp; \u0026nbsp; CANAL DE INSCRIÇÃOAs\r\ninscrições serão realizadas somente via internet através do site www.sympla.com.br,\r\ncom inscrições abertas a partir das 17h00(horário de\r\nRondônia) do dia 05/08/2026.A\r\ndistribuição das vagas poderá sofrer reajustes durante o período em que\r\nestiverem abertas as inscrições, de\r\nacordo com os critérios definidos pela\r\norganização.A\r\ncritério da organização do evento,\r\ncaso alguma determinada categoria não preencha o número total de vagas, estas poderão\r\nser remanejadas e alocadas para outras categorias.Cada\r\natleta poderá se inscrever e participar somente de uma modalidade e sua\r\nrespectiva categoria.Todos\r\nos inscritos deverão aceitar os termos do “Termo de Responsabilidade de\r\nParticipação” que estará disponível no ato da inscrição.Havendo\r\ninconsistência de informações nos dados, o atleta será desclassificado\r\nautomaticamente.7.1 - Para os percurso de 5k e 10k:\u0026nbsp;7.1.1 - O valor de inscrição: • Kit Simples: R$ 100,00 e será disponibilizado em lotes promocionais com descontos regressivos, quanto mais cedo fizer a inscrição maior o desconto.8)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nDESISTÊNCIA\r\nE REEMBOLSO DO VALOR DA INSCRIÇÃOEm\r\nconformidade com o Código de Defesa do Consumidor, o atleta tem o prazo de\r\n7 (sete) dias corridos após a data da compra para solicitar o cancelamento e o estorno\r\ndo valor da inscrição. Após esse período,\r\nnão haverá devolução do valor\r\npago.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nA\r\nsolicitação deverá ser feita pelos canais de atendimento da organização\r\n(e-mail, redes sociais ou telefone). As informações de contato serão amplamente\r\ndivulgadas no site oficial do evento: www.podiumsport.com.br9)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u0026nbsp;ENCERRAMENTO DAS INSCRIÇÕES\r\n\r\nAs\r\ninscrições serão encerradas no dia 04/10/2026,\r\npodendo o prazo ser prorrogado devido à disponibilidade de vagas. Caso atingido o limite máximo de inscritos,\r\nas inscrições serão encerradas imediatamente.\r\n\r\n10)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nSOBRE ALTERAÇÕES GERAIS\r\nEM INSCRIÇÕES\r\n\r\nA\r\norganização poderá, a qualquer momento, suspender ou prorrogar prazos, aumentar\r\nou limitar o número de inscrições, em função de necessidades, disponibilidade\r\ntécnica e/ou questões estruturais e de segurança, sem aviso prévio.\u0026nbsp;\r\n\r\n11)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nVERACIDADE DAS INFORMAÇÕES\u0026nbsp;\r\n\r\nOs\r\nparticipantes são responsáveis pela veracidade das informações\r\nfornecidas na ficha de inscrição. Caso haja fraude comprovada, o(a) atleta será desclassificado(a) da corrida,\r\nressalvado o direito da organização para eventuais processos de\r\nresponsabilização.\r\n\r\n\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; SOBRE A ENTREGA DE KITS\r\n\r\n12)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nRETIRADA DO KIT ATLETA\u0026nbsp;\r\n\r\nSerá\r\ninformado\r\nposteriormente o dia, local e horario da retirada do kit atleta.\r\n\r\nO\r\nkit deverá ser retirado pelo(a) atleta inscrito mediante a apresentação de um\r\ndocumento de identificação com foto.\u0026nbsp;\r\n\r\nA\r\nretirada de kit por terceiros, excepcionalmente, poderá ser autorizada, desde\r\nque este apresente 1 (um) documento oficial com foto do atleta e 1 (um) documento oficial com foto do\r\nretirante.\u0026nbsp;\r\n\r\nO(a)\r\natleta que não retirar o seu kit na\r\ndata e horário estipulados pela organização ficará impedido de participar da corrida e perderá o direito\r\nao kit atleta.\u0026nbsp;\r\n\r\nRegras e\r\nComprovação para retirada do kit para:\r\n\r\n\u0026nbsp;\r\n\r\nPCD: a retirada do\r\nkit do atleta PcD deve ser feita exclusivamente pelo próprio titular, mediante\r\napresentação de documento oficial com foto e comprovação da deficiência (laudo\r\nmédico com CID).\r\n\r\n\u0026nbsp;\r\n\r\nPara\r\nEstudantes: a\r\nretirada do kit atleta ESTUDANTE deve ser feita exclusivamente pelo atleta, é\r\nobrigatória a apresentação da Carteira de Identificação Estudantil (CIE) válida\r\nno ato da retirada do kit de corrida.\r\n\r\n\u0026nbsp;\r\n\r\nIDOSOS: a retirada do kit atleta IDOSO deve ser\r\nfeita exclusivamente pelo atleta, é obrigatória a apresentação de documento com\r\nfoto no ato da retirada do kit de corrida.\r\n\r\nAs\r\ndatas e horários para retirada serão amplamente divulgados em canais de\r\ncomunicação do evento, especialmente no site oficial www.sympla.com.br, e nas redes sociais e site da REDE HOSPITALAR\r\nSAMAR.\r\n\r\n13)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nNÃO RETIRADA DO KIT\r\n\r\nNão\r\nserão entregues kits após o período da retirada de kits, determinado previamente\r\npela organização. Os kits que não forem retirados não serão enviados aos\r\ncorredores, sob nenhum motivo ou circunstância.\r\n\r\n14)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nSOBRE O KIT\u0026nbsp;\r\n\r\nO\r\nkit da 1ª Corrida Aliança pela Vida\r\nserá composto por:\r\n\r\n\u0026nbsp;-\u0026nbsp;\u0026nbsp;\u0026nbsp; Camiseta\r\nmanga curta, sacochila, número de peito e medalha.\r\n\r\nO(a)\r\natleta poderá escolher o tamanho da camiseta no momento da inscrição.\u0026nbsp;\r\n\r\nRecomendamos o uso da camiseta do evento para os(as) atletas\r\nno momento da composição do pódio.\u0026nbsp;\r\n\r\nA medalha será entregue\r\napenas para os(as) atletas\r\nque completarem a prova e que estiverem com o número de\r\npeito e chip do evento.15)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nNÚMERO DE PEITO\u0026nbsp;A\r\ncada competidor(a) será fornecido um número de peito com chip, que deve, obrigatoriamente, ser usado\r\nvisivelmente no peito, sem rasuras ou alterações, durante toda a realização da\r\ncorrida, sendo passíveis de desclassificação os(as) participantes que não\r\ncumprirem essa regra.Atletas\r\nsem número de peito poderão ser retirados pela organização do evento de espaços\r\nreservados exclusivamente aos corredores.\u0026nbsp;16)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nCONFERÊNCIA DO KIT\u0026nbsp;É\r\nobrigatória a conferência de todos os itens que compõem o kit no momento da\r\nretirada. Em caso de item faltante, deverá ser informado de imediato ao(a)\r\nfuncionário(a) da organização presente no local da retirada dos kits. O item\r\nfaltante será entregue de imediato, conforme disponibilidade.\u0026nbsp;Não\r\nserão aceitas reclamações ou alegações de itens faltantes após o momento da\r\nretirada do kit.PARTICIPAÇÃO17)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nHORÁRIO\u0026nbsp;Os(as)\r\natletas deverão chegar ao local de\r\nlargada com no mínimo meia hora (17h30) de antecedência do horário oficial de largada (18h00), momento quando serão dadas as\r\ninstruções finais aos(as) corredores(as).18)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nNÚMERO DE PEITOÉ\r\nobrigatório o uso do número do(a) atleta no peito,\r\nsendo que qualquer avaria do número implicará em\r\nsua desclassificação.\u0026nbsp;É\r\nexpressamente proibida qualquer adulteração, produção de réplica ou uso inadequado do número de peito. Caso haja fraude comprovada, o(a) atleta será\r\ndesclassificado da corrida e poderá responder por crime de falsidade ideológica\r\ne/ou documental.19)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\nPARTICIPAÇÃO INDIVIDUAL\u0026nbsp;A\r\nparticipação do(a) atleta na corrida é estritamente individual sendo proibido o\r\nauxílio de terceiros e equipamentos que ofereçam vantagem competitiva (tais\r\ncomo, bicicletas, patinetes, skates e similares), ressalvado o auxílio de\r\natleta guia para participantes que sejam pessoas com deficiência (PCD).20)\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\r\n\u0026nbsp;PREMIAÇÃO\u0026nbsp;A\r\npremiação da 1ª Corrida Aliança\r\npela Vida será distribuída da seguinte forma:\u0026nbsp;\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;Para o percurso de 5\r\nKM e 10 KM:\u0026nbsp;\u0026lt;!\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;*\u0026nbsp;Categoria PÚBLICO GERAL - Feminino e Masculino:\r\nTroféus do 1º ao 5° Lugar;\u0026nbsp; \u0026nbsp; \u0026nbsp; *\u0026nbsp;CATEGORIA IDADE: troféus para\r\nas seguintes IDADES\u0026nbsp; no 05 km e 10 km Feminino e Masculino,\r\npremiando por ordem de chegada nas seguintes idades:\u0026nbsp;**\u0026nbsp;Até 35 anos:\r\nTroféus do 1º ao 3° Lugar;**\u0026nbsp;De 36 a 45 anos:\r\nTroféus do 1º ao 3° Lugar;**\u0026nbsp;De 46 a 55 anos:\r\nTroféus do 1º ao 3° Lugar;**\u0026nbsp;Maior de 56 anos: Troféus\r\ndo 1º ao 3° Lugar.*\u0026nbsp;\u0026nbsp;Categoria COLABORADOR:\r\nDistância de 05 km Feminino e Masculino: Troféus do 1º ao 5° Lugar.21)\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;DIRETRIZES GERAISNÃO haverá premiação em dinheiro.\u0026nbsp;Todos os participantes da CAMINHADA e da CORRIDINHA KIDS receberão medalhas de participação. Não haverá\r\npremiação de troféus para participantes destas categorias.Todos os(as) atletas que cruzarem a linha\r\nde chegada de forma legal, regularmente inscritos e sem o\r\ndescumprimento deste regulamento, receberão\r\nmedalhas. Não serão entregues medalhas para as pessoas que, mesmo inscritas,\r\nnão participaram da corrida.\u0026nbsp;As 5\r\n(cinco) primeiras colocações de categorias GERAL Feminina e Masculina das\r\ndistâncias de 5 km (cinco quilômetros) e 10 km (dez quilômetros) serão\r\ndefinidas por ordem de chegada.\u0026nbsp;Os(as) atletas que fizerem jus à premiação\r\ndeverão comparecer ao pódio, assim que a cerimônia de premiação for iniciada e\r\na sua categoria for chamada. O(a) atleta que não comparecer ao pódio durante a\r\ncerimônia de premiação, perderá o direito aos prêmios, conforme determinação da\r\norganização da corrida e serão chamados os próximos pela ordem de classificação.Os resultados oficiais da corrida serão\r\ninformados por meio do site oficial do evento www.podiumsport.com.br,\r\nno prazo de 24 horas após o término da corrida.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","images":{"logoFileName":"6a727525dc0ab.jpg","logoUrl":"https://images.sympla.com.br/6a727525dc0ab.jpg","logoLarge":"https://images.sympla.com.br/6a727525dc0ab-lg.jpg","logoSmall":"https://images.sympla.com.br/6a727525dc0ab-xs.jpg","logoCover":"https://images.sympla.com.br/6a727525dc0ab-cover.jpg","logoProfile":"https://images.sympla.com.br/6a727525dc0ab-profile.jpg"},"oldUrl":"https://www.sympla.com.br/1-corrida-alianca-pela-vida__3520403","newUrl":"https://www.sympla.com.br/evento/1-corrida-alianca-pela-vida/3520403","slug":"1-corrida-alianca-pela-vida","logoType":"BANNER_16_9","bannerAltText":"Banner do evento 1º CORRIDA ALIANÇA PELA VIDA","published":true,"cancelled":false,"visible":true,"eventType":"NORMAL","eventSubType":"NORMAL","ticketsNomenclature":"REGISTRATION","isClosed":false,"uniqueHash":"Y1hNWNHFPoyJmcRDxhT0XJ2YDAsNQOucJYVxWmimrg%3D%3D","eventsCategory":{"id":20,"name":"esportes","description":"Esportes","vertical":"ESPORTIVO","slug":"esportes"},"eventsHost":{"id":588004,"name":"PODIUM SPORT EVENTOS","description":"E-mail - podium.sport.pvh@gmail.com\r\nSite        www.podiumsport.com.br\r\nInstagram  - @podiumsportpvh\r\nTelefone - (69) 9 9990-3696","image":null,"url":null,"organizerId":3271844,"organizerPageSlug":null},"headerContent":null,"headerEnabled":false,"pageTemplateCssBg":"","pageTemplateCssBgFilename":"","pageTemplateCssBgRepeat":false,"privateEvent":false,"multiLanguage":false,"googleAnalyticsCode":"G-5FQSQMY5S9","rdStationCode":null,"scriptBody":null,"scriptHead":null,"qtyMaxInstallments":12,"qtyMinInstallments":1,"hasInstallments":true,"serviceFee":10,"showMaps":true,"hasActiveDiscounts":true,"logoFileName":"6a727525dc0ab.jpg","startDateMultiFormat":{"ptBR":"31/10/2026 18:00:00","default":"2026-10-31 18:00:00","ISO8601":"2026-10-31T18:00:00-03:00"},"endDateMultiFormat":{"ptBR":"31/10/2026 22:30:00","default":"2026-10-31 22:30:00","ISO8601":"2026-10-31T22:30:00-03:00"},"_source":"db","hasSymplaStore":false,"isPreview":false},"cookieLang":null,"seoData":{"presencial":{"title":"{titulo_evento} em {cidade} - Sympla","description":"Compre ingressos para {titulo_evento} em {cidade} dia {data_inicio}. Confira os melhores eventos da Sympla!"},"online":{"title":"{titulo_evento} - online - Sympla","description":"{titulo_evento} - online. Confira eventos e cursos online na Sympla!"},"play":{"title":"{titulo_evento} - online - Sympla","description":"{titulo_evento} - online. Confira conteúdos e cursos online na Sympla Play!"}},"isBetaUrl":false}}},"__N_SSP":true},"page":"/evento/[slug]/[id]","query":{"slug":"1o-corrida-alianca-pela-vida","id":"3520403"},"buildId":"event-page-0d3ec2a4810cc7fc2479f2a9ee374d7fd773e59b","assetPrefix":"https://assets-event-page.svc.sympla.com.br/evento","runtimeConfig":{"version":"1.71.0"},"isFallback":false,"isExperimentalCompile":false,"gssp":true,"scriptLoader":[]}</script><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a4914a397e974b3a',t:'MTc5MTc1NzYyMw=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body></html>