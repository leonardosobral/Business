<script>
document.addEventListener('DOMContentLoaded', function() {
    verificarContador();
});

function verificarContador() {
    // Seleciona os elementos do contador
    var dias = document.querySelector('.elementor-countdown-days');
    var horas = document.querySelector('.elementor-countdown-hours');
    var minutos = document.querySelector('.elementor-countdown-minutes');
    var segundos = document.querySelector('.elementor-countdown-seconds');
    var contador = document.getElementById('contador');
    var inscrever = document.getElementById('inscrever');

    // Verifica se todos os elementos estão presentes e se todos os valores são "00"
    if (dias && horas && minutos && segundos && contador) {
        if (dias.textContent.trim() === '00' && 
            horas.textContent.trim() === '00' && 
            minutos.textContent.trim() === '00' && 
            segundos.textContent.trim() === '00') {
            // Oculta a div do contador
            contador.style.display = 'none';
            
            // Verifica se a div 'inscrever' existe antes de tentar ocultá-la
            if (inscrever) {
                inscrever.style.display = 'none';
            }
        }
    }
}
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(verificarContador, 200); // Atraso de 1 segundo
    setTimeout(verificarContador, 500); // Atraso de 1 segundo
    setTimeout(verificarContador, 1000); // Atraso de 1 segundo
});
</script>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Seleciona todos os elementos de botão dentro dos posts
    var buttons = document.querySelectorAll('.elementor-element-b3e0cf9 .elementor-button-text');

    // Itera sobre cada botão
    buttons.forEach(function(button) {
        // Verifica se o texto do botão é diferente de 'realizada'
        if (button.innerText.trim().toLowerCase() !== 'realizada') {
            // Oculta o botão específico
            button.closest('.elementor-element-b3e0cf9').style.display = 'none';
			button.closest('.elementor-element-b3e0cf9').style.display = 'none';
        } else {
			button.closest('.elementor-element-b3e0cf9').style.display = 'block';
		}
    });
});</script>
