<script>
window.onload = function() {
    verificarConteudo();
};

// Verifica se há conteúdo nas divs correspondentes e mostra ou oculta o menu e as divs de acordo
function verificarConteudo() {
    // Verifica a div correspondente ao menu 5k
    var div5k = document.getElementById('elementor-tab-content-9751');
    var divAbove5k = div5k.previousElementSibling;
    var menu5k = document.getElementById('elementor-tab-title-9751');
    if (div5k.innerHTML.trim() === '') {
        div5k.style.display = 'none'; // Oculta a div
        divAbove5k.style.display = 'none'; // Oculta a div
        menu5k.style.display = 'none'; // Oculta o menu
    }

    // Verifica a div correspondente ao menu 10k
    var div10k = document.getElementById('elementor-tab-content-9752');
    var divAbove10k = div10k.previousElementSibling;
    var menu10k = document.getElementById('elementor-tab-title-9752');
    if (div10k.innerHTML.trim() === '') {
        div10k.style.display = 'none'; // Oculta a div
        divAbove10k.style.display = 'none'; // Oculta a div
        menu10k.style.display = 'none'; // Oculta o menu
    }

    // Verifica a div correspondente ao menu 21k
    var div21k = document.getElementById('elementor-tab-content-9753');
    var divAbove21k = div21k.previousElementSibling;
    var menu21k = document.getElementById('elementor-tab-title-9753');
    if (div21k.innerHTML.trim() === '') {
        div21k.style.display = 'none'; // Oculta a div
        divAbove21k.style.display = 'none'; // Oculta a div
        menu21k.style.display = 'none'; // Oculta o menu
    }

    // Verifica a div correspondente ao menu 42k
    var div42k = document.getElementById('elementor-tab-content-9754');
    var divAbove42k = div42k.previousElementSibling;
    var menu42k = document.getElementById('elementor-tab-title-9754');
    if (div42k.innerHTML.trim() === '') {
        div42k.style.display = 'none'; // Oculta a div
        divAbove42k.style.display = 'none'; // Oculta a div
        menu42k.style.display = 'none'; // Oculta o menu
    }
}

// Função para verificar se há conteúdo na aba do hotel e ocultar o menu se estiver vazio
function ocultarMenuHotelSeVazio() {
    // Selecione a aba do hotel
    var abaHotel = document.getElementById('elementor-tab-title-1465');
    // Selecione o conteúdo da aba do hotel
    var conteudoHotel = document.getElementById('elementor-tab-content-1465');

    // Verifique se os elementos existem
    if (abaHotel && conteudoHotel) {
        // Verifique se o conteúdo da aba do hotel está vazio
        if (conteudoHotel.innerHTML.trim() === '') {
            // Oculte o menu do hotel e o conteúdo da aba do hotel
            abaHotel.style.display = 'none';
            conteudoHotel.style.display = 'none';
        }
    } else {
        console.error('Elementos não encontrados.');
    }
}

// Chame a função para ocultar o menu do hotel se estiver vazio após o carregamento do documento
document.addEventListener('DOMContentLoaded', function() {
    ocultarMenuHotelSeVazio();
});
</script>
