<script>
        document.addEventListener("DOMContentLoaded", function() {
            // Função para verificar imagens e ocultar div se necessário
            function verificarImagens(classe) {
                // Seleciona a div com a classe fornecida
                var div = document.querySelector(classe);
                
                // Seleciona todas as imagens dentro da div
                var imagens = div.querySelectorAll("img");

                // Verifica se há imagens dentro da div
                if (imagens.length === 0) {
                    // Se não houver imagens, oculta a div
                    div.style.display = "none";
                }
            }

            // Verifica imagens na div .apresenta
            verificarImagens(".apresenta");
            // Verifica imagens na div .patrocinio
            verificarImagens(".patrocinio");
            // Verifica imagens na div .apoio
            verificarImagens(".apoio");
			// Verifica imagens na div .hotel
            verificarImagens(".hotel");
        });

</script>
