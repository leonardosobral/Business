<!-- start Simple Custom CSS and JS -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Seleciona todos os elementos que possuem a classe 'REALIZADA'
    var realizados = document.querySelectorAll('.REALIZADA:not(.NAO)');

    // Itera sobre cada elemento com a classe 'REALIZADA'
    realizados.forEach(function(element) {
        // Verifica se há o botão de inscrição dentro do container
        var buttonText = element.querySelector('.elementor-button-text');
        var buttonLink = element.querySelector('a');

        // Se o botão for encontrado, altera o texto e o link
        if (buttonText && buttonLink) {
            // Altera o texto do botão para "Ver Melhores Momentos"
            buttonText.textContent = 'Ver Melhores Momentos';

            // Altera o link do botão para "#melhores-momentos"
            buttonLink.setAttribute('href', '#melhores-momentos');
        }

        // Altera o link da imagem
        var imageContainer = element.closest('.elementor-element-270a7d1').querySelector('.elementor-widget-image a');
        if (imageContainer) {
            // Altera o link da imagem para "#melhores-momentos"
            imageContainer.setAttribute('href', '#melhores-momentos');
        }
    });
});
