<script>
  window.onload = function() {
    let linkElement = document.querySelector("#provas > div > div > div > div > div > div > div.elementor.elementor-79.e-loop-item.e-loop-item-1659.post-1659.evento.type-evento.status-publish.hentry > div > div > div.elementor-element.elementor-element-49218f1.elementor-align-justify.REALIZADA.elementor-widget.elementor-widget-button > div > div > a");
    
