<script>
  // ── Scroll animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(el => {
      if (el.isIntersecting) el.target.classList.add('visible');
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  // ── Tab toggle de corridas
  const tabBtns = document.querySelectorAll('.tab-btn[data-tab]');
  const titulo  = document.getElementById('corridas-titulo');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;

      // Atualiza botões
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Alterna painéis
      document.querySelectorAll('.cards-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('painel-' + tab).classList.add('active');

      // Atualiza título
      titulo.innerHTML = tab === 'proximas' ? 'Próximas<br>corridas' : 'Corridas<br>realizadas';
    });
  });

  // ── Menu mobile
  const hamburger = document.querySelector('.nav-hamburger');
  const navMobile = document.querySelector('.nav-mobile');

  hamburger.addEventListener('click', () => {
    hamburger.classList.toggle('open');
    navMobile.classList.toggle('open');
  });

  // Fecha menu ao clicar num link
  document.querySelectorAll('.nav-mobile a').forEach(a => {
    a.addEventListener('click', () => {
      hamburger.classList.remove('open');
      navMobile.classList.remove('open');
    });
  });
</script>

<script>
(function () {
  var form = document.getElementById('pc-contact-form');
  if (!form) return;
  var btn = document.getElementById('pc-submit');
  var statusEl = document.getElementById('pc-form-status');
  var btnText = btn.textContent;

  function getEl() {
    return document.querySelector('.pc-elementor-form form.elementor-form');
  }
  function setStatus(msg, type) {
    statusEl.textContent = msg || '';
    statusEl.className = 'pc-form-status' + (type ? ' is-' + type : '');
  }
  function resetBtn() { btn.disabled = false; btn.textContent = btnText; }

  // Copia um campo do formulário do código para o Formulário Elementor
  function syncField(src) {
    var ef = getEl();
    if (!ef) return;
    var key = src.dataset.sync;
    var target = ef.querySelector('[name="form_fields[' + key + ']"]') || ef.querySelector('#form-field-' + key);
    if (target) target.value = src.value;
  }
  function syncAll() {
    form.querySelectorAll('[data-sync]').forEach(syncField);
  }
  form.querySelectorAll('[data-sync]').forEach(function (el) {
    el.addEventListener('input', function () { el.classList.remove('is-invalid'); syncField(el); });
    el.addEventListener('change', function () { syncField(el); });
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    setStatus('');
    var invalid = [];
    form.querySelectorAll('[required]').forEach(function (el) {
      if (!el.value.trim() || (el.type === 'email' && !el.checkValidity())) { invalid.push(el); el.classList.add('is-invalid'); }
    });
    if (invalid.length) { invalid[0].focus(); setStatus('Preencha corretamente os campos obrigatórios.', 'error'); return; }

    var ef = getEl();
    if (!ef) { setStatus('Não foi possível enviar agora. Escreva para sac@partiucorrida.com.', 'error'); return; }

    syncAll();
    btn.disabled = true; btn.textContent = 'Enviando...';

    var $ = window.jQuery;
    if ($) {
      var $ef = $(ef);
      $ef.off('.pcsync');
      $ef.one('submit_success.pcsync', function () {
        $ef.off('.pcsync');
        resetBtn(); form.reset(); syncAll();
        setStatus('Mensagem enviada com sucesso! Em breve retornaremos.', 'success');
      });
      $ef.one('error.pcsync', function () {
        $ef.off('.pcsync');
        resetBtn();
        setStatus('Ocorreu um erro ao enviar. Tente novamente ou escreva para sac@partiucorrida.com.', 'error');
      });
    }
    setTimeout(function () { if (btn.disabled) { resetBtn(); setStatus('O envio está demorando. Verifique sua conexão e tente novamente.', 'error'); } }, 25000);
    if (typeof ef.requestSubmit === 'function') ef.requestSubmit();
    else if ($) $(ef).trigger('submit');
    else ef.submit();
  });
})();
</script>
</body>
</html>				</div>
