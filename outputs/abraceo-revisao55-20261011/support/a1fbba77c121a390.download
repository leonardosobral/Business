                <li class="col-lg-4 col-md-6 col-sm-12">
                    <div class="team-member card-6 wow animate__fadeInUp" data-wow-duration="1s" data-wow-delay="0.6s">
                        <div class="team-member-img">
                            <img src="images/team-member-6.png" alt="Gusttavo Lima">
                        </div>
                        <img src="images/team-particle-orange.png" alt="graphic-imgs" />
                        <div class="team-member-info">
                            <span class="member-designation">Cantor e Compositor</span>
                            <h6>Gusttavo Lima</h6>
