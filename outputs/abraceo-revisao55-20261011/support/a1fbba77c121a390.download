                </div>
                <div class="nav-img infiniteBounce">
                    <img src="images/nav-wrapper-img.png" alt="nav-img">
                </div>
                <div class="nav-shapes">
                    <img class="particle-black infiniteZoomInOut" src="images/particle-black.png" alt="nav-shapes">
                    <img class="particle-white infiniteZoomInOut" src="./images/particle-white.png" alt="nav-shapes" />
                    <img class="particle-orange infiniteZoomInOut" src="./images/particle-orange.png" alt="nav-shapes" />
