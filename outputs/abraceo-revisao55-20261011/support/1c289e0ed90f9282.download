<style>
    /* Ajuste para o container do Select2 */
    .select2-container {
        width: 100% !important;
    }

    /* Aplica a fonte Kallisto no Placeholder e no campo de busca */
    .select2-container .select2-selection--multiple .select2-search__field,
    .select2-container .select2-selection--multiple,
    .select2-results__option {
        font-family: "Kallisto", sans-serif !important;
        font-weight: normal; /* ou o peso que você preferir */
    }

    /* Estilização do box de seleção para combinar com o Elementor */
    .select2-container--default .select2-selection--multiple {
        border: 1px solid #FFFFFFE6;
        min-height: 40px;
        border-radius: 3px;
        padding: 5px;
        background: #FFFFFFE6;
    }

    /* Garante que o placeholder tenha a cor correta enquanto nada é selecionado */
    .select2-search__field::placeholder {
        font-family: "Kallisto", sans-serif !important;
        color: #3f3f3f; /* Ajuste para a cor cinza padrão do Elementor se desejar */
    }
</style>

<script type="text/rocketlazyloadscript">window.addEventListener('DOMContentLoaded', function() {
jQuery(document).ready(function($) {
    // 1. Localizamos ambos os campos separando os IDs por vírgula
    var $meusSelects = $('#form-field-ano_que_participou, #form-field-disponibilidade');

    if ($meusSelects.length) {
        // 2. Forçamos o atributo 'multiple' em ambos
        $meusSelects.attr('multiple', 'multiple');

        // 3. Inicializamos o Select2 para ambos simultaneamente
        $meusSelects.select2({
            placeholder: "Selecione aqui...",
            allowClear: true,
            language: {
                noResults: function() {
                    return "Nenhum resultado encontrado";
                }
            }
        });
    }
});});</script>				</div>
