	font-family: 'Kallisto';
	font-style: normal;
	font-weight: 300;
	font-display: auto;
	src: url('https://maratonadevitoria.com.br/wp-content/uploads/2024/12/Kallisto-Light.woff') format('woff');
}
@font-face {
	font-family: 'Kallisto';
	font-style: normal;
	font-weight: bold;
	font-display: auto;
