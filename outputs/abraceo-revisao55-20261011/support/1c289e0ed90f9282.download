<!-- Elementor Custom Code: Menu Title Visibility Toggle -->
<style>
  #menubar-0 {
    width: 30px;
  }

  /* Oculta suavemente o título do menu */
  #menubar-0 > ul > li > div.e-n-menu-content.e-active ~ #e-n-menu-title-1481 > div,
  #e-n-menu-title-1481 > div.is-hidden {
    display: none !important;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
</style>

<script type="text/rocketlazyloadscript">
document.addEventListener('DOMContentLoaded', () => {
  const menuIcon = document.querySelector('#e-n-menu-dropdown-icon-1481');
  const menuTitle = document.querySelector('#e-n-menu-title-1481 > div');

  if (!menuIcon || !menuTitle) return;

  const updateMenuVisibility = () => {
    const isExpanded = menuIcon.getAttribute('aria-expanded') === 'true';
    menuTitle.classList.toggle('is-hidden', isExpanded);
  };

  // Inicialização do estado
  updateMenuVisibility();

  // Monitora alterações de atributos no ícone
  const menuObserver = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.type === 'attributes' && mutation.attributeName === 'aria-expanded') {
        updateMenuVisibility();
      }
    }
  });

  menuObserver.observe(menuIcon, {
    attributes: true,
    attributeFilter: ['aria-expanded']
  });
});
</script>
