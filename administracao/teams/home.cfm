<div class="row justify-content-center"><div class="col-12 business-page team-management"><section class="card business-page-card"><div class="card-body business-page-body">
<div class="d-flex flex-wrap justify-content-between gap-3 business-page-header mb-4"><div><h1 class="business-page-title mb-2">Gestão de Teams</h1><p class="text-muted mb-0">Analise cadastros, confira responsáveis técnicos e acompanhe os times da plataforma.</p></div><div class="d-flex flex-wrap align-items-center gap-3"><img class="team-management-logo" src="/teams/assets/rr_teams.svg?v=1" width="619" height="149" alt="Road Runners Teams"><cfif NOT teamCreate><a class="btn btn-warning text-dark" href="<cfoutput>#encodeForHTMLAttribute(teamAdminUrl() & '&novo=1')#</cfoutput>">Novo Team</a></cfif></div></div>
<cfif len(teamError)><div class="alert alert-warning" role="alert"><cfoutput>#encodeForHTML(teamError)#</cfoutput></div></cfif>
<cfif len(teamSuccess)><div class="alert alert-success" role="status"><cfoutput>#encodeForHTML(teamSuccess)#</cfoutput></div></cfif>
<cfif NOT structIsEmpty(teamGlobal)>
<cfif teamCreate><cfinclude template="includes/create.cfm"><cfelseif teamId EQ 0>
<div class="business-kpi-grid mb-4"><cfoutput><cfloop array="#[{label='Teams cadastrados',value=teamGlobal.stats.total},{label='Ativos',value=teamGlobal.stats.active},{label='Aguardando análise',value=teamGlobal.stats.pending},{label='Ajustes solicitados',value=teamGlobal.stats.changes},{label='Suspensos',value=teamGlobal.stats.suspended},{label='Atletas vinculados',value=teamGlobal.stats.athletes}]#" index="teamMetric"><div class="business-kpi"><div class="business-label">#encodeForHTML(teamMetric.label)#</div><strong class="business-kpi-value">#LSNumberFormat(teamMetric.value)#</strong></div></cfloop></cfoutput></div>
<form class="business-filterbar team-management-filters mb-4" method="get" action="/administracao/teams/">
<label>Buscar Team<input class="form-control" type="search" name="q" maxlength="100" value="<cfoutput>#encodeForHTMLAttribute(teamSearch)#</cfoutput>" placeholder="Nome ou cidade"></label>
<label>Situação<select class="form-select" name="status"><option value="">Todas</option><cfoutput><cfloop list="PENDING,ACTIVE,CHANGES,REJECTED,SUSPENDED,ARCHIVED" index="filterStatus"><option value="#filterStatus#" <cfif teamStatus EQ filterStatus>selected</cfif>>#encodeForHTML(teamLabel(filterStatus))#</option></cfloop></cfoutput></select></label>
<label>Tipo<select class="form-select" name="type"><option value="">Todos</option><cfoutput><cfloop collection="#teamTypeLabels#" item="filterType"><option value="#filterType#" <cfif teamType EQ filterType>selected</cfif>>#encodeForHTML(teamTypeLabels[filterType])#</option></cfloop></cfoutput></select></label>
<label>UF<select class="form-select" name="uf"><option value="">Todas</option><cfoutput><cfloop list="AC,AL,AP,AM,BA,CE,DF,ES,GO,MA,MT,MS,MG,PA,PB,PR,PE,PI,RJ,RN,RS,RO,RR,SC,SP,SE,TO" index="filterUf"><option value="#filterUf#" <cfif teamUf EQ filterUf>selected</cfif>>#filterUf#</option></cfloop></cfoutput></select></label>
<div class="team-management-filter-actions"><button class="btn btn-warning" type="submit">Filtrar</button><a class="btn btn-outline-secondary" href="/administracao/teams/">Limpar</a></div></form>
<section class="business-panel"><div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><h2 class="h5 mb-0">Teams cadastrados</h2><span class="text-muted"><cfoutput>#teamGlobal.total#</cfoutput> encontrado(s)</span></div>
<cfif NOT teamGlobal.teams.recordCount><p class="text-muted mb-0">Nenhum Team encontrado para os filtros selecionados.</p><cfelse><cfset teamRows=teamGlobal.teams><div class="table-responsive"><table class="table table-sm business-table team-management-table align-middle mb-0"><caption class="visually-hidden">Teams cadastrados na plataforma, ordenados com pendências primeiro.</caption><thead><tr><th scope="col">Team</th><th scope="col">Responsável técnico / CREF</th><th scope="col">Tipo</th><th scope="col">Localidade</th><th scope="col">Situação</th><th scope="col">Atletas</th><th scope="col">Ações</th></tr></thead><tbody>
<cfoutput query="teamRows"><tr><td><strong>#encodeForHTML(name)#</strong><small class="d-block text-muted">Cadastro em #dateFormat(created_at,'dd/mm/yyyy')#</small></td><td>#encodeForHTML(technical_name)#<small class="d-block text-muted">#encodeForHTML(cref)# / #encodeForHTML(cref_uf)#</small></td><td>#encodeForHTML(teamTypeLabels[type])#</td><td>#encodeForHTML(city)# / #encodeForHTML(uf)#</td><td><span class="team-management-status teams-status-#encodeForHTMLAttribute(status)#">#encodeForHTML(teamLabel(status))#</span></td><td>#athletes#</td><td><a class="btn btn-sm btn-outline-warning" href="#encodeForHTMLAttribute(teamAdminUrl(id_team,listFind('PENDING,CHANGES',status)?'revisao':'cadastro'))#" aria-label="Gerenciar #encodeForHTMLAttribute(name)#">Gerenciar</a></td></tr></cfoutput>
</tbody></table></div></cfif>
<nav class="team-management-pagination" aria-label="Paginação de Teams"><span class="text-muted"><cfoutput>Página #teamGlobal.page# de #teamGlobal.pages#</cfoutput></span><div><cfif teamGlobal.page GT 1><a class="btn btn-sm btn-outline-warning" href="<cfoutput>#encodeForHTMLAttribute(teamAdminUrl(0,'cadastro',teamGlobal.page-1))#</cfoutput>">Anterior</a></cfif> <cfif teamGlobal.page LT teamGlobal.pages><a class="btn btn-sm btn-outline-warning" href="<cfoutput>#encodeForHTMLAttribute(teamAdminUrl(0,'cadastro',teamGlobal.page+1))#</cfoutput>">Próxima</a></cfif></div></nav></section>
<cfelseif NOT structIsEmpty(teamWorkspace)>
<a class="d-inline-block mb-3" href="<cfoutput>#encodeForHTMLAttribute(teamAdminUrl())#</cfoutput>">← Voltar à lista de Teams</a>
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h2 class="h4 mb-1"><cfoutput>#encodeForHTML(tt.name)#</cfoutput></h2><p class="text-muted mb-0"><cfoutput>#encodeForHTML(tt.city)# / #encodeForHTML(tt.uf)# · #encodeForHTML(teamTypeLabels[tt.type])#</cfoutput></p></div><div><span class="team-management-status teams-status-<cfoutput>#encodeForHTMLAttribute(tt.status)#</cfoutput>"><cfoutput>#encodeForHTML(teamLabel(tt.status))#</cfoutput></span></div></div>
<nav class="nav business-tabs teams-tabs team-management-tabs mb-4" aria-label="Seções da gestão do Team"><cfoutput><cfloop array="#teamGlobalTabOrder#" index="tabKey"><a class="nav-link <cfif teamTab EQ tabKey>active</cfif>" href="#encodeForHTMLAttribute(teamAdminUrl(teamId,tabKey))#" <cfif teamTab EQ tabKey>aria-current="page"</cfif>>#encodeForHTML(teamGlobalTabs[tabKey])#</a></cfloop></cfoutput></nav>
<cfif teamTab EQ 'cadastro'><cfinclude template="../../teams/includes/registration.cfm">
<cfelseif teamTab EQ 'responsavel'>
<section class="business-panel"><h2 class="h5">Responsável técnico e contato</h2><dl class="team-management-details"><cfoutput><div><dt>Responsável técnico</dt><dd>#encodeForHTML(tt.technical_name)#</dd></div><div><dt>CREF / Regional</dt><dd>#encodeForHTML(tt.cref)# / #encodeForHTML(tt.cref_uf)#</dd></div><div><dt>Titular da conta</dt><dd>#encodeForHTML(tt.owner_name)#</dd></div><div><dt>CPF ou CNPJ</dt><dd>#encodeForHTML(tt.document)#</dd></div><div><dt>Email comercial</dt><dd>#encodeForHTML(tt.email)#</dd></div><div><dt>Telefone</dt><dd>#encodeForHTML(tt.phone)#</dd></div><div><dt>WhatsApp</dt><dd>#encodeForHTML(tt.whatsapp)#</dd></div><div><dt>Atendimento</dt><dd>#encodeForHTML(tt.attendance=='AMBOS'?'Presencial e online':(tt.attendance=='ONLINE'?'Online':'Presencial'))#</dd></div></cfoutput></dl><p class="text-muted mb-0">Registre a conferência do CREF e a decisão na aba Revisão. Os dados podem ser atualizados na aba Cadastro.</p></section>
<cfelseif teamTab EQ 'revisao'><cfinclude template="includes/review.cfm">
<cfelseif teamTab EQ 'equipe'><cfinclude template="includes/admins.cfm">
<cfelseif teamTab EQ 'atletas'>
<section class="business-panel"><h2 class="h5">Atletas vinculados</h2><p class="text-muted">O atleta escolhe seu Team. Remover o vínculo bloqueia o retorno até sua liberação.</p>
<form class="team-management-athlete-search mb-3" method="get"><cfoutput><input type="hidden" name="team" value="#teamId#"><input type="hidden" name="tab" value="atletas"><input type="hidden" name="q" value="#encodeForHTMLAttribute(teamSearch)#"><input type="hidden" name="status" value="#encodeForHTMLAttribute(teamStatus)#"><input type="hidden" name="type" value="#encodeForHTMLAttribute(teamType)#"><input type="hidden" name="uf" value="#encodeForHTMLAttribute(teamUf)#"><input type="hidden" name="page" value="#teamPage#"><label>Buscar atleta<input class="form-control" name="aq" value="#encodeForHTMLAttribute(teamAthleteSearch)#" maxlength="100"></label></cfoutput><button class="btn btn-warning">Buscar</button></form>
<cfif NOT tw.athletes.recordCount><p class="text-muted">Nenhum atleta encontrado.</p><cfelse><div class="table-responsive"><table class="table table-sm business-table"><thead><tr><th scope="col">Atleta</th><th scope="col">Adesão</th><th scope="col">Ação</th></tr></thead><tbody><cfoutput query="tw.athletes"><tr><td>#encodeForHTML(name)#</td><td>#encodeForHTML(joined_on)#</td><td><form method="post" data-confirm="Encerrar o vínculo deste atleta? O retorno ficará bloqueado até liberação."><input type="hidden" name="csrf" value="#teamCsrf#"><input type="hidden" name="operation" value="remove_athlete"><input type="hidden" name="team" value="#teamId#"><input type="hidden" name="athlete" value="#user_id#"><button class="btn btn-sm btn-outline-danger">Remover vínculo</button></form></td></tr></cfoutput></tbody></table></div></cfif>
<nav class="team-management-pagination" aria-label="Paginação de atletas"><cfif teamAthletePage GT 1><a href="<cfoutput>#encodeForHTMLAttribute(reReplace(teamAdminUrl(teamId,'atletas'),'&apage=[0-9]+','&apage=' & (teamAthletePage-1)))#</cfoutput>">Anterior</a></cfif><cfif tw.athletes.recordCount EQ 25><a href="<cfoutput>#encodeForHTMLAttribute(reReplace(teamAdminUrl(teamId,'atletas'),'&apage=[0-9]+','&apage=' & (teamAthletePage+1)))#</cfoutput>">Próxima</a></cfif></nav></section>
<cfif tw.exclusions.recordCount><section class="teams-panel"><h2>Retornos bloqueados</h2><cfoutput query="tw.exclusions"><form class="teams-inline" method="post"><input type="hidden" name="csrf" value="#teamCsrf#"><input type="hidden" name="operation" value="unblock_athlete"><input type="hidden" name="team" value="#teamId#"><input type="hidden" name="athlete" value="#user_id#"><span>#encodeForHTML(name)#</span><button class="secondary">Permitir nova adesão</button></form></cfoutput></section></cfif>
<cfelseif teamTab EQ 'historico'>
<section class="business-panel"><h2 class="h5">Histórico do Team</h2><p class="text-muted">Até 30 atividades mais recentes, incluindo decisões e alterações de acesso.</p><cfif NOT tw.audit.recordCount><p class="text-muted">Nenhuma atividade registrada.</p><cfelse><ol class="team-management-history"><cfoutput query="tw.audit"><li><time>#dateTimeFormat(created_at,'dd/mm/yyyy HH:nn')#</time><strong>#encodeForHTML(teamAuditLabel(event))#</strong><cfif len(detail)><p>#encodeForHTML(detail)#</p></cfif></li></cfoutput></ol></cfif></section>
</cfif>
</cfif></cfif>
</div></section></div></div>
