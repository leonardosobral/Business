<cfif NOT structKeyExists(VARIABLES,"geoCanAdmin") OR NOT VARIABLES.geoCanAdmin><cfheader statuscode="403"><cfabort></cfif>
<cfset VARIABLES.geoLocationLabels={pending="Na fila",auto_applied="Confirmado automaticamente",approved="Aprovado",preserved="Cadastro preservado",needs_review="Conferir ponto",city_suggestion="Somente cidade",insufficient_data="Sem confirmação",rejected="Descartado"}>
<cfoutput>
<section class="card mb-3" id="proposta"><div class="card-body">
  <div class="d-flex justify-content-between gap-3 flex-wrap"><div><h2 class="h5">#encodeForHTML(VARIABLES.geoSelected.nome_evento)#</h2><div class="small text-body-secondary">Evento #VARIABLES.geoSelected.id_evento# · IA #encodeForHTML(VARIABLES.geoDecision.model ?: 'não utilizada: fonte insuficiente')# · revisão #VARIABLES.geoSelected.proposal_revision#</div></div><a class="btn btn-sm btn-outline-secondary" href="/eventos/?id_evento=#VARIABLES.geoSelected.id_evento#">Cadastro do evento</a></div>
  <p class="small text-body-secondary mt-2">Prova e kit são locais independentes. Apenas evidências literais da edição correta e pontos específicos podem ser publicados. Nenhuma justificativa digitada é obrigatória.</p>
  <div data-geo-panels><div class="nav nav-pills gap-2 mb-3" role="tablist" aria-label="Dados analisados do evento"><button type="button" id="geo-tab-locations" class="nav-link active" role="tab" aria-selected="true" aria-controls="geo-panel-locations" data-geo-tab="geo-panel-locations">Prova e kit</button><button type="button" id="geo-tab-fields" class="nav-link" role="tab" aria-selected="false" aria-controls="geo-panel-fields" tabindex="-1" data-geo-tab="geo-panel-fields">Dados do evento</button></div>
  <div id="geo-panel-locations" role="tabpanel" aria-labelledby="geo-tab-locations">
  <div class="geo-review-layout"><cfloop from="1" to="#arrayLen(VARIABLES.geoDecision.targets)#" index="VARIABLES.geoTargetIndex"><cfset VARIABLES.geoTarget=VARIABLES.geoDecision.targets[VARIABLES.geoTargetIndex]>
    <article class="border rounded p-3"><h3 class="h6"><i class="fa-solid #VARIABLES.geoTarget.role EQ 'kit' ? 'fa-box' : 'fa-flag-checkered'# me-2" aria-hidden="true"></i>#VARIABLES.geoTarget.role EQ 'kit' ? 'Retirada de kit' : 'Local da prova'#</h3>
      <span class="badge text-bg-secondary">#encodeForHTML(VARIABLES.geoLocationLabels[VARIABLES.geoTarget.status] ?: VARIABLES.geoTarget.status)#</span>
      <cfif VARIABLES.geoTarget.status EQ 'preserved'><p class="small mt-2">Dados já cadastrados preservados.</p></cfif>
      <cfif VARIABLES.geoTarget.status EQ 'city_suggestion'><p class="small text-warning mt-2">Localização aproximada da cidade — sugestão privada, não é local confirmado.</p></cfif>
      <cfif NOT structIsEmpty(VARIABLES.geoTarget.facts)><p class="mt-2 mb-1"><strong>#encodeForHTML(VARIABLES.geoTarget.facts.name ?: '')#</strong></p><p class="geo-value small">#encodeForHTML(VARIABLES.geoTarget.facts.address ?: '')#<br>#encodeForHTML(VARIABLES.geoTarget.facts.city ?: '')# / #encodeForHTML(VARIABLES.geoTarget.facts.state ?: '')#</p></cfif>
      <cfif structKeyExists(VARIABLES.geoTarget.evidence,'excerpt')><blockquote class="small border-start ps-2 mt-3 geo-value">#encodeForHTML(VARIABLES.geoTarget.evidence.excerpt)#</blockquote><cfif reFindNoCase('^https://',VARIABLES.geoTarget.evidence.url ?: '')><a class="small" target="_blank" rel="noopener noreferrer" href="#encodeForHTMLAttribute(VARIABLES.geoTarget.evidence.url)#">Conferir fonte</a></cfif></cfif>
      <cfif NOT VARIABLES.geoTarget.trusted><p class="small text-warning mt-2">Finalidade, edição ou endereço não confirmados. Não será preenchido automaticamente.</p></cfif>
      <cfif NOT structIsEmpty(VARIABLES.geoTarget.candidate)><p class="small mt-2 mb-1">#encodeForHTML(VARIABLES.geoTarget.candidate.formatted ?: '')#</p><a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer" href="https://www.openstreetmap.org/?mlat=#encodeForURL(VARIABLES.geoTarget.candidate.lat & '')#&amp;mlon=#encodeForURL(VARIABLES.geoTarget.candidate.lon & '')#">Conferir ponto no mapa</a></cfif>
      <cfif listFind('needs_review,city_suggestion,insufficient_data',VARIABLES.geoTarget.status) AND listFind('needs_review,city_suggestion,insufficient_data',VARIABLES.geoSelected.status)><form method="post" class="mt-3" data-geo-confirm="Confirmar a revisão deste local? Os outros locais são tratados separadamente.">
        <input type="hidden" name="csrf" value="#encodeForHTMLAttribute(csrfGenerateToken('event-geocoding'))#"><input type="hidden" name="id" value="#VARIABLES.geoSelected.id#"><input type="hidden" name="target" value="#VARIABLES.geoTargetIndex#"><input type="hidden" name="revision" value="#VARIABLES.geoSelected.proposal_revision#"><input type="hidden" name="confirmed" value="1">
        <cfif VARIABLES.geoTarget.trusted AND VARIABLES.geoPolicy.specificCandidate(VARIABLES.geoTarget.context,VARIABLES.geoTarget.candidate)><button class="btn btn-success btn-sm" name="action" value="approve_target">Aprovar local</button></cfif><button class="btn btn-outline-danger btn-sm" name="action" value="reject_target">Descartar sugestão</button>
      </form></cfif>
    </article>
  </cfloop></div>
  <cfif NOT arrayLen(VARIABLES.geoDecision.targets)>
    <cfif listFind('pending,running',VARIABLES.geoSelected.status)><p class="text-body-secondary mt-3">Pesquisa aguardando processamento ou retomada automática. Ainda não há conclusão sobre os locais.</p>
    <cfelseif listFind('error,errors_exhausted',VARIABLES.geoSelected.status)><p class="text-warning mt-3"><cfif VARIABLES.geoSelected.status EQ 'error'>A consulta falhou; uma nova tentativa está programada.<cfelse>As tentativas se esgotaram. Confira as fontes e reenfileire o evento.</cfif> Nenhuma localização foi presumida. Motivo: #encodeForHTML(VARIABLES.geoDecision.code ?: 'consulta indisponível')#.</p>
    <cfelse><p class="text-body-secondary mt-3">Nenhum local confirmado nas fontes desta edição. Cadastros existentes foram preservados.</p></cfif>
  </cfif>
  <cfif structKeyExists(VARIABLES.geoDecision,'diagnostics') AND arrayLen(VARIABLES.geoDecision.diagnostics)><details class="small mt-3"><summary>Detalhes da pesquisa</summary><ul><cfloop array="#VARIABLES.geoDecision.diagnostics#" index="VARIABLES.geoDiagnostic"><li>#encodeForHTML(VARIABLES.geoDiagnostic)#</li></cfloop></ul></details></cfif>
  </div><div id="geo-panel-fields" role="tabpanel" aria-labelledby="geo-tab-fields" hidden><cfinclude template="enrichment_view.cfm"></div></div>
</div></section>
</cfoutput>
