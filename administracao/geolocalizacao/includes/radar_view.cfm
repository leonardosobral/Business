<cfif NOT structKeyExists(VARIABLES,"geoCanAdmin") OR NOT VARIABLES.geoCanAdmin><cfheader statuscode="403"><cfabort></cfif>
<cfset VARIABLES.geoRadarQualityLabels={confirmed="Confirmada",legacy="Legada",suspicious="Suspeita",absent="Ausente"}>
<cfset VARIABLES.geoRadarReasonLabels={null_island="Coordenada 0,0",provenance_coordinate_mismatch="Proveniência divergente",cross_city_duplicate_coordinates="Mesmo ponto em cidades diferentes",text_numeric_mismatch="Representações divergentes"}>
<cfset VARIABLES.geoRadarMeasured=VARIABLES.geoRadarStats.measuredAt & "">
<cfif isDate(VARIABLES.geoRadarStats.measuredAt)><cfset VARIABLES.geoRadarMeasured=dateTimeFormat(VARIABLES.geoRadarStats.measuredAt,"dd/mm/yyyy HH:nn:ss")></cfif>
<style>
.geo-radar-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.geo-radar-progress{height:.5rem}.geo-radar-table td{vertical-align:middle}@media(max-width:991.98px){.geo-radar-summary{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:575.98px){.geo-radar-summary{grid-template-columns:1fr}.geo-radar-filter .btn{width:100%}}
</style>
<cfoutput>
<cfif NOT VARIABLES.geoRadarReady>
  <section class="card"><div class="card-body"><h2 class="h5">Cobertura do Radar</h2><div class="alert alert-warning mb-0"><strong>Cobertura indisponível.</strong> A normalização geográfica compartilhada ainda não está pronta neste ambiente. Nenhum evento foi alterado.</div></div></section>
<cfelse>
  <section class="card mb-3"><div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3"><div><h2 class="h4 mb-1">Cobertura do Radar</h2><p class="text-body-secondary mb-0">Eventos ativos e futuros com página pública. Esta visão é somente de leitura.</p></div><div class="small text-body-secondary">Atualizado em #encodeForHTML(VARIABLES.geoRadarMeasured)#</div></div>
    <div class="d-flex justify-content-between gap-3 small mb-2"><span><strong>#numberFormat(VARIABLES.geoRadarStats.mapped,'0')#</strong> de #numberFormat(VARIABLES.geoRadarStats.total,'0')# eventos localizados</span><strong>#numberFormat(VARIABLES.geoRadarStats.coveragePercent,'0.00')#%</strong></div>
    <div class="progress geo-radar-progress mb-4" role="progressbar" aria-label="Cobertura geográfica do Radar" aria-valuenow="#val(VARIABLES.geoRadarStats.coveragePercent)#" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-warning" style="width:#min(100,max(0,val(VARIABLES.geoRadarStats.coveragePercent)))#%"></div></div>
    <div class="geo-radar-summary">
      <cfloop array="#[{key='confirmed',label='Confirmadas',help='Local conferido e com proveniência'},{key='legacy',label='Legadas',help='Par válido ainda sem proveniência estruturada'},{key='suspicious',label='Suspeitas',help='Precisam de conferência administrativa'},{key='absent',label='Ausentes',help='Ainda não aparecem no Radar'}]#" index="VARIABLES.geoRadarMetric"><div class="border rounded p-3"><div class="small fw-bold">#VARIABLES.geoRadarMetric.label#</div><div class="geo-metric">#numberFormat(VARIABLES.geoRadarStats[VARIABLES.geoRadarMetric.key],'0')#</div><div class="small text-body-secondary">#VARIABLES.geoRadarMetric.help#</div></div></cfloop>
    </div>
    <div class="d-flex flex-wrap gap-3 small text-body-secondary mt-3"><span>Até 30 dias: <strong>#numberFormat(VARIABLES.geoRadarStats.next30,'0')#</strong></span><span>31–90 dias: <strong>#numberFormat(VARIABLES.geoRadarStats.next90,'0')#</strong></span><span>Após 90 dias: <strong>#numberFormat(VARIABLES.geoRadarStats.later,'0')#</strong></span></div>
  </div></section>

  <section class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end geo-radar-filter"><input type="hidden" name="aba" value="radar">
      <div class="col-lg-4"><label class="form-label" for="geo-radar-search">Evento, ID ou cidade</label><input class="form-control" id="geo-radar-search" name="busca" maxlength="100" value="#encodeForHTMLAttribute(VARIABLES.geoRadarSearch)#"></div>
      <div class="col-sm-6 col-lg-2"><label class="form-label" for="geo-radar-quality">Qualidade</label><select class="form-select" id="geo-radar-quality" name="qualidade"><cfloop array="#[{value='all',label='Todas'},{value='confirmed',label='Confirmadas'},{value='legacy',label='Legadas'},{value='suspicious',label='Suspeitas'},{value='absent',label='Ausentes'}]#" index="VARIABLES.geoRadarOption"><option value="#VARIABLES.geoRadarOption.value#"<cfif VARIABLES.geoRadarQuality EQ VARIABLES.geoRadarOption.value> selected</cfif>>#VARIABLES.geoRadarOption.label#</option></cfloop></select></div>
      <div class="col-sm-6 col-lg-2"><label class="form-label" for="geo-radar-horizon">Quando</label><select class="form-select" id="geo-radar-horizon" name="horizonte"><cfloop array="#[{value='all',label='Todo o futuro'},{value='30',label='Até 30 dias'},{value='90',label='31–90 dias'},{value='later',label='Após 90 dias'}]#" index="VARIABLES.geoRadarOption"><option value="#VARIABLES.geoRadarOption.value#"<cfif VARIABLES.geoRadarHorizon EQ VARIABLES.geoRadarOption.value> selected</cfif>>#VARIABLES.geoRadarOption.label#</option></cfloop></select></div>
      <div class="col-sm-4 col-lg-1"><label class="form-label" for="geo-radar-uf">UF</label><input class="form-control text-uppercase" id="geo-radar-uf" name="uf" maxlength="2" pattern="[A-Z]{2}" value="#encodeForHTMLAttribute(VARIABLES.geoRadarUf)#"></div>
      <div class="col-sm-auto"><button class="btn btn-primary">Filtrar</button> <a class="btn btn-outline-secondary" href="?aba=radar">Limpar</a></div>
    </form>
  </div></section>

  <div class="row g-3"><section class="col-xl-9"><div class="card h-100"><div class="card-body"><div class="table-responsive"><table class="table align-middle geo-radar-table"><thead><tr><th>Evento</th><th>Data</th><th>Localidade</th><th>Qualidade</th><th>Processamento</th><th></th></tr></thead><tbody>
    <cfif NOT VARIABLES.geoRadarRows.recordCount><tr><td colspan="6" class="text-body-secondary py-4 text-center">Nenhum evento encontrado com estes filtros.</td></tr></cfif>
    <cfloop query="VARIABLES.geoRadarRows" endrow="20"><tr><td><strong>#encodeForHTML(VARIABLES.geoRadarRows.nome_evento)#</strong><div class="small text-body-secondary">ID #VARIABLES.geoRadarRows.id_evento#</div></td><td class="small text-nowrap">#encodeForHTML(VARIABLES.geoRadarRows.starts)#</td><td>#encodeForHTML(VARIABLES.geoRadarRows.cidade ?: '')# / #encodeForHTML(VARIABLES.geoRadarRows.estado ?: '')#</td><td><span class="badge text-bg-#VARIABLES.geoRadarRows.quality EQ 'confirmed' ? 'success' : (VARIABLES.geoRadarRows.quality EQ 'suspicious' ? 'warning' : 'secondary')#">#encodeForHTML(VARIABLES.geoRadarQualityLabels[VARIABLES.geoRadarRows.quality] ?: VARIABLES.geoRadarRows.quality)#</span><cfif len(VARIABLES.geoRadarRows.review_reason ?: '')><div class="small text-body-secondary mt-1">#encodeForHTML(VARIABLES.geoRadarReasonLabels[VARIABLES.geoRadarRows.review_reason] ?: VARIABLES.geoRadarRows.review_reason)#</div></cfif></td><td class="small">#encodeForHTML(VARIABLES.geoRadarRows.geocoding_status)#<cfif len(VARIABLES.geoRadarRows.changed_at ?: '')><div class="text-body-secondary">#encodeForHTML(VARIABLES.geoRadarRows.changed_at)#</div></cfif></td><td><a class="btn btn-sm btn-outline-secondary" href="/eventos/?id_evento=#VARIABLES.geoRadarRows.id_evento#">Cadastro</a></td></tr></cfloop>
  </tbody></table></div><nav class="d-flex gap-3 align-items-center mt-3" aria-label="Paginação da cobertura"><cfif VARIABLES.geoRadarPage GT 1><a href="?aba=radar&amp;pagina=#VARIABLES.geoRadarPage-1#&amp;busca=#encodeForURL(VARIABLES.geoRadarSearch)#&amp;qualidade=#VARIABLES.geoRadarQuality#&amp;horizonte=#VARIABLES.geoRadarHorizon#&amp;uf=#VARIABLES.geoRadarUf#">Anterior</a></cfif><span class="small">Página #VARIABLES.geoRadarPage#</span><cfif VARIABLES.geoRadarHasNext><a href="?aba=radar&amp;pagina=#VARIABLES.geoRadarPage+1#&amp;busca=#encodeForURL(VARIABLES.geoRadarSearch)#&amp;qualidade=#VARIABLES.geoRadarQuality#&amp;horizonte=#VARIABLES.geoRadarHorizon#&amp;uf=#VARIABLES.geoRadarUf#">Próxima</a></cfif></nav></div></div></section>
  <aside class="col-xl-3"><div class="card h-100"><div class="card-body"><h3 class="h6">Cobertura por UF</h3><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>UF</th><th class="text-end">Mapeados</th><th class="text-end">%</th></tr></thead><tbody><cfloop query="VARIABLES.geoRadarStates"><tr><td>#encodeForHTML(VARIABLES.geoRadarStates.state_code)#</td><td class="text-end">#numberFormat(VARIABLES.geoRadarStates.mapped_total,'0')# / #numberFormat(VARIABLES.geoRadarStates.eligible_total,'0')#</td><td class="text-end">#numberFormat(VARIABLES.geoRadarStates.coverage_percent,'0.0')#%</td></tr></cfloop></tbody></table></div><hr><p class="small text-body-secondary mb-0">Sugestões baseadas apenas na cidade continuam privadas e não geram marcadores no Radar.</p></div></div></aside></div>
</cfif>
</cfoutput>
