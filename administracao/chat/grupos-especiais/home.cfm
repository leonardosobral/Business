<style>
.special-groups{--sg-border:rgba(255,255,255,.12);--sg-muted:rgba(255,255,255,.62)}.special-groups .sg-hero,.special-groups .sg-card{border:1px solid var(--sg-border);border-radius:12px}.special-groups .sg-hero{background:linear-gradient(135deg,rgba(255,193,7,.13),rgba(255,255,255,.025))}.special-groups .sg-card{padding:1.2rem}.special-groups .sg-muted{color:var(--sg-muted)}.special-groups .sg-rule{border:1px solid var(--sg-border);border-radius:9px;padding:1rem}.special-groups .sg-rule-fields{display:grid;gap:.75rem;grid-template-columns:repeat(4,minmax(0,1fr))}.special-groups code{color:#ffd54f}.special-groups table{font-size:.86rem}@media(max-width:900px){.special-groups .sg-rule-fields{grid-template-columns:1fr 1fr}}@media(max-width:560px){.special-groups .sg-rule-fields{grid-template-columns:1fr}}
</style>
<section class="special-groups py-4 py-lg-5">
  <div class="sg-hero p-4 mb-4 d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
    <div><div class="text-warning small fw-bold text-uppercase mb-2">Administração · Chat</div><h1 class="h3 mb-2">Grupos especiais</h1><p class="sg-muted mb-0">Crie comunidades cuja participação é calculada por regras seguras do Road Runners.</p></div>
    <a class="btn btn-outline-light btn-sm" href="/administracao/chat/"><i class="fa-solid fa-chart-line me-2"></i>Uso do Chat</a>
  </div>

  <cfif len(VARIABLES.specialGroupsFeedback)><div class="alert alert-<cfoutput>#VARIABLES.specialGroupsFeedbackType#</cfoutput>"><cfoutput>#htmlEditFormat(VARIABLES.specialGroupsFeedback)#</cfoutput></div></cfif>
  <cfif NOT VARIABLES.specialGroupsReady><div class="alert alert-warning"><strong>Gerenciador indisponível.</strong> <cfoutput>#htmlEditFormat(structKeyExists(VARIABLES.specialGroupsData,'message') ? VARIABLES.specialGroupsData.message : 'Verifique a migration e a integração assinada com o Road Runners.')#</cfoutput></div></cfif>

  <div class="row g-4">
    <div class="col-12 col-xxl-7"><div class="sg-card h-100">
      <div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h5 mb-1">Comunidades configuradas</h2><div class="small sg-muted">O grupo nunca fica público fora da política ativa.</div></div><span class="badge badge-warning"><cfoutput>#arrayLen(VARIABLES.specialGroups)#</cfoutput></span></div>
      <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Grupo</th><th>Status</th><th class="text-end">Membros</th><th>Última sincronização</th><th></th></tr></thead><tbody>
      <cfloop array="#VARIABLES.specialGroups#" item="VARIABLES.groupItem"><cfoutput><tr><td><div class="fw-semibold">#htmlEditFormat(VARIABLES.groupItem.nome)#</div><code>#htmlEditFormat(VARIABLES.groupItem.codigo)#</code><div class="small sg-muted">Dono: #htmlEditFormat(VARIABLES.groupItem.owner_name)# · regra v#val(VARIABLES.groupItem.regra_versao)#</div></td><td><span class="badge <cfif VARIABLES.groupItem.status EQ 'active'>badge-success<cfelseif VARIABLES.groupItem.status EQ 'draft'>badge-secondary<cfelse>badge-warning</cfif>">#htmlEditFormat(VARIABLES.groupItem.status)#</span></td><td class="text-end fw-semibold">#numberFormat(val(VARIABLES.groupItem.member_count),'_,___')#</td><td><cfif isDate(VARIABLES.groupItem.ultima_sincronizacao_em)>#dateTimeFormat(VARIABLES.groupItem.ultima_sincronizacao_em,'dd/mm/yyyy HH:nn')#<cfelse><span class="sg-muted">Nunca</span></cfif></td><td><div class="d-flex gap-1 justify-content-end"><a class="btn btn-sm btn-outline-light" href="?editar=#val(VARIABLES.groupItem.id_chat_grupo)#" title="Editar"><i class="fa-solid fa-pen"></i></a><form method="post" class="m-0"><input type="hidden" name="special_groups_csrf" value="#VARIABLES.specialGroupsCsrf#"><input type="hidden" name="manager_request_id" value="#lCase(hash(createUUID(),'SHA-256'))#"><input type="hidden" name="manager_action" value="sync"><input type="hidden" name="group_id" value="#val(VARIABLES.groupItem.id_chat_grupo)#"><button class="btn btn-sm btn-outline-info" title="Sincronizar" <cfif VARIABLES.groupItem.status NEQ 'active'>disabled</cfif>><i class="fa-solid fa-arrows-rotate"></i></button></form><form method="post" class="m-0"><input type="hidden" name="special_groups_csrf" value="#VARIABLES.specialGroupsCsrf#"><input type="hidden" name="manager_request_id" value="#lCase(hash(createUUID(),'SHA-256'))#"><input type="hidden" name="manager_action" value="status"><input type="hidden" name="group_id" value="#val(VARIABLES.groupItem.id_chat_grupo)#"><input type="hidden" name="group_status" value="#(VARIABLES.groupItem.status EQ 'active' ? 'paused' : 'active')#"><button class="btn btn-sm btn-outline-warning" title="#(VARIABLES.groupItem.status EQ 'active' ? 'Pausar' : 'Ativar')#"><i class="fa-solid #(VARIABLES.groupItem.status EQ 'active' ? 'fa-pause' : 'fa-play')#"></i></button></form></div></td></tr></cfoutput></cfloop>
      <cfif NOT arrayLen(VARIABLES.specialGroups)><tr><td colspan="5" class="text-center sg-muted py-4">Nenhum grupo especial criado.</td></tr></cfif>
      </tbody></table></div>
    </div></div>

    <div class="col-12 col-xxl-5"><div class="sg-card">
      <h2 class="h5 mb-1"><cfif VARIABLES.specialGroupsEditing>Editar grupo<cfelse>Novo grupo especial</cfif></h2><p class="small sg-muted mb-3">Use somente critérios catalogados. SQL livre e expressões arbitrárias são recusados pela API.</p>
      <form method="post" id="specialGroupForm">
        <cfoutput><input type="hidden" name="special_groups_csrf" value="#VARIABLES.specialGroupsCsrf#"><input type="hidden" name="manager_request_id" value="#lCase(hash(createUUID(),'SHA-256'))#"><input type="hidden" name="manager_action" id="managerAction" value="#(VARIABLES.specialGroupsEditing ? 'update' : 'create')#"><input type="hidden" name="group_id" value="#(VARIABLES.specialGroupsEditing ? val(VARIABLES.specialGroupsEdit.id_chat_grupo) : 0)#"><input type="hidden" name="policy_json" id="policyJson" value=""></cfoutput>
        <div class="row g-3"><div class="col-12 col-md-8"><label class="form-label">Nome</label><input class="form-control" name="group_name" maxlength="120" required value="<cfif structCount(VARIABLES.specialGroupsEdit)><cfoutput>#htmlEditFormat(VARIABLES.specialGroupsEdit.nome)#</cfoutput></cfif>"></div><div class="col-12 col-md-4"><label class="form-label">Código único</label><input class="form-control" name="group_code" pattern="[a-z0-9][a-z0-9._:-]*" required <cfif VARIABLES.specialGroupsEditing>readonly</cfif> value="<cfif structCount(VARIABLES.specialGroupsEdit)><cfoutput>#htmlEditFormat(VARIABLES.specialGroupsEdit.codigo)#</cfoutput></cfif>"></div><div class="col-12"><label class="form-label">Descrição</label><textarea class="form-control" name="group_description" maxlength="1000" rows="2"><cfif structCount(VARIABLES.specialGroupsEdit)><cfoutput>#htmlEditFormat(VARIABLES.specialGroupsEdit.descricao)#</cfoutput></cfif></textarea></div><div class="col-12 col-md-6"><label class="form-label">ID do atleta dono</label><input class="form-control" type="number" min="1" name="owner_id" required <cfif VARIABLES.specialGroupsEditing>readonly</cfif> value="<cfif structCount(VARIABLES.specialGroupsEdit)><cfoutput>#val(VARIABLES.specialGroupsEdit.id_dono)#</cfoutput></cfif>"><div class="form-text">O dono também deve atender à regra.</div></div><div class="col-12 col-md-6"><label class="form-label">Caminho da foto</label><input class="form-control" name="image_path" maxlength="255" placeholder="/assets/..." value="<cfif structCount(VARIABLES.specialGroupsEdit)><cfoutput>#htmlEditFormat(VARIABLES.specialGroupsEdit.path_imagem)#</cfoutput></cfif>"></div></div>
        <hr class="my-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h3 class="h6 mb-1">Regras de participação</h3><div class="small sg-muted">O atleta precisa atender a <select id="policyOperator" class="form-select form-select-sm d-inline-block w-auto ms-1"><option value="all">todos</option><option value="any">qualquer um</option></select> dos critérios.</div></div><div class="d-flex gap-2"><button class="btn btn-sm btn-outline-info" type="button" id="brasilGigantePreset"><i class="fa-solid fa-wand-magic-sparkles me-1"></i>Brasil Gigante</button><button class="btn btn-sm btn-outline-warning" type="button" id="addCriterion"><i class="fa-solid fa-plus me-1"></i>Critério</button></div></div><div id="criteria" class="d-grid gap-3"></div>
        <div class="form-check mt-3"><input class="form-check-input" type="checkbox" name="invitations_enabled" value="true" id="invitationsEnabled" <cfif structCount(VARIABLES.specialGroupsEdit) AND specialGroupsBoolean(VARIABLES.specialGroupsEdit.convites_habilitados)>checked</cfif>><label class="form-check-label" for="invitationsEnabled">Permitir convites, sempre revalidando a elegibilidade</label></div>
        <cfif NOT VARIABLES.specialGroupsEditing><div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="activate_now" value="true" id="activateNow"><label class="form-check-label" for="activateNow">Ativar e sincronizar imediatamente</label></div></cfif>
        <div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-warning" type="submit"><i class="fa-solid fa-floppy-disk me-2"></i><cfif VARIABLES.specialGroupsEditing>Salvar alterações<cfelse>Criar grupo</cfif></button><button class="btn btn-outline-info" type="submit" data-action="preview"><i class="fa-solid fa-flask me-2"></i>Simular regra</button><cfif VARIABLES.specialGroupsEditing><a class="btn btn-outline-light" href="./">Cancelar</a></cfif></div>
      </form>
      <cfif structKeyExists(VARIABLES.specialGroupsPreview,"eligible_count")><div class="alert alert-info mt-4 mb-0"><strong><cfoutput>#numberFormat(VARIABLES.specialGroupsPreview.eligible_count,'_,___')#</cfoutput> atletas elegíveis.</strong><cfif structKeyExists(VARIABLES.specialGroupsPreview,"sample") AND arrayLen(VARIABLES.specialGroupsPreview.sample)><div class="small mt-2">Amostra: <cfset VARIABLES.sampleIndex=0/><cfloop array="#VARIABLES.specialGroupsPreview.sample#" item="VARIABLES.sampleUser"><cfset VARIABLES.sampleIndex++/><cfoutput>#htmlEditFormat(VARIABLES.sampleUser.nome)#<cfif VARIABLES.sampleIndex LT arrayLen(VARIABLES.specialGroupsPreview.sample)>, </cfif></cfoutput></cfloop></div></cfif></div></cfif>
    </div></div>
  </div>
</section>
<script type="application/json" id="initialSpecialPolicy"><cfoutput>#serializeJSON(structCount(VARIABLES.specialGroupsEdit) ? VARIABLES.specialGroupsEdit.regra : {operator='all',criteria=[]})#</cfoutput></script>
<script>
(()=>{const box=document.getElementById('criteria'),form=document.getElementById('specialGroupForm'),out=document.getElementById('policyJson'),operator=document.getElementById('policyOperator');const labels={challenge:'Inscrição em desafio',validated_result:'Resultado validado',event_checkin:'Agenda ou inscrição em eventos',profile:'Perfil do atleta',badge:'Badge do perfil'};const fields={challenge:[['code','Código do produto/desafio','text']],validated_result:[['aggregator_tag','Tag do agregador','text'],['count_by','Contar por: stage ou event','text'],['distance','Distância (km, 0=todas)','number'],['status_final_max','Status final máximo','number'],['min_count','Quantidade mínima','number']],event_checkin:[['event_ids','IDs dos eventos (vírgula)','text'],['checkin_types','Tipos: calendario,inscricao','text'],['min_count','Quantidade mínima','number']],profile:[['verified','Somente verificados','checkbox'],['countries','Países (BR,...)','text'],['states','UFs (SC,SP,...)','text']],badge:[['badge_codes','Badges (vírgula)','text'],['min_count','Quantidade mínima','number']]};function add(data={type:'challenge'}){const el=document.createElement('div');el.className='sg-rule';el.innerHTML=`<div class="d-flex gap-2 align-items-center mb-3"><select class="form-select form-select-sm sg-type">${Object.entries(labels).map(([v,l])=>`<option value="${v}" ${v===data.type?'selected':''}>${l}</option>`).join('')}</select><button class="btn btn-sm btn-outline-danger sg-remove" type="button" title="Remover"><i class="fa-solid fa-xmark"></i></button></div><div class="sg-rule-fields"></div>`;const render=()=>{const type=el.querySelector('.sg-type').value,target=el.querySelector('.sg-rule-fields');target.innerHTML='';fields[type].forEach(([name,label,inputType])=>{const wrap=document.createElement('label');wrap.className='form-label mb-0';const value=data[name]??(name==='min_count'?1:(name==='status_final_max'?2:(name==='distance'?0:(name==='count_by'?'stage':''))));wrap.innerHTML=inputType==='checkbox'?`<span class="d-block mb-2">${label}</span><input class="form-check-input sg-value" data-name="${name}" type="checkbox" ${value===true?'checked':''}>`:`<span>${label}</span><input class="form-control form-control-sm sg-value" data-name="${name}" type="${inputType}" value="${String(Array.isArray(value)?value.join(','):value).replaceAll('"','&quot;')}">`;target.appendChild(wrap)});data={type}};el.querySelector('.sg-type').addEventListener('change',render);el.querySelector('.sg-remove').addEventListener('click',()=>el.remove());render();box.appendChild(el)}function policy(){return{operator:operator.value,criteria:[...box.querySelectorAll('.sg-rule')].map(el=>{const type=el.querySelector('.sg-type').value,item={type};el.querySelectorAll('.sg-value').forEach(input=>{let value=input.type==='checkbox'?input.checked:input.value.trim();if(['event_ids'].includes(input.dataset.name))value=value.split(',').map(Number).filter(v=>v>0);else if(['checkin_types','countries','states','badge_codes'].includes(input.dataset.name))value=value.split(',').map(v=>v.trim()).filter(Boolean);else if(input.type==='number')value=Number(value);item[input.dataset.name]=value});return item})}}document.getElementById('addCriterion').addEventListener('click',()=>add());document.getElementById('brasilGigantePreset').addEventListener('click',()=>{box.innerHTML='';operator.value='all';add({type:'challenge',code:'circuitobrasilgigante'});add({type:'validated_result',aggregator_tag:'brasil-gigante',count_by:'stage',distance:42,status_final_max:2,min_count:1})});form.addEventListener('submit',e=>{if(!box.children.length){e.preventDefault();alert('Adicione ao menos um critério.');return}out.value=JSON.stringify(policy());document.getElementById('managerAction').value=e.submitter?.dataset.action||document.getElementById('managerAction').defaultValue||document.getElementById('managerAction').value});let initial={operator:'all',criteria:[]};try{initial=JSON.parse(document.getElementById('initialSpecialPolicy').textContent)}catch(e){}operator.value=initial.operator==='any'?'any':'all';(initial.criteria?.length?initial.criteria:[{type:'challenge'}]).forEach(add)})();
</script>
