<style>.vp-card{background:#202124;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:1.2rem;height:100%}.vp-metric{font-size:1.75rem;font-weight:700}.vp-muted{color:#9aa0a6}.vp-dot{width:10px;height:10px;border-radius:50%;display:inline-block}.vp-on{background:#28a745}.vp-off{background:#dc3545}.vp-document-form{overflow:hidden;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(0,0,0,.14)}.vp-form-section{margin:0;padding:1rem 1.1rem;border:0;border-bottom:1px solid rgba(255,255,255,.08)}.vp-form-section legend{display:flex;align-items:center;gap:.55rem;width:auto;margin:0 0 .9rem;padding:0;font-size:.85rem;font-weight:700}.vp-form-section legend>span{display:inline-grid;width:24px;height:24px;place-items:center;border-radius:50%;background:#fab120;color:#202124;font-size:.72rem}.vp-form-section legend small{color:#9aa0a6;font-size:.68rem;font-weight:500}.vp-form-section .form-label{margin-bottom:.35rem;font-size:.78rem;font-weight:700}.vp-form-section .text-warning{font-size:.65rem;font-weight:600}.vp-help{min-height:1.15rem;margin-top:.35rem;color:#9aa0a6!important;font-size:.68rem;line-height:1.35}.vp-form-submit{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.1rem}.vp-form-submit .btn{min-width:250px}@media(max-width:767.98px){.vp-form-submit{align-items:stretch;flex-direction:column}.vp-form-submit .btn{width:100%;min-width:0}}</style>
