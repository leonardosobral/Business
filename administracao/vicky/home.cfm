<style>.vp-card{background:#202124;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:1.2rem;height:100%}.vp-metric{font-size:1.75rem;font-weight:700}.vp-muted{color:#9aa0a6}.vp-dot{width:10px;height:10px;border-radius:50%;display:inline-block}.vp-on{background:#28a745}.vp-off{background:#dc3545}.vp-rule-card{overflow:hidden;height:100%;background:#202124;border:1px solid rgba(255,255,255,.1);border-radius:16px;transition:border-color .2s,box-shadow .2s}.vp-rule-card.is-enabled{border-color:rgba(250,177,32,.36);box-shadow:0 8px 28px rgba(0,0,0,.16)}.vp-rule-head{display:flex;align-items:flex-start;gap:1rem;padding:1.15rem 1.2rem}.vp-rule-icon{display:grid;flex:0 0 42px;width:42px;height:42px;place-items:center;border-radius:12px;background:rgba(250,177,32,.12);color:#fab120}.vp-rule-head .form-switch{padding-top:.35rem}.vp-rule-stats{display:flex;gap:1.25rem;padding:.7rem 1.2rem;border-block:1px solid rgba(255,255,255,.07);background:rgba(0,0,0,.12);color:#9aa0a6;font-size:.76rem}.vp-rule-stats strong{color:#fff;font-size:.9rem}.vp-rule-body{padding:1.15rem 1.2rem}.vp-rule-body .form-label{font-size:.75rem;font-weight:700;color:#b7bbc0}.vp-info-box{display:flex;align-items:flex-start;gap:.55rem;height:100%;padding:.65rem .75rem;border-radius:9px;background:rgba(13,202,240,.08);color:#a8dce6;font-size:.72rem}.vp-rule-messages{border-top:1px solid rgba(255,255,255,.08);padding-top:.9rem}.vp-rule-messages summary{cursor:pointer;color:#fab120;font-size:.82rem;font-weight:700}.vp-rule-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.85rem 1.2rem;border-top:1px solid rgba(255,255,255,.07);background:rgba(0,0,0,.12)}@media(max-width:575.98px){.vp-rule-head{gap:.7rem}.vp-rule-icon{display:none}.vp-rule-stats{gap:.75rem;justify-content:space-between}.vp-rule-footer{align-items:stretch;flex-direction:column}.vp-rule-footer .btn{width:100%}}</style>
<section class="py-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3 mb-1">Vicky Pacer</h1><p class="vp-muted mb-0"><cfif VARIABLES.vickySection EQ "configuracao">Comportamento, limites e ferramentas do agente.<cfelseif VARIABLES.vickySection EQ "conhecimento">Documentos oficiais consultados pela Vicky.<cfelseif VARIABLES.vickySection EQ "canais">Integrações, vínculos e fila dos canais de atendimento.<cfelseif VARIABLES.vickySection EQ "interacoes">Avisos predefinidos, consentimento, programação e entregas.<cfelse>Métricas, execuções e interações auditáveis.</cfif></p></div><cfif VARIABLES.vickySection EQ "auditoria"><form method="get"><input type="hidden" name="secao" value="auditoria"><select class="form-select" name="periodo" onchange="this.form.submit()"><cfloop list="7,30,90" index="p"><cfoutput><option value="#p#"<cfif VARIABLES.vickyPeriod EQ p> selected</cfif>>Últimos #p# dias</option></cfoutput></cfloop></select></form></cfif></div>
<nav class="vp-section-nav nav nav-pills flex-nowrap gap-2 mb-4 overflow-auto" aria-label="Seções do gerenciador da Vicky"><a class="nav-link<cfif VARIABLES.vickySection EQ 'configuracao'> active</cfif>" href="?secao=configuracao"><i class="fa-solid fa-sliders me-2"></i>Configuração</a><a class="nav-link<cfif VARIABLES.vickySection EQ 'conhecimento'> active</cfif>" href="?secao=conhecimento"><i class="fa-solid fa-book me-2"></i>Base de conhecimento</a><a class="nav-link<cfif VARIABLES.vickySection EQ 'canais'> active</cfif>" href="?secao=canais"><i class="fa-brands fa-whatsapp me-2"></i>Canais</a><a class="nav-link<cfif VARIABLES.vickySection EQ 'interacoes'> active</cfif>" href="?secao=interacoes"><i class="fa-solid fa-bell me-2"></i>Interações ativas</a><a class="nav-link<cfif VARIABLES.vickySection EQ 'auditoria'> active</cfif>" href="?secao=auditoria&periodo=<cfoutput>#VARIABLES.vickyPeriod#</cfoutput>"><i class="fa-solid fa-shield-halved me-2"></i>Auditoria</a></nav>
<cfif len(VARIABLES.vickyMessage)><div class="alert alert-<cfoutput>#VARIABLES.vickyMessageType#</cfoutput>"><cfoutput>#encodeForHtml(VARIABLES.vickyMessage)#</cfoutput></div></cfif>
<cfif VARIABLES.vickyReady>
<cfif VARIABLES.vickySection EQ "auditoria"><div class="row g-3 mb-4"><cfoutput><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Execuções</div><div class="vp-metric">#numberFormat(qVickySummary.runs,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Usuários</div><div class="vp-metric">#numberFormat(qVickySummary.users,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Fallbacks</div><div class="vp-metric">#numberFormat(qVickySummary.fallbacks,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Ferramentas</div><div class="vp-metric">#numberFormat(qVickySummary.tool_calls,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Tokens</div><div class="vp-metric">#numberFormat(qVickySummary.input_tokens+qVickySummary.output_tokens,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Latência p50</div><div class="vp-metric">#numberFormat(qVickySummary.median_latency_ms,'_,___')#ms</div></div></div></cfoutput></div></cfif>
<cfif VARIABLES.vickySection EQ "configuracao">
<div class="row g-4 mb-4"><div class="col-12 col-xl-5"><div class="vp-card"><h2 class="h5">Configuração e kill switch</h2><form method="post" class="d-grid gap-3"><input type="hidden" name="action" value="save_config"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="enabled" id="enabled"<cfif qVickyConfig.enabled> checked</cfif>><label class="form-check-label" for="enabled"><span class="vp-dot <cfoutput>#qVickyConfig.enabled?'vp-on':'vp-off'#</cfoutput>"></span> Agente habilitado</label></div><label>Nome<input class="form-control" name="display_name" maxlength="80" value="<cfoutput>#encodeForHtmlAttribute(qVickyConfig.display_name)#</cfoutput>" required></label><label>Modelo<input class="form-control" name="model" maxlength="80" value="<cfoutput>#encodeForHtmlAttribute(qVickyConfig.model)#</cfoutput>" required></label><label>Saudação<textarea class="form-control" name="greeting" maxlength="500" rows="3" required><cfoutput>#encodeForHtml(qVickyConfig.greeting)#</cfoutput></textarea></label><label>Instruções adicionais<textarea class="form-control" name="system_instructions" maxlength="12000" rows="6"><cfoutput>#encodeForHtml(qVickyConfig.system_instructions)#</cfoutput></textarea><small class="vp-muted">As políticas de segurança fixas do RR não podem ser removidas por este campo.</small></label><div class="row g-2"><label class="col">Máx. tokens<input class="form-control" type="number" name="max_output_tokens" min="200" max="4000" value="<cfoutput>#qVickyConfig.max_output_tokens#</cfoutput>"></label><label class="col">Msgs/hora<input class="form-control" type="number" name="max_messages_per_hour" min="1" max="300" value="<cfoutput>#qVickyConfig.max_messages_per_hour#</cfoutput>"></label><label class="col">Retenção (dias)<input class="form-control" type="number" name="retention_days" min="1" max="730" value="<cfoutput>#qVickyConfig.retention_days#</cfoutput>"></label></div><button class="btn btn-warning" type="submit">Salvar configuração</button></form></div></div>
<div class="col-12 col-xl-7"><div class="vp-card"><h2 class="h5">Ferramentas read-only</h2><div class="table-responsive"><table class="table"><thead><tr><th>Ferramenta</th><th class="text-end">Chamadas</th><th class="text-end">Falhas</th><th class="text-end">p50</th></tr></thead><tbody><cfoutput query="qVickyTools"><tr><td>#encodeForHtml(tool_name)#</td><td class="text-end">#calls#</td><td class="text-end">#failures#</td><td class="text-end">#numberFormat(median_ms,'_,___')#ms</td></tr></cfoutput><cfif NOT qVickyTools.recordCount><tr><td colspan="4" class="text-center vp-muted">Sem chamadas no período.</td></tr></cfif></tbody></table></div><hr><h2 class="h5">Volume diário</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Dia</th><th class="text-end">Execuções</th><th class="text-end">Usuários</th><th class="text-end">Fallbacks</th></tr></thead><tbody><cfoutput query="qVickyTimeline"><tr><td>#dateFormat(day,'dd/mm/yyyy')#</td><td class="text-end">#runs#</td><td class="text-end">#users#</td><td class="text-end">#fallbacks#</td></tr></cfoutput></tbody></table></div></div></div></div>
 </cfif>
<cfif VARIABLES.vickySection EQ "conhecimento">
<div class="vp-card mb-4"><div class="d-flex justify-content-between align-items-start gap-3 mb-3"><div><h2 class="h5 mb-1">Base de conhecimento</h2><p class="vp-muted small mb-0">PDFs privados, indexados semanticamente e disponíveis somente após ativação.</p></div><span class="badge bg-secondary"><cfoutput>#qVickyDocuments.recordCount#</cfoutput> documentos</span></div>
  <form method="post" enctype="multipart/form-data" class="vp-document-form mb-4"><input type="hidden" name="action" value="upload_document">
    <fieldset class="vp-form-section"><legend><span>1</span>Escolha o arquivo</legend><div class="row g-3"><div class="col-lg-7"><label class="form-label" for="document_file">Arquivo PDF <strong class="text-warning">obrigatório</strong></label><input class="form-control" id="document_file" type="file" name="document_file" accept="application/pdf,.pdf" aria-describedby="document_file_help" required><div class="form-text vp-help" id="document_file_help">Selecione a norma, regulamento, política ou manual. Apenas PDF, com no máximo 20 MB.</div></div></div></fieldset>
    <fieldset class="vp-form-section"><legend><span>2</span>Identifique o documento</legend><div class="row g-3"><div class="col-lg-7"><label class="form-label" for="document_title">Título oficial <strong class="text-warning">obrigatório</strong></label><input class="form-control" id="document_title" name="document_title" maxlength="240" placeholder="Ex.: Regras de Competição e Técnicas da World Athletics 2026" aria-describedby="document_title_help" required><div class="form-text vp-help" id="document_title_help">Use o título que aparece na capa. A Vicky usará esse nome ao citar a fonte.</div></div><div class="col-lg-5"><label class="form-label" for="document_category">Tipo de conteúdo <strong class="text-warning">obrigatório</strong></label><select class="form-select" id="document_category" name="document_category" aria-describedby="document_category_help" required><option value="" selected disabled>Selecione o tipo</option><option value="normas">Norma técnica — regras oficiais do esporte</option><option value="regulamentos">Regulamento — regras de evento ou competição</option><option value="politicas">Política — diretrizes institucionais</option><option value="manuais">Manual — instruções operacionais</option><option value="outros">Outro documento oficial</option></select><div class="form-text vp-help" id="document_category_help">Ajuda a Vicky a escolher a fonte adequada para cada pergunta.</div></div></div></fieldset>
    <fieldset class="vp-form-section"><legend><span>3</span>Informe a origem e a validade <small>opcional</small></legend><div class="row g-3"><div class="col-lg-5"><label class="form-label" for="document_issuer">Entidade responsável</label><input class="form-control" id="document_issuer" name="document_issuer" maxlength="160" placeholder="Ex.: CBAt ou World Athletics" aria-describedby="document_issuer_help"><div class="form-text vp-help" id="document_issuer_help">Organização que publicou ou mantém o documento.</div></div><div class="col-lg-3"><label class="form-label" for="document_version">Versão ou edição</label><input class="form-control" id="document_version" name="document_version" maxlength="80" placeholder="Ex.: 2026.1" aria-describedby="document_version_help"><div class="form-text vp-help" id="document_version_help">Ano, revisão ou número indicado no PDF.</div></div><div class="col-lg-4"><label class="form-label" for="document_effective_date">Válido a partir de</label><input class="form-control" id="document_effective_date" type="date" name="document_effective_date" aria-describedby="document_effective_help"><div class="form-text vp-help" id="document_effective_help">Data em que as regras começaram ou começarão a valer.</div></div></div></fieldset>
    <div class="vp-form-submit"><div><strong>Depois do envio</strong><div class="vp-muted small">Aguarde a indexação, verifique o processamento e ative o documento.</div></div><button class="btn btn-warning" type="submit"><i class="fa-solid fa-file-arrow-up me-2"></i>Enviar PDF para processamento</button></div>
  </form>
  <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Documento</th><th>Categoria</th><th>Versão/vigência</th><th>Status</th><th>Tamanho</th><th class="text-end">Ações</th></tr></thead><tbody><cfoutput query="qVickyDocuments"><tr><td><strong>#encodeForHtml(titulo)#</strong><div class="small vp-muted">#encodeForHtml(nome_arquivo)#<cfif len(entidade&'')> · #encodeForHtml(entidade)#</cfif></div></td><td>#encodeForHtml(categoria)#</td><td>#encodeForHtml(versao&'')#<cfif isDate(vigencia)><div class="small vp-muted">#dateFormat(vigencia,'dd/mm/yyyy')#</div></cfif></td><td><span class="badge #status EQ 'active'?'bg-success':(status EQ 'failed'?'bg-danger':'bg-secondary')#">#encodeForHtml(status)#</span></td><td>#numberFormat(tamanho_bytes/1048576,'0.0')# MB</td><td class="text-end"><cfif status EQ 'processing'><form method="post" class="d-inline"><input type="hidden" name="action" value="refresh_document"><input type="hidden" name="document_id" value="#id_vicky_documento#"><button class="btn btn-sm btn-outline-light">Verificar processamento</button></form><cfelseif listFindNoCase('active,inactive',status)><form method="post" class="d-inline"><input type="hidden" name="action" value="document_status"><input type="hidden" name="document_id" value="#id_vicky_documento#"><input type="hidden" name="document_status" value="#status EQ 'active'?'inactive':'active'#"><button class="btn btn-sm btn-outline-light">#status EQ 'active'?'Desativar':'Ativar'#</button></form></cfif></td></tr></cfoutput><cfif NOT qVickyDocuments.recordCount><tr><td colspan="6" class="text-center vp-muted py-4">Nenhum documento enviado.</td></tr></cfif></tbody></table></div>
</div>
 </cfif>
<cfif VARIABLES.vickySection EQ "canais">
<div class="row g-4"><div class="col-12 col-xl-5"><div class="vp-card"><h2 class="h5">Manychat / WhatsApp</h2><p class="vp-muted small">O canal só funciona quando esta chave e os segredos do ambiente Road Runners estiverem ativos.</p><form method="post" class="d-grid gap-3"><input type="hidden" name="action" value="save_manychat"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="manychat_enabled" id="manychat_enabled"<cfif qVickyManychatConfig.enabled> checked</cfif>><label class="form-check-label" for="manychat_enabled">Canal habilitado</label></div><label>Nome da conta<input class="form-control" name="account_label" maxlength="120" value="<cfoutput>#encodeForHtmlAttribute(qVickyManychatConfig.account_label)#</cfoutput>" required></label><label>Trigger de resposta<input class="form-control" name="trigger_name" maxlength="120" value="<cfoutput>#encodeForHtmlAttribute(qVickyManychatConfig.trigger_name)#</cfoutput>" required><small class="vp-muted">Deve ser idêntico ao trigger instalado no Manychat App.</small></label><label>Tentativas por mensagem<input class="form-control" type="number" name="max_attempts" min="1" max="10" value="<cfoutput>#qVickyManychatConfig.max_attempts#</cfoutput>"></label><button class="btn btn-warning" type="submit">Salvar canal</button></form></div></div>
<div class="col-12 col-xl-7"><div class="row g-3 mb-3"><cfoutput><div class="col-4"><div class="vp-card"><div class="vp-muted">Vínculos</div><div class="vp-metric">#qVickyManychatSummary.total#</div></div></div><div class="col-4"><div class="vp-card"><div class="vp-muted">Ativos</div><div class="vp-metric">#qVickyManychatSummary.active#</div></div></div><div class="col-4"><div class="vp-card"><div class="vp-muted">Pendentes</div><div class="vp-metric">#qVickyManychatSummary.pending#</div></div></div></cfoutput></div><div class="vp-card"><h2 class="h5">Fila recente</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Data</th><th>Canal</th><th>Contato</th><th>Status</th><th>Tentativas</th><th>Erro</th></tr></thead><tbody><cfoutput query="qVickyManychatQueue"><tr><td>#dateTimeFormat(created_at,'dd/mm/yyyy HH:nn')#</td><td>#encodeForHtml(channel)#</td><td>…#encodeForHtml(right(subscriber_id,6))#</td><td>#encodeForHtml(status)#</td><td>#attempts#</td><td>#encodeForHtml(error_code&'')#</td></tr></cfoutput><cfif NOT qVickyManychatQueue.recordCount><tr><td colspan="6" class="text-center vp-muted">Nenhuma mensagem recebida.</td></tr></cfif></tbody></table></div></div></div></div>
</cfif>
<cfif VARIABLES.vickySection EQ "interacoes">
<div class="row g-3 mb-4"><cfoutput><div class="col-6 col-xl"><div class="vp-card"><div class="vp-muted">Programadas</div><div class="vp-metric">#qVickyProactiveSummary.total#</div></div></div><div class="col-6 col-xl"><div class="vp-card"><div class="vp-muted">Concluídas</div><div class="vp-metric">#qVickyProactiveSummary.completed#</div></div></div><div class="col-6 col-xl"><div class="vp-card"><div class="vp-muted">Na fila</div><div class="vp-metric">#qVickyProactiveSummary.queued#</div></div></div><div class="col-6 col-xl"><div class="vp-card"><div class="vp-muted">Falhas</div><div class="vp-metric">#qVickyProactiveSummary.failed#</div></div></div><div class="col-6 col-xl"><div class="vp-card"><div class="vp-muted">Usuários</div><div class="vp-metric">#qVickyProactiveSummary.users#</div></div></div></cfoutput></div>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3"><div><h2 class="h4 mb-1">Regras automáticas</h2><p class="vp-muted mb-0">Configure o gatilho, público, canais e mensagem de cada interação. As mensagens são determinísticas e não consomem tokens de IA.</p></div><span class="badge rounded-pill text-bg-secondary"><cfoutput>#qVickyProactiveRules.recordCount# regras disponíveis</cfoutput></span></div>
<div class="row g-4 mb-4"><cfoutput query="qVickyProactiveRules"><cfset VARIABLES.ruleWeb=""/><cfset VARIABLES.ruleWhatsapp=""/><cfset VARIABLES.ruleProvider=""/><cfset VARIABLES.ruleIcon=trigger_type EQ "result_published"?"fa-medal":(trigger_type EQ "agenda_added"?"fa-calendar-plus":"fa-calendar-check")/><cfset VARIABLES.ruleDescription=trigger_type EQ "result_published"?"Avisa após resultados oficiais serem publicados para uma prova que já estava na agenda.":(trigger_type EQ "agenda_added"?"Confirma a inclusão de um evento futuro e explica os próximos avisos.":"Lembra o usuário antes de um evento salvo na agenda.")/><cfset VARIABLES.ruleInfo=trigger_type EQ "agenda_added"?"Dispara somente para eventos futuros adicionados depois da ativação desta regra.":"Exige evento passado, agenda anterior à prova e resultados oficiais processados após a criação da regra."/><cfloop query="qVickyProactiveTemplates"><cfif codigo EQ qVickyProactiveRules.codigo><cfif channel EQ "web"><cfset VARIABLES.ruleWeb=content&""/><cfelseif channel EQ "whatsapp"><cfset VARIABLES.ruleWhatsapp=content&""/><cfset VARIABLES.ruleProvider=provider_template_name&""/></cfif></cfif></cfloop><div class="col-12 col-xxl-6"><article class="vp-rule-card #enabled?'is-enabled':'is-disabled'#"><form method="post"><input type="hidden" name="action" value="save_proactive_rule"><input type="hidden" name="rule_code" value="#encodeForHtmlAttribute(codigo)#"><header class="vp-rule-head"><div class="vp-rule-icon"><i class="fa-solid #VARIABLES.ruleIcon#"></i></div><div class="flex-grow-1"><div class="d-flex flex-wrap align-items-center gap-2"><h3 class="h5 mb-0">#encodeForHtml(nome)#</h3><span class="badge #enabled?'text-bg-success':'text-bg-secondary'#">#enabled?'Ativa':'Inativa'#</span></div><p class="vp-muted small mb-0 mt-1">#VARIABLES.ruleDescription#</p></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" id="enabled_#codigo#" name="rule_enabled"<cfif enabled> checked</cfif>><label class="visually-hidden" for="enabled_#codigo#">Ativar regra</label></div></header><div class="vp-rule-stats"><span><strong>#total#</strong> geradas</span><span><strong>#completed#</strong> entregues</span><span><strong>#failed#</strong> falhas</span></div><div class="vp-rule-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Público</label><div class="form-check"><input class="form-check-input" type="checkbox" id="admin_#codigo#" name="admin_only"<cfif admin_only> checked</cfif>><label class="form-check-label" for="admin_#codigo#">Somente administradores</label></div></div><div class="col-md-6"><label class="form-label">Canais</label><div class="d-flex flex-wrap gap-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="web_#codigo#" name="web_enabled"<cfif web_enabled> checked</cfif>><label class="form-check-label" for="web_#codigo#">Chat web</label></div><div class="form-check"><input class="form-check-input" type="checkbox" id="wa_#codigo#" name="whatsapp_enabled"<cfif whatsapp_enabled> checked</cfif>><label class="form-check-label" for="wa_#codigo#">WhatsApp</label></div></div></div><cfif trigger_type EQ "agenda_d7"><div class="col-6 col-md-3"><label class="form-label">Dias antes</label><input class="form-control" type="number" name="days_before" min="0" max="365" value="#days_before#"></div><cfelse><input type="hidden" name="days_before" value="0"><div class="col-12 col-md-6"><div class="vp-info-box"><i class="fa-solid fa-circle-info"></i><span>#encodeForHtml(VARIABLES.ruleInfo)#</span></div></div></cfif><div class="col-6 col-md-3"><label class="form-label">Máximo por dia</label><input class="form-control" type="number" name="max_per_day" min="1" max="20" value="#max_per_day#"></div><div class="col-6 col-md-3"><label class="form-label">Silêncio inicia</label><input class="form-control" type="time" name="quiet_start" value="#timeFormat(quiet_start,'HH:mm')#"></div><div class="col-6 col-md-3"><label class="form-label">Silêncio termina</label><input class="form-control" type="time" name="quiet_end" value="#timeFormat(quiet_end,'HH:mm')#"></div></div><details class="vp-rule-messages mt-3"><summary>Personalizar mensagens e template</summary><div class="d-grid gap-3 pt-3"><label>Mensagem no chat web<textarea class="form-control" name="web_content" rows="3" maxlength="2000" required>#encodeForHtml(VARIABLES.ruleWeb)#</textarea></label><label>Mensagem no WhatsApp<textarea class="form-control" name="whatsapp_content" rows="3" maxlength="2000" required>#encodeForHtml(VARIABLES.ruleWhatsapp)#</textarea></label><label>Template aprovado no ManyChat<input class="form-control" name="provider_template_name" maxlength="160" value="#encodeForHtmlAttribute(VARIABLES.ruleProvider)#"><small class="vp-muted">Variáveis disponíveis: <code>{{event_name}}</code>, <code>{{event_tag}}</code> e <code>{{event_date}}</code>.</small></label></div></details></div><footer class="vp-rule-footer"><small class="vp-muted">Código: #encodeForHtml(codigo)#</small><button class="btn btn-warning" type="submit"><i class="fa-solid fa-floppy-disk me-2"></i>Salvar regra</button></footer></form></article></div></cfoutput></div>
<div class="vp-card mb-4"><div class="row align-items-center g-4"><div class="col-lg-4"><h2 class="h5 mb-1">Seu usuário de validação</h2><p class="vp-muted small mb-0">Estas preferências afetam somente o administrador atualmente autenticado. O WhatsApp exige vínculo ativo e consentimento explícito.</p></div><div class="col-lg-8"><form method="post" class="d-flex flex-wrap align-items-center justify-content-lg-end gap-3"><input type="hidden" name="action" value="save_proactive_preference"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="test_web" id="test_web"<cfif NOT qVickyProactivePreference.recordCount OR qVickyProactivePreference.web_enabled> checked</cfif>><label class="form-check-label" for="test_web">Chat web</label></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="test_whatsapp" id="test_whatsapp"<cfif qVickyProactivePreference.recordCount AND qVickyProactivePreference.whatsapp_enabled> checked</cfif>><label class="form-check-label" for="test_whatsapp">WhatsApp</label></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="test_agenda" id="test_agenda"<cfif NOT qVickyProactivePreference.recordCount OR qVickyProactivePreference.agenda_enabled> checked</cfif>><label class="form-check-label" for="test_agenda">Lembretes</label></div><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="test_results" id="test_results"<cfif NOT qVickyProactivePreference.recordCount OR qVickyProactivePreference.results_enabled> checked</cfif>><label class="form-check-label" for="test_results">Resultados</label></div><button class="btn btn-outline-warning" type="submit">Salvar preferências</button></form></div></div></div>
<div class="vp-card"><div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-3"><div><h2 class="h5 mb-1">Fila e auditoria de entregas</h2><p class="vp-muted small mb-0">Últimas 100 interações, incluindo tentativas e motivo de falha ou supressão.</p></div></div><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Data</th><th>Regra</th><th>Usuário</th><th>Canal</th><th>Status</th><th>Tentativas</th><th>Erro</th></tr></thead><tbody><cfoutput query="qVickyProactiveQueue"><tr><td>#dateTimeFormat(created_at,'dd/mm/yyyy HH:nn')#</td><td>#encodeForHtml(nome)#</td><td>###id_usuario# · #encodeForHtml(usuario_nome)#</td><td><span class="badge text-bg-dark">#encodeForHtml(channel)#</span></td><td><span class="badge #status EQ 'completed'?'text-bg-success':(listFindNoCase('failed,dead_letter',status)?'text-bg-danger':'text-bg-secondary')#">#encodeForHtml(status)#</span></td><td>#attempts#</td><td>#encodeForHtml(error_code&'')#</td></tr></cfoutput><cfif NOT qVickyProactiveQueue.recordCount><tr><td colspan="7" class="text-center vp-muted py-4">Nenhuma interação programada.</td></tr></cfif></tbody></table></div></div>
</cfif>
<cfif VARIABLES.vickySection EQ "auditoria">
<div class="vp-card"><h2 class="h5">Auditoria de execuções</h2><p class="vp-muted small">A listagem não expõe conversas. A abertura de detalhes é restrita a admin e registrada em <code>tb_vicky_audit_access</code>. Argumentos de ferramentas guardam apenas nomes de campos; resultados, status e contagens.</p><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Data</th><th>Usuário</th><th>Status</th><th>Modelo</th><th class="text-end">Tools</th><th class="text-end">Tokens</th><th class="text-end">Latência</th><th></th></tr></thead><tbody><cfoutput query="qVickyRuns"><tr><td>#dateTimeFormat(created_at,'dd/mm/yyyy HH:nn')#</td><td>###id_usuario# · #encodeForHtml(user_name)#</td><td>#encodeForHtml(status)#<cfif len(error_code&'')><div class="small text-danger">#encodeForHtml(error_code)#</div></cfif></td><td>#encodeForHtml(model)#</td><td class="text-end">#tool_calls#</td><td class="text-end">#input_tokens+output_tokens#</td><td class="text-end">#latency_ms#ms</td><td><a class="btn btn-sm btn-outline-light" href="?periodo=#VARIABLES.vickyPeriod#&execucao=#id_vicky_execucao#">Auditar</a></td></tr></cfoutput></tbody></table></div><cfif qVickyInteraction.recordCount><hr><div class="alert alert-warning small"><strong>Conteúdo sensível:</strong> este acesso administrativo foi registrado. Use-o somente para segurança, qualidade ou atendimento autorizado.</div><div class="row g-3"><div class="col-md-6"><h3 class="h6">Usuário</h3><div class="p-3 rounded bg-black bg-opacity-25" style="white-space:pre-wrap"><cfoutput>#encodeForHtml(qVickyInteraction.user_content&'')#</cfoutput></div></div><div class="col-md-6"><h3 class="h6">Vicky</h3><div class="p-3 rounded bg-black bg-opacity-25" style="white-space:pre-wrap"><cfoutput>#encodeForHtml(qVickyInteraction.assistant_content&'')#</cfoutput></div></div></div></cfif><cfif qVickyAudit.recordCount><hr><h3 class="h6">Ferramentas da execução <cfoutput>###val(URL.execucao)#</cfoutput></h3><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Ferramenta</th><th>Status</th><th>Argumentos sanitizados</th><th>Resultado resumido</th><th>Latência</th></tr></thead><tbody><cfoutput query="qVickyAudit"><tr><td>#encodeForHtml(tool_name)#</td><td>#encodeForHtml(status)#</td><td><code>#encodeForHtml(arguments_summary&'')#</code></td><td><code>#encodeForHtml(result_summary&'')#</code></td><td>#latency_ms#ms</td></tr></cfoutput></tbody></table></div></cfif></div>
 </cfif>
</cfif></section>
