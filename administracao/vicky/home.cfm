<style>.vp-card{background:#202124;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:1.2rem;height:100%}.vp-metric{font-size:1.75rem;font-weight:700}.vp-muted{color:#9aa0a6}.vp-dot{width:10px;height:10px;border-radius:50%;display:inline-block}.vp-on{background:#28a745}.vp-off{background:#dc3545}</style>
<section class="py-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3 mb-1">Vicky Pacer</h1><p class="vp-muted mb-0"><cfif VARIABLES.vickySection EQ "configuracao">Comportamento, limites e ferramentas do agente.<cfelseif VARIABLES.vickySection EQ "conhecimento">Documentos oficiais consultados pela Vicky.<cfelse>Métricas, execuções e interações auditáveis.</cfif></p></div><cfif VARIABLES.vickySection EQ "auditoria"><form method="get"><input type="hidden" name="secao" value="auditoria"><select class="form-select" name="periodo" onchange="this.form.submit()"><cfloop list="7,30,90" index="p"><cfoutput><option value="#p#"<cfif VARIABLES.vickyPeriod EQ p> selected</cfif>>Últimos #p# dias</option></cfoutput></cfloop></select></form></cfif></div>
<nav class="vp-section-nav nav nav-pills flex-nowrap gap-2 mb-4 overflow-auto" aria-label="Seções do gerenciador da Vicky"><a class="nav-link<cfif VARIABLES.vickySection EQ 'configuracao'> active</cfif>" href="?secao=configuracao"><i class="fa-solid fa-sliders me-2"></i>Configuração</a><a class="nav-link<cfif VARIABLES.vickySection EQ 'conhecimento'> active</cfif>" href="?secao=conhecimento"><i class="fa-solid fa-book me-2"></i>Base de conhecimento</a><a class="nav-link<cfif VARIABLES.vickySection EQ 'auditoria'> active</cfif>" href="?secao=auditoria&periodo=<cfoutput>#VARIABLES.vickyPeriod#</cfoutput>"><i class="fa-solid fa-shield-halved me-2"></i>Auditoria</a></nav>
<cfif len(VARIABLES.vickyMessage)><div class="alert alert-<cfoutput>#VARIABLES.vickyMessageType#</cfoutput>"><cfoutput>#encodeForHtml(VARIABLES.vickyMessage)#</cfoutput></div></cfif>
<cfif VARIABLES.vickyReady>
<cfif VARIABLES.vickySection EQ "auditoria"><div class="row g-3 mb-4"><cfoutput><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Execuções</div><div class="vp-metric">#numberFormat(qVickySummary.runs,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Usuários</div><div class="vp-metric">#numberFormat(qVickySummary.users,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Fallbacks</div><div class="vp-metric">#numberFormat(qVickySummary.fallbacks,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Ferramentas</div><div class="vp-metric">#numberFormat(qVickySummary.tool_calls,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Tokens</div><div class="vp-metric">#numberFormat(qVickySummary.input_tokens+qVickySummary.output_tokens,'_,___')#</div></div></div><div class="col-6 col-xl-2"><div class="vp-card"><div class="vp-muted">Latência p50</div><div class="vp-metric">#numberFormat(qVickySummary.median_latency_ms,'_,___')#ms</div></div></div></cfoutput></div></cfif>
<cfif VARIABLES.vickySection EQ "configuracao">
<div class="row g-4 mb-4"><div class="col-12 col-xl-5"><div class="vp-card"><h2 class="h5">Configuração e kill switch</h2><form method="post" class="d-grid gap-3"><input type="hidden" name="action" value="save_config"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="enabled" id="enabled"<cfif qVickyConfig.enabled> checked</cfif>><label class="form-check-label" for="enabled"><span class="vp-dot <cfoutput>#qVickyConfig.enabled?'vp-on':'vp-off'#</cfoutput>"></span> Agente habilitado</label></div><label>Nome<input class="form-control" name="display_name" maxlength="80" value="<cfoutput>#encodeForHtmlAttribute(qVickyConfig.display_name)#</cfoutput>" required></label><label>Modelo<input class="form-control" name="model" maxlength="80" value="<cfoutput>#encodeForHtmlAttribute(qVickyConfig.model)#</cfoutput>" required></label><label>Saudação<textarea class="form-control" name="greeting" maxlength="500" rows="3" required><cfoutput>#encodeForHtml(qVickyConfig.greeting)#</cfoutput></textarea></label><label>Instruções adicionais<textarea class="form-control" name="system_instructions" maxlength="12000" rows="6"><cfoutput>#encodeForHtml(qVickyConfig.system_instructions)#</cfoutput></textarea><small class="vp-muted">As políticas de segurança fixas do RR não podem ser removidas por este campo.</small></label><div class="row g-2"><label class="col">Máx. tokens<input class="form-control" type="number" name="max_output_tokens" min="200" max="4000" value="<cfoutput>#qVickyConfig.max_output_tokens#</cfoutput>"></label><label class="col">Msgs/hora<input class="form-control" type="number" name="max_messages_per_hour" min="1" max="300" value="<cfoutput>#qVickyConfig.max_messages_per_hour#</cfoutput>"></label><label class="col">Retenção (dias)<input class="form-control" type="number" name="retention_days" min="1" max="730" value="<cfoutput>#qVickyConfig.retention_days#</cfoutput>"></label></div><button class="btn btn-warning" type="submit">Salvar configuração</button></form></div></div>
<div class="col-12 col-xl-7"><div class="vp-card"><h2 class="h5">Ferramentas read-only</h2><div class="table-responsive"><table class="table"><thead><tr><th>Ferramenta</th><th class="text-end">Chamadas</th><th class="text-end">Falhas</th><th class="text-end">p50</th></tr></thead><tbody><cfoutput query="qVickyTools"><tr><td>#encodeForHtml(tool_name)#</td><td class="text-end">#calls#</td><td class="text-end">#failures#</td><td class="text-end">#numberFormat(median_ms,'_,___')#ms</td></tr></cfoutput><cfif NOT qVickyTools.recordCount><tr><td colspan="4" class="text-center vp-muted">Sem chamadas no período.</td></tr></cfif></tbody></table></div><hr><h2 class="h5">Volume diário</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Dia</th><th class="text-end">Execuções</th><th class="text-end">Usuários</th><th class="text-end">Fallbacks</th></tr></thead><tbody><cfoutput query="qVickyTimeline"><tr><td>#dateFormat(day,'dd/mm/yyyy')#</td><td class="text-end">#runs#</td><td class="text-end">#users#</td><td class="text-end">#fallbacks#</td></tr></cfoutput></tbody></table></div></div></div></div>
 </cfif>
<cfif VARIABLES.vickySection EQ "conhecimento">
<div class="vp-card mb-4"><div class="d-flex justify-content-between align-items-start gap-3 mb-3"><div><h2 class="h5 mb-1">Base de conhecimento</h2><p class="vp-muted small mb-0">PDFs privados, indexados semanticamente e disponíveis somente após ativação.</p></div><span class="badge bg-secondary"><cfoutput>#qVickyDocuments.recordCount#</cfoutput> documentos</span></div>
  <form method="post" enctype="multipart/form-data" class="vp-document-form mb-4"><input type="hidden" name="action" value="upload_document">
    <fieldset class="vp-form-section"><legend><span>1</span>Escolha o arquivo</legend><div class="row g-3"><div class="col-lg-7"><label class="form-label" for="document_file">Arquivo PDF <strong class="text-warning">obrigatório</strong></label><input class="form-control" id="document_file" type="file" name="document_file" accept="application/pdf,.pdf" aria-describedby="document_file_help" required><div class="form-text vp-help" id="document_file_help">Selecione a norma, regulamento, política ou manual. Apenas PDF, com no máximo 20 MB.</div></div></div></fieldset>
    <fieldset class="vp-form-section"><legend><span>2</span>Identifique o documento</legend><div class="row g-3"><div class="col-lg-7"><label class="form-label" for="document_title">Título oficial <strong class="text-warning">obrigatório</strong></label><input class="form-control" id="document_title" name="document_title" maxlength="240" placeholder="Ex.: Regras de Competição e Técnicas da World Athletics 2026" aria-describedby="document_title_help" required><div class="form-text vp-help" id="document_title_help">Use o título que aparece na capa. A Vicky usará esse nome ao citar a fonte.</div></div><div class="col-lg-5"><label class="form-label" for="document_category">Tipo de conteúdo <strong class="text-warning">obrigatório</strong></label><select class="form-select" id="document_category" name="document_category" aria-describedby="document_category_help" required><option value="" selected disabled>Selecione o tipo</option><option value="normas">Norma técnica — regras oficiais do esporte</option><option value="regulamentos">Regulamento — regras de evento ou competição</option><option value="politicas">Política — diretrizes institucionais</option><option value="manuais">Manual — instruções operacionais</option><option value="outros">Outro documento oficial</option></select><div class="form-text vp-help" id="document_category_help">Ajuda a Vicky a escolher a fonte adequada para cada pergunta.</div></div></div></fieldset>
    <fieldset class="vp-form-section"><legend><span>3</span>Informe a origem e a validade <small>opcional</small></legend><div class="row g-3"><div class="col-lg-5"><label class="form-label" for="document_issuer">Entidade responsável</label><input class="form-control" id="document_issuer" name="document_issuer" maxlength="160" placeholder="Ex.: CBAt ou World Athletics" aria-describedby="document_issuer_help"><div class="form-text vp-help" id="document_issuer_help">Organização que publicou ou mantém o documento.</div></div><div class="col-lg-3"><label class="form-label" for="document_version">Versão ou edição</label><input class="form-control" id="document_version" name="document_version" maxlength="80" placeholder="Ex.: 2026.1" aria-describedby="document_version_help"><div class="form-text vp-help" id="document_version_help">Ano, revisão ou número indicado no PDF.</div></div><div class="col-lg-4"><label class="form-label" for="document_effective_date">Válido a partir de</label><input class="form-control" id="document_effective_date" type="date" name="document_effective_date" aria-describedby="document_effective_help"><div class="form-text vp-help" id="document_effective_help">Data em que as regras começaram ou começarão a valer.</div></div></div></fieldset>
    <div class="vp-form-submit"><div><strong>Depois do envio</strong><div class="vp-muted small">Aguarde a indexação, verifique o processamento e ative o documento.</div></div><button class="btn btn-warning" type="submit"><i class="fa-solid fa-file-arrow-up me-2"></i>Enviar PDF para processamento</button></div>
  </form>
  <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Documento</th><th>Categoria</th><th>Versão/vigência</th><th>Status</th><th>Tamanho</th><th class="text-end">Ações</th></tr></thead><tbody><cfoutput query="qVickyDocuments"><tr><td><strong>#encodeForHtml(titulo)#</strong><div class="small vp-muted">#encodeForHtml(nome_arquivo)#<cfif len(entidade&'')> · #encodeForHtml(entidade)#</cfif></div></td><td>#encodeForHtml(categoria)#</td><td>#encodeForHtml(versao&'')#<cfif isDate(vigencia)><div class="small vp-muted">#dateFormat(vigencia,'dd/mm/yyyy')#</div></cfif></td><td><span class="badge #status EQ 'active'?'bg-success':(status EQ 'failed'?'bg-danger':'bg-secondary')#">#encodeForHtml(status)#</span></td><td>#numberFormat(tamanho_bytes/1048576,'0.0')# MB</td><td class="text-end"><cfif status EQ 'processing'><form method="post" class="d-inline"><input type="hidden" name="action" value="refresh_document"><input type="hidden" name="document_id" value="#id_vicky_documento#"><button class="btn btn-sm btn-outline-light">Verificar processamento</button></form><cfelseif listFindNoCase('active,inactive',status)><form method="post" class="d-inline"><input type="hidden" name="action" value="document_status"><input type="hidden" name="document_id" value="#id_vicky_documento#"><input type="hidden" name="document_status" value="#status EQ 'active'?'inactive':'active'#"><button class="btn btn-sm btn-outline-light">#status EQ 'active'?'Desativar':'Ativar'#</button></form></cfif></td></tr></cfoutput><cfif NOT qVickyDocuments.recordCount><tr><td colspan="6" class="text-center vp-muted py-4">Nenhum documento enviado.</td></tr></cfif></tbody></table></div>
</div>
 </cfif>
<cfif VARIABLES.vickySection EQ "auditoria">
<div class="vp-card"><h2 class="h5">Auditoria de execuções</h2><p class="vp-muted small">A listagem não expõe conversas. A abertura de detalhes é restrita a admin e registrada em <code>tb_vicky_audit_access</code>. Argumentos de ferramentas guardam apenas nomes de campos; resultados, status e contagens.</p><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Data</th><th>Usuário</th><th>Status</th><th>Modelo</th><th class="text-end">Tools</th><th class="text-end">Tokens</th><th class="text-end">Latência</th><th></th></tr></thead><tbody><cfoutput query="qVickyRuns"><tr><td>#dateTimeFormat(created_at,'dd/mm/yyyy HH:nn')#</td><td>###id_usuario# · #encodeForHtml(user_name)#</td><td>#encodeForHtml(status)#<cfif len(error_code&'')><div class="small text-danger">#encodeForHtml(error_code)#</div></cfif></td><td>#encodeForHtml(model)#</td><td class="text-end">#tool_calls#</td><td class="text-end">#input_tokens+output_tokens#</td><td class="text-end">#latency_ms#ms</td><td><a class="btn btn-sm btn-outline-light" href="?periodo=#VARIABLES.vickyPeriod#&execucao=#id_vicky_execucao#">Auditar</a></td></tr></cfoutput></tbody></table></div><cfif qVickyInteraction.recordCount><hr><div class="alert alert-warning small"><strong>Conteúdo sensível:</strong> este acesso administrativo foi registrado. Use-o somente para segurança, qualidade ou atendimento autorizado.</div><div class="row g-3"><div class="col-md-6"><h3 class="h6">Usuário</h3><div class="p-3 rounded bg-black bg-opacity-25" style="white-space:pre-wrap"><cfoutput>#encodeForHtml(qVickyInteraction.user_content&'')#</cfoutput></div></div><div class="col-md-6"><h3 class="h6">Vicky</h3><div class="p-3 rounded bg-black bg-opacity-25" style="white-space:pre-wrap"><cfoutput>#encodeForHtml(qVickyInteraction.assistant_content&'')#</cfoutput></div></div></div></cfif><cfif qVickyAudit.recordCount><hr><h3 class="h6">Ferramentas da execução <cfoutput>###val(URL.execucao)#</cfoutput></h3><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Ferramenta</th><th>Status</th><th>Argumentos sanitizados</th><th>Resultado resumido</th><th>Latência</th></tr></thead><tbody><cfoutput query="qVickyAudit"><tr><td>#encodeForHtml(tool_name)#</td><td>#encodeForHtml(status)#</td><td><code>#encodeForHtml(arguments_summary&'')#</code></td><td><code>#encodeForHtml(result_summary&'')#</code></td><td>#latency_ms#ms</td></tr></cfoutput></tbody></table></div></cfif></div>
 </cfif>
</cfif></section>
