<cfif NOT structKeyExists(REQUEST,'comparadorAdminPage')><cfheader statuscode="403"><cfabort></cfif>
<style>
.comparador-admin{max-width:1500px;padding-bottom:3rem}.resumo-comparador .metric,.resumo-comparador .panel,.resumo-comparador .filters{border:1px solid rgba(255,255,255,.12);border-radius:8px;background:rgba(255,255,255,.03);padding:1rem}.resumo-comparador .metric{height:100%}.resumo-comparador .metric-label{font-size:.75rem;text-transform:uppercase;font-weight:700;color:var(--mdb-secondary-color)}.resumo-comparador .progress{height:6px}.resumo-comparador .metric-value{font-size:1.75rem;font-weight:700}.resumo-comparador .table td{vertical-align:middle}.resumo-comparador .table-responsive{max-width:100%}.resumo-comparador .queue-table{min-width:650px}.resumo-comparador .queue-model{min-width:200px;max-width:310px;overflow-wrap:anywhere}.resumo-comparador .small-note{font-size:.85rem;color:var(--mdb-secondary-color)}.resumo-comparador .field-link{color:inherit;text-decoration:none}.resumo-comparador .field-link:hover{text-decoration:underline}.resumo-comparador .priority-count{font-size:1.35rem;font-weight:700}.resumo-comparador .filters label{font-weight:600;margin-bottom:.35rem}.resumo-comparador .nav-link{white-space:nowrap}
</style>
<section class="resumo-comparador">
<div class="d-flex flex-wrap justify-content-between gap-3 mb-3"><div><h1 class="h3 mb-1">Resumo do Comparador</h1><p class="text-muted mb-0">O que já temos na base e onde concentrar a próxima revisão.</p></div><a href="/administracao/comparador/" class="btn btn-outline-light align-self-start">Gerenciar produtos</a></div>
<cfinclude template="../includes/navigation.cfm">
<cfif len(resumoError)><div class="alert alert-warning" role="alert"><cfoutput>#encodeForHTML(resumoError)#</cfoutput></div>
<cfelse>
<cfset rd=resumoData><cfset rf=rd.filters><cfset rs=rd.stats>
<cfset resumoScopeNames={comerciais='Comerciais ativos',publicados='Publicados',rascunhos='Rascunhos',prototipos='Protótipos ativos',arquivados='Arquivados',todos='Todo o acervo'}>
<cfset resumoTypeLabel='Todos os tipos'><cfloop array="#rd.typeOptions#" index="resumoTypeOption"><cfif resumoTypeOption.tag EQ rf.tipo><cfset resumoTypeLabel=resumoTypeOption.nome></cfif></cfloop>
<cfoutput>
<div class="small-note mb-3">Base geral, todos os tipos: <strong>#resumoNumber(rd.overall.total)# produtos</strong> · #resumoNumber(rd.overall.publicado)# publicados · #resumoNumber(rd.overall.rascunho)# rascunhos · #resumoNumber(rd.overall.arquivado)# arquivados. Os #resumoNumber(rd.overall.prototipos)# protótipos ativos são um subconjunto. Consultado em #rd.consultado#.</div>
<details class="filters mb-3"><summary class="fw-semibold">Filtros: #encodeForHTML(resumoTypeLabel)# · #resumoScopeNames[rf.escopo]#<cfif rf.mercado EQ 'brasil'> · Marcas no Brasil</cfif><cfif len(rf.marca)> · #encodeForHTML(rf.marca)#</cfif><cfif len(rf.busca)> · Busca ativa</cfif><span class="small-note ms-2">Ajustar</span></summary><form method="get" class="mt-3"><input type="hidden" name="aba" value="#rf.aba#"><input type="hidden" name="falta" value="#rf.falta#">
<div class="row g-3 align-items-end">
<div class="col-12 col-md-3"><label for="resumo-tipo">Tipo de produto</label><select id="resumo-tipo" name="tipo" class="form-select"><option value="todos" <cfif rf.tipo EQ 'todos'>selected</cfif>>Todos os tipos</option><cfloop array="#rd.typeOptions#" index="option"><option value="#encodeForHTMLAttribute(option.tag)#" <cfif rf.tipo EQ option.tag>selected</cfif>>#encodeForHTML(option.nome)#</option></cfloop></select></div>
<div class="col-12 col-md-3"><label for="resumo-escopo">Recorte</label><select id="resumo-escopo" name="escopo" class="form-select"><cfloop array="#[{tag='comerciais',nome='Comerciais ativos'},{tag='publicados',nome='Publicados'},{tag='rascunhos',nome='Rascunhos'},{tag='prototipos',nome='Protótipos ativos'},{tag='arquivados',nome='Arquivados'},{tag='todos',nome='Todo o acervo'}]#" index="option"><option value="#option.tag#" <cfif rf.escopo EQ option.tag>selected</cfif>>#option.nome#</option></cfloop></select></div>
<div class="col-12 col-md-3"><label for="resumo-mercado">Presença da marca</label><select id="resumo-mercado" name="mercado" class="form-select"><option value="todos" <cfif rf.mercado EQ 'todos'>selected</cfif>>Todas</option><option value="brasil" <cfif rf.mercado EQ 'brasil'>selected</cfif>>Marcada no Brasil</option><option value="sem_marcacao" <cfif rf.mercado EQ 'sem_marcacao'>selected</cfif>>Sem marcação no Brasil</option></select></div>
<div class="col-12 col-md-3"><label for="resumo-marca">Marca</label><select id="resumo-marca" name="marca" class="form-select"><option value="">Todas as marcas</option><cfloop array="#rd.brandOptions#" index="option"><option value="#encodeForHTMLAttribute(option.tag)#" <cfif rf.marca EQ option.tag>selected</cfif>>#encodeForHTML(option.nome)#</option></cfloop></select></div>
<div class="col-12 col-md-8"><label for="resumo-busca">Buscar produto</label><input id="resumo-busca" class="form-control" type="search" name="busca" maxlength="160" value="#encodeForHTMLAttribute(rf.busca)#" placeholder="Nome, versão, marca ou ID"></div><div class="col-6 col-md-2"><button class="btn btn-warning w-100 m-0" type="submit">Filtrar</button></div><div class="col-6 col-md-2"><a href="./" class="btn btn-outline-light w-100 m-0">Limpar</a></div>
</div><p class="small-note mt-3 mb-0">A presença no Brasil vem da curadoria da marca; não comprova estoque de cada modelo. Peso e placa consideram tênis comerciais ativos, sem protótipos e arquivados.</p></form></details>
<nav class="nav nav-pills flex-nowrap overflow-auto gap-2 mb-4" aria-label="Visões do resumo"><cfloop array="#[{tag='resumo',nome='Visão geral'},{tag='cobertura',nome='Cobertura por campo'},{tag='prioridades',nome='Fila de revisão'}]#" index="option"><a class="nav-link flex-shrink-0 <cfif rf.aba EQ option.tag>active</cfif>" href="#encodeForHTMLAttribute(resumoLink({aba=option.tag}))#" <cfif rf.aba EQ option.tag>aria-current="page"</cfif>>#option.nome#</a></cfloop></nav>
<cfif rf.aba EQ 'resumo'>
<div class="row g-3 mb-4">
<cfloop array="#[{label='Produtos no recorte',value=rs.total,hint=rs.marcas & ' marcas'},{label='Peso documentado',value=rs.peso_variante+rs.peso_referencia,hint=rs.peso_variante & ' por variante; ' & rs.peso_referencia & ' sem variante'},{label='Placa definida',value=rs.comerciais-rs.sem_placa,hint='Sim ou não comprovado'},{label='Peso e placa completos',value=rs.completos,hint='Dois campos preenchidos'},{label='Pendências técnicas',value=rs.pendentes,hint='Falta peso, placa ou ambos'},{label='Sem referência de foto',value=rs.sem_foto,hint='Mídia do catálogo ou foto WA'}]#" index="metric"><div class="col-6 col-lg-4 col-xl-2"><div class="metric"><div class="metric-label">#metric.label#</div><div class="metric-value">#resumoNumber(metric.value)#</div><div class="small-note">#encodeForHTML(metric.hint)#</div></div></div></cfloop>
</div>
<div class="row g-4 mb-4"><div class="col-12 col-xl-7"><section class="panel h-100"><h2 class="h5 mb-3">Por onde começar</h2><div class="row g-3">
<cfloop array="#[{tag='peso',nome='Pesquisar peso',total=rs.sem_peso},{tag='placa',nome='Confirmar placa',total=rs.sem_placa},{tag='foto',nome='Completar foto',total=rs.sem_foto},{tag='wa',nome='Conferir identidade na WA',total=rs.wa_nao_verificados}]#" index="task"><div class="col-6"><a class="d-block panel field-link h-100" href="#encodeForHTMLAttribute(resumoLink({aba='prioridades',falta=task.tag}))#"><div class="priority-count">#resumoNumber(task.total)#</div><div>#task.nome# <span aria-hidden="true">→</span></div></a></div></cfloop>
</div><p class="small-note mt-3 mb-0">Uma ficha pode aparecer em mais de uma lacuna. Conferência na WA é uma frente separada: ausência na lista não significa reprovação. Campo preenchido não substitui a revisão da fonte.</p></section></div>
<div class="col-12 col-xl-5"><section class="panel h-100"><h2 class="h5 mb-3">World Athletics no recorte</h2><dl class="row mb-2"><dt class="col-8">Aprovados para rua</dt><dd class="col-4 text-end">#rs.wa_aprovados#</dd><dt class="col-8">Com restrições</dt><dd class="col-4 text-end">#rs.wa_restricoes#</dd><dt class="col-8">Prazo expirado</dt><dd class="col-4 text-end">#rs.wa_expirados#</dd><dt class="col-8">Não verificados</dt><dd class="col-4 text-end">#rs.wa_nao_verificados#</dd><dt class="col-8">Não aprovados para rua</dt><dd class="col-4 text-end">#rs.wa_nao_aprovados#</dd></dl>
<cfif rd.sync.recordCount><p class="small-note">Última consulta da lista: #rd.sync.consultado# (Brasília), com #resumoNumber(rd.sync.total_origem)# registros na origem e #rd.sync.novos# produtos novos. Registros da fonte e produtos são contagens diferentes.</p><cfelse><p class="small-note">Nenhuma sincronização registrada.</p></cfif><p class="small-note mb-0">Protótipos permanecem sem compra e sem pesquisa técnica. A aprovação para rua não define a finalidade comercial do modelo.</p></section></div></div>
<section class="panel"><div class="d-flex flex-wrap justify-content-between gap-2"><h2 class="h5">Marcas e lacunas técnicas</h2><a href="#encodeForHTMLAttribute(resumoLink({aba='prioridades'}))#">Abrir fila de revisão</a></div><p class="small-note">Marcas com presença no Brasil primeiro; depois, maior quantidade de tênis com lacunas. Use o filtro Marca para concentrar a revisão.</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Marca</th><th class="text-end">Produtos</th><th class="text-end">Sem peso</th><th class="text-end">Sem placa</th><th class="text-end">Com lacunas</th></tr></thead><tbody><cfif !arrayLen(rd.brands)><tr><td colspan="5">Nenhum produto no recorte.</td></tr></cfif><cfloop from="1" to="#min(12,arrayLen(rd.brands))#" index="brandIndex"><cfset brand=rd.brands[brandIndex]><tr><td><a href="#encodeForHTMLAttribute(resumoLink({marca=brand.tag,aba='prioridades'}))#">#encodeForHTML(brand.nome)#</a><cfif brand.brasil><span class="badge bg-success ms-2">Brasil</span></cfif></td><td class="text-end">#brand.total#</td><td class="text-end">#brand.sem_peso#</td><td class="text-end">#brand.sem_placa#</td><td class="text-end">#brand.pendentes#</td></tr></cfloop></tbody></table></div><cfif arrayLen(rd.brands) GT 12><p class="small-note mb-0">12 primeiras de #rd.stats.marcas# marcas neste recorte. Todas estão disponíveis no filtro Marca.</p></cfif></section>
<cfelseif rf.aba EQ 'cobertura'>
<section class="panel"><h2 class="h5">Cobertura dos dados cadastrados</h2><p class="small-note">As medidas técnicas usam #resumoNumber(rs.comerciais)# tênis comerciais ativos neste recorte. Material da placa só é exigido quando a placa está marcada como presente. Referência de foto conta cadastro de mídia ou URL WA, sem testar o arquivo remoto.</p>
<div class="row g-4"><cfloop array="#rd.coverage#" index="field"><div class="col-12 col-lg-6"><div class="d-flex justify-content-between gap-3 mb-1"><a class="field-link" href="#encodeForHTMLAttribute(resumoLink({aba='prioridades',falta=field.key}))#">#field.nome#</a><span><cfif field.total><strong>#numberFormat(field.percentual,'9.9')#%</strong> <span class="small-note">#field.ok#/#field.total#</span><cfelse>Não aplicável</cfif></span></div><div class="progress"><div class="progress-bar bg-warning" role="progressbar" aria-label="#field.nome#" aria-valuenow="#field.percentual#" aria-valuemin="0" aria-valuemax="100" style="width:#field.percentual#%"></div></div><div class="small-note mt-1"><cfif field.total><a href="#encodeForHTMLAttribute(resumoLink({aba='prioridades',falta=field.key}))#">Faltando: #field.faltando#</a><cfelse>Sem produtos elegíveis nesse campo.</cfif></div></div></cfloop></div>
<hr><p class="small-note mb-0">Descrição e preço indicam presença de dados, sem atestar qualidade editorial ou oferta comprável. Cupons/ofertas do banco no recorte: #rs.ofertas_banco#. A contagem não inclui os feeds e campanhas da <a href="/administracao/comparador/awin/">integração Awin</a>.</p></section>
<cfelse>
<section class="panel"><div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3"><div><h2 class="h5">Fila de revisão</h2><p class="small-note mb-0">#resumoNumber(rd.total)# produtos · página #rd.page# de #rd.pages#. Marcas no Brasil primeiro; depois, lacunas de vínculo, foto e dados técnicos.</p></div><form method="get"><cfloop collection="#rf#" item="key"><cfif key NEQ 'falta'><input type="hidden" name="#key#" value="#encodeForHTMLAttribute(rf[key])#"></cfif></cfloop><label for="resumo-falta" class="small-note">O que falta</label><div class="d-flex gap-2"><select name="falta" id="resumo-falta" class="form-select"><cfloop array="#[{tag='tecnica',nome='Peso ou placa'},{tag='peso',nome='Peso'},{tag='placa',nome='Presença de placa'},{tag='material',nome='Material da placa'},{tag='foto',nome='Referência de foto'},{tag='lancamento',nome='Data de lançamento'},{tag='descricao',nome='Descrição'},{tag='vinculos',nome='Vínculos de cadastro'},{tag='preco',nome='Preço de referência'},{tag='wa',nome='WA não verificada'},{tag='drop',nome='Drop'},{tag='frontal',nome='Altura frontal'},{tag='calcanhar',nome='Altura do calcanhar'},{tag='entressola',nome='Entressola'},{tag='cabedal',nome='Cabedal'},{tag='solado',nome='Solado'},{tag='todos',nome='Todos no recorte'}]#" index="option"><option value="#option.tag#" <cfif rf.falta EQ option.tag>selected</cfif>>#option.nome#</option></cfloop></select><button class="btn btn-warning m-0" type="submit">Aplicar</button></div></form></div>
<div class="table-responsive"><table class="table table-sm queue-table"><thead><tr><th>Produto</th><th>Situação</th><th>Campos a revisar</th><th>Ação</th></tr></thead><tbody><cfif !arrayLen(rd.queue)><tr><td colspan="4">Nenhum produto encontrado para esse filtro.</td></tr></cfif><cfloop array="#rd.queue#" index="product"><tr><td class="queue-model"><strong>#encodeForHTML(product.marca & ' ' & product.nome_produto & ' ' & product.versao)#</strong><div class="small-note">ID #product.id_produto#<cfif product.brasil> · Marca no Brasil</cfif></div></td><td><span class="badge bg-secondary">#encodeForHTML(product.estado)#</span><cfif product.prototipo><span class="badge bg-info d-block mt-1">Protótipo</span></cfif></td><td><div class="d-flex flex-wrap gap-1"><cfloop from="1" to="#min(5,arrayLen(product.faltas))#" index="missingIndex"><span class="badge bg-warning text-dark">#product.faltas[missingIndex]#</span></cfloop><cfif arrayLen(product.faltas) GT 5><span class="badge bg-secondary">+#arrayLen(product.faltas)-5# campos</span></cfif><cfif !arrayLen(product.faltas)><span class="small-note">Nenhuma lacuna nos campos monitorados</span></cfif></div><cfif rf.falta EQ 'wa'><div class="small-note mt-1">WA não verificada; não significa reprovação.</div></cfif></td><td><a class="btn btn-sm btn-outline-warning text-nowrap" href="/administracao/comparador/?id=#product.id_produto#&amp;aba=caracteristicas">Abrir ficha</a></td></tr></cfloop></tbody></table></div>
<nav class="d-flex flex-wrap gap-2 align-items-center" aria-label="Paginação da revisão"><cfif rd.page GT 1><a class="btn btn-outline-light btn-sm" href="#encodeForHTMLAttribute(resumoLink({pagina=rd.page-1}))#">Anterior</a></cfif><span class="small-note">#rd.page# / #rd.pages#</span><cfif rd.page LT rd.pages><a class="btn btn-outline-light btn-sm" href="#encodeForHTMLAttribute(resumoLink({pagina=rd.page+1}))#">Próxima</a></cfif></nav></section>
</cfif>
</cfoutput>
</cfif>
</section>
