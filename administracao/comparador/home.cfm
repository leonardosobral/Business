<cfif NOT structKeyExists(REQUEST,"comparadorAdminPage")><cfheader statuscode="403"><cfabort></cfif>
<cfscript>
comparadorCanLink=false;
comparadorWaBlocked=false;comparadorWaPhoto='';comparadorWaLabel='Não verificado';
comparadorWaLabels={aprovado='Aprovado para provas de rua',aprovado_restricoes='Aprovado com restrições',prazo_expirado='Prazo de autorização expirado',nao_aprovado='Não aprovado para provas de rua',nao_verificado='Não verificado'};
if(comparadorReady AND comparadorId AND structKeyExists(VARIABLES,'comparadorDetail')) {
    publicProduct=comparadorDetail.product;
    comparadorWaBlocked=publicProduct.wa_compra_bloqueada;
    if(structKeyExists(comparadorWaLabels,publicProduct.wa_status)) comparadorWaLabel=comparadorWaLabels[publicProduct.wa_status];
    if(reFindNoCase('^https://certcheck[.]worldathletics[.]org/OpenDocument/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$',publicProduct.wa_foto_url)) comparadorWaPhoto=publicProduct.wa_foto_url;
    publicCategoryValid=false;
    for(publicCategory in comparadorLookups.categories) {
        if(compare(publicCategory.tag_categoria,publicProduct.tag_categoria)==0 AND compare(publicCategory.tag_tipo_produto,publicProduct.tag_tipo_produto)==0) {publicCategoryValid=true;break;}
    }
    comparadorCanLink=publicProduct.estado=='publicado'
        AND reFind('^[a-z0-9]+(-[a-z0-9]+)*$',publicProduct.tag_produto)
        AND publicProduct.tag_produto!='zerar' AND !find('-vs-',publicProduct.tag_produto)
        AND listFind(valueList(comparadorLookups.types.tag_tipo_produto),publicProduct.tag_tipo_produto)>0
        AND listFind(valueList(comparadorLookups.brands.tag_marca),publicProduct.tag_marca)>0
        AND publicCategoryValid;
}
</cfscript>
<style>
.comparador-admin{max-width:1500px;padding-bottom:3rem}.comparador-admin label{font-weight:600;margin-bottom:.4rem}.comparador-admin .form-control,.comparador-admin .form-select{min-height:42px}.comparador-admin textarea{min-height:100px}.comparador-admin .table td{vertical-align:middle}.comparador-admin .nav{gap:.3rem;flex-wrap:wrap}.comparador-admin .nav-link.active{background:#ffc107;color:#171717}.comparador-admin pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:25rem;overflow:auto}.comparador-admin .text-break{overflow-wrap:anywhere}.comparador-admin .row{--mdb-gutter-y:1rem}.comparador-admin fieldset{min-width:0}.comparador-admin legend{font-size:1.05rem}.comparador-admin .small-hint{font-size:.875rem;color:#b8bec7}
</style>
<cfoutput>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><h1 class="h3 mb-1">Comparador</h1><p class="text-muted mb-0">Catálogo de produtos, características e ofertas.</p></div><cfif comparadorReady><a class="btn btn-warning" href="./?novo=1&#encodeForHTMLAttribute(comparadorReturn)#">Novo produto</a></cfif></div>
<cfinclude template="includes/navigation.cfm">
<cfif len(comparadorError)><div class="alert alert-danger" role="alert">#encodeForHTML(comparadorError)# <cfif comparadorId><a href="./?id=#comparadorId#&aba=#comparadorTab#&#encodeForHTMLAttribute(comparadorReturn)#">Recarregar produto</a></cfif></div></cfif>
<cfif len(comparadorNotice)><div class="alert alert-success" role="status">#encodeForHTML(comparadorNotice)#</div></cfif>
<cfif NOT comparadorReady><div class="alert alert-warning">A administração do catálogo aguarda a instalação da atualização do banco de dados.</div>
<cfelseif comparadorConflict><p>Reabra o produto para obter a versão atual antes de continuar a edição.</p>
<cfelseif NOT comparadorId AND NOT comparadorNew>
 <form method="get" class="card card-body mb-4"><div class="row align-items-end">
 <div class="col-12 col-lg-4"><label for="busca">Buscar produto</label><input class="form-control" id="busca" name="busca" value="#encodeForHTMLAttribute(comparadorSearch)#" placeholder="Nome, endereço ou ID" maxlength="160"></div>
 <div class="col-6 col-lg-2"><label for="tipo">Tipo</label><select class="form-select" id="tipo" name="tipo"><option value="">Todos</option><cfloop query="comparadorLookups.types"><option value="#encodeForHTMLAttribute(tag_tipo_produto)#" <cfif comparadorType EQ tag_tipo_produto>selected</cfif>>#encodeForHTML(nome_tipo_produto)#</option></cfloop></select></div>
 <div class="col-6 col-lg-2"><label for="estado">Publicação</label><select class="form-select" id="estado" name="estado"><option value="">Todos</option><cfloop list="rascunho,publicado,arquivado" index="state"><option value="#state#" <cfif comparadorState EQ state>selected</cfif>>#state#</option></cfloop></select></div>
 <div class="col-8 col-lg-2"><label for="pendencia">Pendência</label><select class="form-select" id="pendencia" name="pendencia"><option value="">Todas</option><option value="vinculos" <cfif comparadorPending EQ 'vinculos'>selected</cfif>>Marca ou categoria</option><option value="preco" <cfif comparadorPending EQ 'preco'>selected</cfif>>Preço ausente/inválido</option></select></div><div class="col-4 col-lg-2"><button class="btn btn-outline-warning w-100" type="submit">Filtrar</button></div>
 </div></form>
 <div class="card"><div class="card-body"><p class="text-muted">#comparadorList.total# produtos · página #comparadorList.page# de #comparadorList.pages#</p><div class="table-responsive"><table class="table"><thead><tr><th>Produto</th><th>Tipo / marca</th><th>Publicação</th><th>Pendências</th><th><span class="visually-hidden">Ação</span></th></tr></thead><tbody>
 <cfloop query="comparadorList.rows"><tr><td><strong>#encodeForHTML(nome_produto)#</strong><br><span class="small text-muted">## #id_produto# · #encodeForHTML(versao)#</span></td><td>#encodeForHTML(nome_tipo_produto)#<br><span class="text-muted">#encodeForHTML(marca)#</span></td><td><span class="badge badge-secondary">#encodeForHTML(estado)#</span></td><td><cfif pendencia_vinculos><span class="badge badge-warning">Marca/categoria</span> </cfif><cfif pendencia_preco><span class="badge badge-warning">Preço</span></cfif><cfif NOT pendencia_vinculos AND NOT pendencia_preco><span class="text-muted">—</span></cfif></td><td><a class="btn btn-sm btn-outline-light" href="./?id=#id_produto#&#encodeForHTMLAttribute(comparadorReturn)#">Editar<span class="visually-hidden"> #encodeForHTML(nome_produto)#</span></a></td></tr></cfloop>
 <cfif NOT comparadorList.rows.recordCount><tr><td colspan="5">Nenhum produto encontrado para estes filtros.</td></tr></cfif></tbody></table></div>
 <nav class="d-flex justify-content-between" aria-label="Paginação"><cfif comparadorList.page GT 1><a class="btn btn-sm btn-outline-light" href="./?#encodeForHTMLAttribute(reReplace(comparadorReturn,'pagina=[0-9]+','pagina=' & (comparadorList.page-1)))#">Anterior</a><cfelse><span></span></cfif><cfif comparadorList.page LT comparadorList.pages><a class="btn btn-sm btn-outline-light" href="./?#encodeForHTMLAttribute(reReplace(comparadorReturn,'pagina=[0-9]+','pagina=' & (comparadorList.page+1)))#">Próxima</a></cfif></nav>
 </div></div>
<cfelse>
 <a class="d-inline-block mb-3" href="./?#encodeForHTMLAttribute(comparadorReturn)#">← Voltar ao catálogo</a>
 <div class="card mb-4"><div class="card-body"><div class="d-flex justify-content-between flex-wrap gap-3"><div><h2 class="h4">#comparadorId ? encodeForHTML(comparadorValue('nome_produto')) : 'Novo produto'#</h2><cfif comparadorId><span class="badge badge-secondary">#encodeForHTML(comparadorDetail.product.estado)#</span> <span class="small text-muted">ID #comparadorId# · revisão #comparadorDetail.product.revisao#</span><cfelse><p class="mb-0 text-muted">O novo produto será salvo como rascunho.</p></cfif></div>
 <cfif comparadorId><div class="d-flex flex-wrap align-items-start gap-2"><cfif comparadorCanLink><a class="btn btn-sm btn-outline-light" href="https://comparador.roadrunners.run/#urlEncodedFormat(comparadorDetail.product.tag_tipo_produto)#/#urlEncodedFormat(comparadorDetail.product.tag_produto)#/" target="_blank" rel="noopener">Ver no site</a><cfelseif comparadorDetail.product.estado EQ 'publicado'><p class="small-hint mb-0">Revise endereço, marca e categoria para habilitar a página pública.</p></cfif>
 <form method="post"><input type="hidden" name="acao" value="estado"><input type="hidden" name="csrf_token" value="#comparadorCsrf#"><input type="hidden" name="id_produto" value="#comparadorId#"><input type="hidden" name="token" value="#comparadorDetail.token#"><label class="visually-hidden" for="novo-estado">Alterar publicação</label><select id="novo-estado" name="estado" class="form-select form-select-sm mb-2"><cfloop list="rascunho,publicado,arquivado" index="state"><option value="#state#" <cfif comparadorDetail.product.estado EQ state>selected</cfif>>#state#</option></cfloop></select><button class="btn btn-sm btn-outline-warning" type="submit">Aplicar publicação</button></form></div></cfif></div>
 <cfif comparadorId><nav class="nav nav-pills mt-4" aria-label="Detalhes do produto"><cfloop list="dados,caracteristicas,ofertas,historico" index="tab"><a class="nav-link <cfif tab EQ comparadorTab>active</cfif>" <cfif tab EQ comparadorTab>aria-current="page"</cfif> href="./?id=#comparadorId#&aba=#tab#&#encodeForHTMLAttribute(comparadorReturn)#"><cfswitch expression="#tab#"><cfcase value="dados">Dados</cfcase><cfcase value="caracteristicas">Características e variantes</cfcase><cfcase value="ofertas">Ofertas</cfcase><cfcase value="historico">Histórico</cfcase></cfswitch></a></cfloop></nav></cfif>
 </div></div>
 <cfif comparadorTab EQ 'dados' OR NOT comparadorId>
 <cfif comparadorId><section class="card card-body mb-4" aria-labelledby="world-athletics-title"><div class="row align-items-start"><div class="col-12 <cfif len(comparadorWaPhoto)>col-md-8</cfif>">
 <h3 class="h5" id="world-athletics-title">World Athletics</h3><p><span class="badge badge-secondary">#encodeForHTML(comparadorWaLabel)#</span> <cfif publicProduct.wa_prototipo><span class="badge badge-warning">Protótipo</span></cfif></p>
 <cfif comparadorWaBlocked><p class="alert alert-warning">Modelo em desenvolvimento. Sem opção de compra; novas ofertas e alterações de ofertas estão bloqueadas.</p></cfif>
 <dl class="row mb-2"><dt class="col-sm-4">Código do modelo</dt><dd class="col-sm-8">#len(publicProduct.wa_modelo_numero)?encodeForHTML(publicProduct.wa_modelo_numero):'Não informado'#</dd><dt class="col-sm-4">Validade da autorização</dt><dd class="col-sm-8">#isDate(publicProduct.wa_validade)?dateFormat(publicProduct.wa_validade,'dd/mm/yyyy'):'Não informada'#</dd><dt class="col-sm-4">Última consulta</dt><dd class="col-sm-8">#isDate(publicProduct.wa_consultado_em)?dateFormat(publicProduct.wa_consultado_em,'dd/mm/yyyy'):'Não consultado'#</dd></dl>
 <cfif len(publicProduct.wa_restricoes)><p class="text-break"><strong>Restrições:</strong> #encodeForHTML(publicProduct.wa_restricoes)#</p></cfif>
 <p class="small-hint">A aprovação para provas de rua é uma regra de competição; não define o uso recomendado pelo fabricante. Ausência na fonte não significa reprovação. Os dados da fonte são preservados separadamente da edição do catálogo.</p>
 <cfif publicProduct.wa_fonte EQ 'https://certcheck.worldathletics.org/FullList'><a href="https://certcheck.worldathletics.org/FullList" target="_blank" rel="noopener noreferrer">Consultar fonte World Athletics</a></cfif>
 </div><cfif len(comparadorWaPhoto)><div class="col-12 col-md-4"><figure class="mb-0"><a href="#encodeForHTMLAttribute(comparadorWaPhoto)#" target="_blank" rel="noopener noreferrer"><img src="#encodeForHTMLAttribute(comparadorWaPhoto)#" alt="Foto oficial World Athletics de #encodeForHTMLAttribute(publicProduct.nome_produto)#" class="img-fluid rounded" style="width:100%;max-height:280px;object-fit:contain;background:white" loading="lazy" referrerpolicy="no-referrer"></a><figcaption class="small-hint mt-2">Foto: World Athletics</figcaption></figure></div></cfif></div></section></cfif>
 <form method="post" class="card card-body"><input type="hidden" name="acao" value="produto"><input type="hidden" name="csrf_token" value="#comparadorCsrf#"><input type="hidden" name="id_produto" value="#comparadorId ? comparadorId : ''#"><input type="hidden" name="token" value="#comparadorId ? comparadorDetail.token : ''#">
 <div class="row"><div class="col-md-8"><label for="nome_produto">Nome do produto</label><input class="form-control" id="nome_produto" name="nome_produto" value="#comparadorInput('nome_produto')#" maxlength="250" required></div><div class="col-md-4"><label for="tag_tipo_produto">Tipo</label><select class="form-select" id="tag_tipo_produto" name="tag_tipo_produto" required><option value="">Selecione</option><cfloop query="comparadorLookups.types"><option value="#encodeForHTMLAttribute(tag_tipo_produto)#" <cfif comparadorValue('tag_tipo_produto') EQ tag_tipo_produto>selected</cfif>>#encodeForHTML(nome_tipo_produto)#</option></cfloop></select></div>
 <div class="col-md-6"><label for="tag_marca">Marca</label><select class="form-select" id="tag_marca" name="tag_marca"><option value="">Não informada</option><cfloop query="comparadorLookups.brands"><option value="#encodeForHTMLAttribute(tag_marca)#" <cfif comparadorValue('tag_marca') EQ tag_marca>selected</cfif>>#encodeForHTML(marca)#</option></cfloop></select></div>
 <div class="col-md-6"><label for="tag_categoria">Categoria</label><select class="form-select" id="tag_categoria" name="tag_categoria"><option value="">Não informada</option><cfloop query="comparadorLookups.categories"><option value="#encodeForHTMLAttribute(tag_categoria)#" <cfif comparadorValue('tag_categoria') EQ tag_categoria>selected</cfif>>#encodeForHTML(categoria)# (#encodeForHTML(tag_tipo_produto)#)</option></cfloop></select><div class="small-hint mt-1">Selecione uma categoria do mesmo tipo do produto.</div></div>
 <div class="col-md-6"><label for="tag_produto">Endereço do produto</label><input class="form-control" id="tag_produto" name="tag_produto" value="#comparadorInput('tag_produto')#" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="160"><div class="small-hint mt-1">Letras minúsculas, números e hífens. Não use zerar ou -vs-. Alterar muda o endereço público.</div></div>
 <div class="col-6 col-md-3"><label for="versao">Versão</label><input class="form-control" id="versao" name="versao" value="#comparadorInput('versao')#" maxlength="250"></div><div class="col-6 col-md-3"><label for="num_versao">Ordem da versão</label><input class="form-control" id="num_versao" name="num_versao" type="number" min="0" max="2147483647" step="1" value="#comparadorInput('num_versao')#"></div>
 <div class="col-md-6"><label for="preco_referencia">Preço de referência (R$)</label><input class="form-control" id="preco_referencia" name="preco_referencia" inputmode="decimal" value="#comparadorInput('preco_referencia')#" placeholder="Ex.: 1299,90"><div class="small-hint mt-1">Sem separador de milhar. Deixe vazio se desconhecido.</div></div><div class="col-md-6"><label for="data_lancamento">Data de lançamento</label><input class="form-control" type="date" id="data_lancamento" name="data_lancamento" value="#isDate(comparadorValue('data_lancamento')) ? dateFormat(comparadorValue('data_lancamento'),'yyyy-mm-dd') : ''#"></div>
 <div class="col-12"><label for="resumo">Resumo</label><textarea class="form-control" id="resumo" name="resumo" maxlength="1000">#encodeForHTML(comparadorValue('resumo'))#</textarea></div><div class="col-12"><label for="descricao">Descrição</label><textarea class="form-control" id="descricao" name="descricao" maxlength="30000" rows="6">#encodeForHTML(comparadorValue('descricao'))#</textarea></div></div>
 <p class="small-hint mt-3">As imagens do acervo são preservadas. O envio de novas imagens ainda não está disponível.</p><div><button class="btn btn-warning" type="submit">#comparadorId ? 'Salvar dados' : 'Criar rascunho'#</button></div></form>
 <cfelseif comparadorTab EQ 'caracteristicas'>
 <form method="post" class="card card-body"><input type="hidden" name="acao" value="caracteristicas"><input type="hidden" name="csrf_token" value="#comparadorCsrf#"><input type="hidden" name="id_produto" value="#comparadorId#"><input type="hidden" name="token" value="#comparadorDetail.token#"><input type="hidden" name="feature_ids" value="#valueList(comparadorDetail.features.id_produto_caracteristica)#">
 <h3 class="h5">Características</h3><p class="small-hint">Campos vazios significam valor desconhecido. Decimais aceitam vírgula ou ponto, sem separador de milhar; zero é preservado. Valores antigos permanecem até serem alterados.</p>
 <cfloop query="comparadorDetail.features"><fieldset class="border rounded p-3 mb-3"><legend>#encodeForHTML(nome_caracteristica)# <cfif len(un_caracteristica)>(#encodeForHTML(un_caracteristica)#)</cfif></legend><div class="row"><div class="col-md-5"><label for="valor_#id_produto_caracteristica#">Valor <span class="small-hint">(#encodeForHTML(tipo_caracteristica)#)</span></label><input class="form-control" id="valor_#id_produto_caracteristica#" name="valor_#id_produto_caracteristica#" value="#comparadorPosted('valor_' & id_produto_caracteristica,caracteristica_dominio)#" maxlength="5000"></div><div class="col-md-7"><label for="nota_#id_produto_caracteristica#">Complemento</label><input class="form-control" id="nota_#id_produto_caracteristica#" name="nota_#id_produto_caracteristica#" value="#comparadorPosted('nota_' & id_produto_caracteristica,descricao_complementa)#" maxlength="5000"></div></div></fieldset></cfloop>
 <fieldset class="border rounded p-3 mb-4"><legend>Adicionar característica</legend><div class="row"><div class="col-md-4"><label for="nova_tag">Característica do tipo</label><select class="form-select" id="nova_tag" name="nova_tag"><option value="">Selecione</option><cfloop query="comparadorDetail.available"><option value="#encodeForHTMLAttribute(tag_caracteristica)#">#encodeForHTML(nome_caracteristica)#<cfif len(un_caracteristica)> (#encodeForHTML(un_caracteristica)#)</cfif></option></cfloop></select></div><div class="col-md-4"><label for="novo_valor">Valor</label><input class="form-control" id="novo_valor" name="novo_valor" value="#comparadorPosted('novo_valor','')#" maxlength="5000"></div><div class="col-md-4"><label for="nova_nota">Complemento</label><input class="form-control" id="nova_nota" name="nova_nota" value="#comparadorPosted('nova_nota','')#" maxlength="5000"></div></div></fieldset>
 <h3 class="h5">Variantes</h3><p class="small-hint">Marque as variantes que deseja salvar. Peso em gramas; tamanho conforme a especificação do produto. Não inferimos medidas ausentes.</p>
 <cfloop list="M,F,U" index="gender"><cfset variantWeight=""><cfset variantSize=""><cfset variantExists=false><cfloop query="comparadorDetail.variants"><cfif genero EQ gender><cfset variantWeight=peso><cfset variantSize=tamanho><cfset variantExists=true></cfif></cfloop><div class="row mb-3 align-items-center"><div class="col-md-4"><input type="checkbox" id="variante_#gender#" name="variante_#gender#" value="1" <cfif variantExists>checked</cfif>> <label for="variante_#gender#"><cfswitch expression="#gender#"><cfcase value="M">Masculina</cfcase><cfcase value="F">Feminina</cfcase><cfcase value="U">Unissex</cfcase></cfswitch></label></div><div class="col-6 col-md-4"><label for="peso_#gender#">Peso (g)</label><input class="form-control" id="peso_#gender#" name="peso_#gender#" inputmode="decimal" value="#comparadorPosted('peso_' & gender,variantWeight)#"></div><div class="col-6 col-md-4"><label for="tamanho_#gender#">Tamanho</label><input class="form-control" id="tamanho_#gender#" name="tamanho_#gender#" inputmode="decimal" value="#comparadorPosted('tamanho_' & gender,variantSize)#"></div></div></cfloop>
 <div><button class="btn btn-warning mt-3" type="submit">Salvar características e variantes</button></div></form>
 <cfelseif comparadorTab EQ 'ofertas'>
 <cfif comparadorWaBlocked><div class="alert alert-warning">Protótipo sem opção de compra. Novas ofertas e alterações estão bloqueadas. Você pode encerrar uma oferta existente no histórico abaixo.</div><cfelse>
 <div class="alert alert-info">A oferta de maior ID é a candidata exibida. Se estiver vencida ou inválida, o site mostra o preço de referência, sem reativar uma oferta anterior. A validade inclui todo o dia informado, no horário de Brasília.</div>
 <form method="post" class="card card-body mb-4"><h3 class="h5">Nova oferta</h3><input type="hidden" name="acao" value="oferta"><input type="hidden" name="csrf_token" value="#comparadorCsrf#"><input type="hidden" name="id_produto" value="#comparadorId#"><input type="hidden" name="token" value="#comparadorDetail.token#"><div class="row">
 <div class="col-md-6"><label for="loja">Loja</label><input class="form-control" name="loja" id="loja" maxlength="256" required value="#comparadorPosted('loja','')#"></div><div class="col-md-3"><label for="preco_promocional">Preço (R$)</label><input class="form-control" name="preco_promocional" id="preco_promocional" inputmode="decimal" required value="#comparadorPosted('preco_promocional','')#"></div><div class="col-md-3"><label for="data_expiracao">Válida até</label><input class="form-control" type="date" name="data_expiracao" id="data_expiracao" value="#comparadorPosted('data_expiracao','')#"></div>
 <div class="col-md-8"><label for="link">Link da oferta</label><input class="form-control" type="url" name="link" id="link" maxlength="256" required placeholder="https://" value="#comparadorPosted('link','')#"></div><div class="col-md-4"><label for="cupom">Cupom (opcional)</label><input class="form-control" name="cupom" id="cupom" maxlength="32" value="#comparadorPosted('cupom','')#"></div><div class="col-12"><label for="condicoes">Condições</label><textarea class="form-control" name="condicoes" id="condicoes" maxlength="256">#comparadorPosted('condicoes','')#</textarea></div></div><p class="small-hint mt-3">O registro preserva as ofertas anteriores no histórico. Uma data vazia significa validade não informada.</p><div><button class="btn btn-warning" type="submit">Registrar oferta</button></div></form>
 </cfif>
 <div class="card card-body"><h3 class="h5">Histórico de ofertas</h3><div class="table-responsive"><table class="table"><thead><tr><th>ID / situação</th><th>Loja</th><th>Preço</th><th>Validade</th><th>Cupom / condições</th></tr></thead><tbody><cfloop query="comparadorDetail.offers"><tr><td>## #id_cupom#<br><cfif is_latest><span class="badge badge-warning">Mais recente</span><cfelse><span class="text-muted">Anterior</span></cfif><cfif expired><br><span class="badge badge-danger">Vencida</span></cfif></td><td>#encodeForHTML(loja)#<br><small class="text-break">#encodeForHTML(link)#</small></td><td>#encodeForHTML(preco_promocional & '')#</td><td>#isDate(data_expiracao)?dateFormat(data_expiracao,'dd/mm/yyyy'):'Não informada'#</td><td>#encodeForHTML(cupom)#<br>#encodeForHTML(condicoes)#<br><a href="./ofertas/?id=#id_cupom#">#comparadorWaBlocked?'Encerrar':'Editar ou encerrar'#</a></td></tr></cfloop><cfif NOT comparadorDetail.offers.recordCount><tr><td colspan="5">Nenhuma oferta registrada.</td></tr></cfif></tbody></table></div></div>
 <cfelseif comparadorTab EQ 'historico'>
 <div class="card card-body"><h3 class="h5">Últimas 50 alterações</h3><p class="small-hint">Horário de Brasília. O histórico identifica o administrador e conserva os valores antes e depois da alteração.</p><cfloop query="comparadorDetail.history"><details class="border-bottom py-3"><summary>#encodeForHTML(registrado)# · #encodeForHTML(acao)# · administrador ## #ator_id#</summary><h4 class="h6 mt-3">Antes</h4><pre>#encodeForHTML(antes)#</pre><h4 class="h6">Depois</h4><pre>#encodeForHTML(depois)#</pre></details></cfloop><cfif NOT comparadorDetail.history.recordCount><p>Este produto ainda não tem alterações registradas nesta área.</p></cfif></div>
 </cfif>
</cfif>
</cfoutput>
