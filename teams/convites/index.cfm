<cfinclude template="../includes/start.cfm"><cfset teamTitle="Convite para administrar um Team">
<cfset inviteToken=teamBoundary.text(URL,'token')><cfset teamLoginReturn='/teams/convites/?token=' & urlEncodedFormat(inviteToken)>
<cfif CGI.request_method EQ 'POST'><cftry><cfset teamPost()><cfset teamSvc.acceptAdmin(teamUser.id,teamBoundary.text(FORM,'token'))><cflocation url="/teams/?accepted=1" addtoken="false"><cfcatch type="Teams.Validation"><cfset teamError=cfcatch.message></cfcatch><cfcatch type="Teams.Forbidden"><cfheader statuscode="403"><cfset teamError=cfcatch.message></cfcatch><cfcatch type="any"><cfset teamError="Não foi possível aceitar este convite."></cfcatch></cftry></cfif>
<cfinclude template="../includes/header.cfm"><section class="teams-hero"><span class="teams-eyebrow">Equipe administrativa</span><h1>Seu convite para o Team.</h1></section>
<cfif structIsEmpty(teamUser)><cfinclude template="../includes/login.cfm"><cfelse><section class="teams-panel"><h2>Aceitar acesso administrativo</h2><p>Entre com o mesmo email que recebeu o convite. Este acesso não vincula seu perfil de atleta ao Team.</p><form method="post"><input type="hidden" name="csrf" value="<cfoutput>#teamCsrf#</cfoutput>"><input type="hidden" name="token" value="<cfoutput>#encodeForHTMLAttribute(inviteToken)#</cfoutput>"><button>Aceitar convite</button></form></section></cfif><cfinclude template="../includes/footer.cfm">
