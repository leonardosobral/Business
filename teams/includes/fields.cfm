<cfscript>
teamFields=[{key='name',label='Nome do Team',max=160},{key='ownerName',label='Nome do titular da conta',max=200},{key='document',label='CPF ou CNPJ do titular',max=20},{key='technicalName',label='Nome do responsável técnico',max=200},{key='cref',label='CREF completo do responsável técnico',max=30},{key='crefUf',label='Regional do CREF (UF)',max=2},{key='email',label='Email comercial',max=255},{key='phone',label='Telefone com DDD',max=30},{key='whatsapp',label='WhatsApp com DDD',max=30},{key='city',label='Cidade',max=100},{key='uf',label='UF',max=2}];
for(f in teamFields){v=structKeyExists(teamForm,f.key)?teamForm[f.key]:'';writeOutput('<label class="teams-field">' & encodeForHTML(f.label) & '<input required name="' & f.key & '" maxlength="' & f.max & '" value="' & encodeForHTMLAttribute(v) & '"' & (f.key=='email'?' type="email"':'') & '></label>');}
</cfscript>
<label class="teams-field">Tipo de Team<select required name="type"><cfoutput><cfloop collection="#teamTypeLabels#" item="typeKey"><option value="#typeKey#" <cfif teamForm.type EQ typeKey>selected</cfif>>#encodeForHTML(teamTypeLabels[typeKey])#</option></cfloop></cfoutput></select></label>
<label class="teams-field">Atendimento<select required name="attendance"><option value="PRESENCIAL" <cfif teamForm.attendance EQ 'PRESENCIAL'>selected</cfif>>Presencial</option><option value="ONLINE" <cfif teamForm.attendance EQ 'ONLINE'>selected</cfif>>Online</option><option value="AMBOS" <cfif teamForm.attendance EQ 'AMBOS'>selected</cfif>>Presencial e online</option></select></label>
<label class="teams-field full">Site ou rede social (https://)<input type="url" name="website" maxlength="500" value="<cfoutput>#encodeForHTMLAttribute(teamForm.website)#</cfoutput>"></label>
<label class="teams-field full">Apresentação do Team<textarea name="description" maxlength="1600"><cfoutput>#encodeForHTML(teamForm.description)#</cfoutput></textarea></label>
